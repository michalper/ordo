# Environment variable contract for this module.
# This module has no runtime of its own (it lives inside a Magento application) — the only
# environment variables it knows about are needed to run Test/Api/* (functional API tests
# against a running Magento instance). See Test/Api/README.md for per-test details.

# Base URL of a running Magento instance (no trailing slash)
ORDO_API_BASE_URL=http://php:8080

# Admin credentials (for the REST token)
ORDO_API_ADMIN_USERNAME=admin
ORDO_API_ADMIN_PASSWORD=

# Storefront customer credentials (for the REST token)
ORDO_API_CUSTOMER_EMAIL=
ORDO_API_CUSTOMER_PASSWORD=

# FreeGiftApiTest only: a real, existing, purchasable SKU
ORDO_API_TEST_PRODUCT_SKU=

# OrderApprovalApiTest only: token and entity_id of a freshly seeded, still-pending
# order with an active approve/reject link (see OrderApprovalApiTest.php)
ORDO_API_TEST_APPROVAL_TOKEN=
ORDO_API_TEST_APPROVAL_ENTITY_ID=
