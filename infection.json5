{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "Api",
            "Block",
            "Controller",
            "Cron",
            "Helper",
            "Model",
            "Observer",
            "Plugin",
            "Ui"
        ]
    },
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log",
        "github": true
    },
    // Baseline measured across 5 consecutive CI runs (main + feature branches, all identical):
    // 4943/7043 mutants killed/errored/timed-out = ~70.2% MSI, coveredMsi the same since
    // Not Covered is 0. Set a couple points under that so ordinary mutant-selection noise across
    // runs doesn't fail a PR that introduced no real regression — raise as real test-quality work
    // pushes the actual number up, don't lower it to make a red PR pass.
    "minMsi": 70,
    "minCoveredMsi": 70,
    "testFramework": "phpunit"
}
