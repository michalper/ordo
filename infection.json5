{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "Api",
            "Block",
            "Controller",
            "Cron",
            "Helper",
            "Model",
            "Observer",
            "Plugin",
            "Ui"
        ]
    },
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log",
        "github": true
    },
    // Originally measured across 5 consecutive CI runs (main + feature branches, all identical):
    // 4943/7043 mutants killed/errored/timed-out = ~70.2% MSI, coveredMsi the same since
    // Not Covered is 0, gated at 70 (a couple points under that baseline). That margin turned out
    // to be too thin in practice — a code audit found it, and this same run landed at exactly
    // 69-70% twice in one session from ordinary mutant-selection-order noise, with no real
    // regression either time (see docs/CHANGELOG.md). Widened to 68, still a couple points under
    // the current measured number, now with actual room for that noise.
    //
    // Re-measured 2026-11-19 across 5 more consecutive main-branch CI runs: a much tighter
    // 70.06-70.17% every time (14334 mutants, ~10036 killed), no dip anywhere near 68-69 this
    // round. Raised to 69, still leaving ~1 point of margin for ordinary noise — not pushed any
    // higher: a meaningful chunk of the remaining ~4278 "escaped" mutants per run are expected to
    // be equivalent mutants (semantically identical to the original, unkillable by any test;
    // Infection's own output says as much - "some mutants will inevitably be harmless"), so 100%
    // isn't a realistic target the way 100% line coverage is. Raise further only as real
    // test-quality work pushes the measured number up again - don't lower it to make a red PR
    // pass.
    "minMsi": 69,
    "minCoveredMsi": 69,
    "testFramework": "phpunit"
}
