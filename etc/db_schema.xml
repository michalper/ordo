<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="ordo_reorder_cycle" resource="default" engine="innodb" comment="Detected reorder cycle per customer and SKU">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="sku" nullable="false" length="64" comment="Product SKU"/>
        <column xsi:type="smallint" name="avg_interval_days" unsigned="true" nullable="false" comment="Average interval between orders, in days"/>
        <column xsi:type="date" name="last_order_date" nullable="false" comment="Date of the most recent order containing this SKU"/>
        <column xsi:type="date" name="next_expected_date" nullable="false" comment="Predicted date of the next order"/>
        <column xsi:type="smallint" name="orders_considered" unsigned="true" nullable="false" comment="Number of past orders used to compute the cycle"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ORDO_REORDER_CYCLE_CUSTOMER_ID_SKU">
            <column name="customer_id"/>
            <column name="sku"/>
        </constraint>
        <index referenceId="ORDO_REORDER_CYCLE_NEXT_EXPECTED_DATE" indexType="btree">
            <column name="next_expected_date"/>
        </index>
    </table>

    <table name="ordo_reorder_reminder_log" resource="default" engine="innodb" comment="Log of sent reorder reminders, to avoid duplicate sends">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="reorder_cycle_id" padding="10" unsigned="true" nullable="false" comment="ordo_reorder_cycle.entity_id"/>
        <column xsi:type="timestamp" name="sent_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Sent At"/>
        <column xsi:type="boolean" name="reacted" nullable="false" default="false" comment="Whether the customer placed a matching order after the reminder"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_REMINDER_LOG_CYCLE_ID_REORDER_CYCLE_ENTITY_ID"
                    table="ordo_reorder_reminder_log" column="reorder_cycle_id"
                    referenceTable="ordo_reorder_cycle" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="ordo_abandoned_cart_reminder_log" resource="default" engine="innodb" comment="Log of sent abandoned cart reminders, to cap reminders per cart">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="quote_id" padding="10" unsigned="true" nullable="false" comment="quote.entity_id"/>
        <column xsi:type="timestamp" name="sent_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Sent At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_ABANDONED_CART_LOG_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
    </table>

    <table name="ordo_offer" resource="default" engine="innodb" comment="B2B offer/quote with an expiration date — the entity Magento Open Source does not have natively">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="reference" nullable="false" length="32" comment="Human-readable offer reference, e.g. OFR-000123"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" default="draft" comment="draft|sent|accepted|rejected|expired"/>
        <column xsi:type="decimal" name="total" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="Offer total"/>
        <column xsi:type="varchar" name="currency_code" nullable="false" length="3" default="USD" comment="Currency code"/>
        <column xsi:type="date" name="expires_at" nullable="false" comment="Expiration date"/>
        <column xsi:type="int" name="extension_count" unsigned="true" nullable="false" default="0" comment="Number of times the customer self-extended the expiry"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ORDO_OFFER_REFERENCE">
            <column name="reference"/>
        </constraint>
        <index referenceId="ORDO_OFFER_STATUS_EXPIRES_AT" indexType="btree">
            <column name="status"/>
            <column name="expires_at"/>
        </index>
        <index referenceId="ORDO_OFFER_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>

    <table name="ordo_offer_reminder_log" resource="default" engine="innodb" comment="Log of sent offer expiry reminders, to avoid duplicate sends">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="offer_id" padding="10" unsigned="true" nullable="false" comment="ordo_offer.entity_id"/>
        <column xsi:type="varchar" name="reminder_type" nullable="false" length="20" comment="expiring_soon|expired"/>
        <column xsi:type="timestamp" name="sent_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Sent At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_OFFER_REMINDER_LOG_OFFER_ID_OFFER_ENTITY_ID"
                    table="ordo_offer_reminder_log" column="offer_id"
                    referenceTable="ordo_offer" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="ordo_credit_limit_alert_log" resource="default" engine="innodb" comment="Log of sent credit limit alerts, one row per threshold band crossed, to control alert frequency">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="smallint" name="threshold_percent" unsigned="true" nullable="false" comment="Threshold band crossed, e.g. 80 or 100"/>
        <column xsi:type="decimal" name="utilization_percent" scale="2" precision="7" unsigned="true" nullable="false" comment="Actual utilization at send time"/>
        <column xsi:type="timestamp" name="sent_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Sent At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_CREDIT_LIMIT_ALERT_LOG_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>

    <table name="ordo_segment" resource="default" engine="innodb" comment="A saved, reusable set of AND-ed conditions (customer attributes/behavior) — built from the same ConditionPool campaigns use, so any condition type (tag, order total, RFM, score) works here too. Referenced by the in_segment campaign condition and reused across as many campaigns as needed, instead of re-declaring the same conditions inline in every campaign that wants them.">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Admin-facing name"/>
        <column xsi:type="boolean" name="enabled" nullable="false" default="1" comment="Enabled"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>

    <table name="ordo_segment_condition" resource="default" engine="innodb" comment="One AND-ed condition on a segment — same type/params shape as ordo_campaign_condition, evaluated through the same ConditionPool">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="segment_id" padding="10" unsigned="true" nullable="false" comment="ordo_segment.entity_id"/>
        <column xsi:type="varchar" name="type" nullable="false" length="64" comment="Condition type key, matches Model\Campaign\ConditionPool registration"/>
        <column xsi:type="text" name="params" nullable="true" comment="JSON-encoded condition configuration"/>
        <column xsi:type="smallint" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_SEGMENT_CONDITION_SEGMENT_ID_SEGMENT_ENTITY_ID"
                    table="ordo_segment_condition" column="segment_id"
                    referenceTable="ordo_segment" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ORDO_SEGMENT_CONDITION_SEGMENT_ID" indexType="btree">
            <column name="segment_id"/>
        </index>
    </table>

    <table name="ordo_customer_score" resource="default" engine="innodb" comment="Lead scoring — a running points total per customer, accumulated by the add_points campaign action and read by the score_at_least condition. One row per customer; points accumulate via UPSERT, never a separate ledger row per event.">
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="int" name="score" nullable="false" default="0" comment="Running points total — can go negative if a rule subtracts more than the balance"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="customer_id"/>
        </constraint>
    </table>

    <table name="ordo_customer_tag" resource="default" engine="innodb" comment="Behavioral tags — the segmentation primitive every B2C trigger and future campaign targeting reads from">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="tag" nullable="false" length="64" comment="Tag, e.g. new_customer, vip, inactive, win_back_sent"/>
        <column xsi:type="timestamp" name="added_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Added At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ORDO_CUSTOMER_TAG_CUSTOMER_ID_TAG">
            <column name="customer_id"/>
            <column name="tag"/>
        </constraint>
        <index referenceId="ORDO_CUSTOMER_TAG_TAG" indexType="btree">
            <column name="tag"/>
        </index>
    </table>

    <table name="ordo_order_approval" resource="default" engine="innodb" comment="Approval hold for orders placed above a customer spend limit — the minimal stand-in for a B2B approval workflow">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="sales_order.entity_id"/>
        <column xsi:type="varchar" name="admin_email" nullable="false" length="255" comment="Email of the person who must approve"/>
        <column xsi:type="varchar" name="token" nullable="false" length="64" comment="Opaque token used in the approve/reject links, no login required"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" default="pending" comment="pending|approved|rejected"/>
        <column xsi:type="smallint" name="reminders_sent" unsigned="true" nullable="false" default="0" comment="Number of escalation reminders sent"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="decided_at" nullable="true" comment="Decided At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ORDO_ORDER_APPROVAL_ORDER_ID">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ORDO_ORDER_APPROVAL_TOKEN">
            <column name="token"/>
        </constraint>
        <index referenceId="ORDO_ORDER_APPROVAL_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="ordo_campaign" resource="default" engine="innodb" comment="A configurable when-X-happens-and-Y-is-true-do-Z marketing rule">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Admin-facing name"/>
        <column xsi:type="varchar" name="trigger_event" nullable="true" length="64" comment="DEPRECATED — superseded by ordo_campaign_trigger (a campaign can have more than one trigger now). Kept nullable, unread by any code path, purely so Setup\Patch\Data\MigrateCampaignTriggerToChildTable has a column to read from on upgrade. Safe to drop in a follow-up schema-only release once every install has run that patch."/>
        <column xsi:type="boolean" name="enabled" nullable="false" default="0" comment="Enabled"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_CAMPAIGN_ENABLED" indexType="btree">
            <column name="enabled"/>
        </index>
    </table>

    <table name="ordo_campaign_trigger" resource="default" engine="innodb" comment="One trigger event that starts a campaign — a campaign can fire on more than one, e.g. both customer_registered and tag_added, running the same conditions/actions either way">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="campaign_id" padding="10" unsigned="true" nullable="false" comment="ordo_campaign.entity_id"/>
        <column xsi:type="varchar" name="trigger_event" nullable="false" length="64" comment="e.g. order_placed, customer_registered, tag_added"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_CAMPAIGN_TRIGGER_CAMPAIGN_ID_CAMPAIGN_ENTITY_ID"
                    table="ordo_campaign_trigger" column="campaign_id"
                    referenceTable="ordo_campaign" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="ORDO_CAMPAIGN_TRIGGER_CAMPAIGN_ID_TRIGGER_EVENT">
            <column name="campaign_id"/>
            <column name="trigger_event"/>
        </constraint>
        <index referenceId="ORDO_CAMPAIGN_TRIGGER_EVENT" indexType="btree">
            <column name="trigger_event"/>
        </index>
    </table>

    <table name="ordo_campaign_condition" resource="default" engine="innodb" comment="One AND-ed condition on a campaign">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="campaign_id" padding="10" unsigned="true" nullable="false" comment="ordo_campaign.entity_id"/>
        <column xsi:type="varchar" name="type" nullable="false" length="64" comment="Condition type key, matches Model\Campaign\ConditionPool registration"/>
        <column xsi:type="text" name="params" nullable="true" comment="JSON-encoded condition configuration"/>
        <column xsi:type="smallint" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_CAMPAIGN_CONDITION_CAMPAIGN_ID_CAMPAIGN_ENTITY_ID"
                    table="ordo_campaign_condition" column="campaign_id"
                    referenceTable="ordo_campaign" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ORDO_CAMPAIGN_CONDITION_CAMPAIGN_ID" indexType="btree">
            <column name="campaign_id"/>
        </index>
    </table>

    <table name="ordo_campaign_action" resource="default" engine="innodb" comment="One action a campaign runs, in sort_order, once all its conditions pass">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="campaign_id" padding="10" unsigned="true" nullable="false" comment="ordo_campaign.entity_id"/>
        <column xsi:type="varchar" name="type" nullable="false" length="64" comment="Action type key, matches Model\Campaign\ActionPool registration"/>
        <column xsi:type="text" name="params" nullable="true" comment="JSON-encoded action configuration"/>
        <column xsi:type="smallint" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <column xsi:type="int" name="delay_minutes" padding="10" unsigned="true" nullable="false" default="0" comment="Minutes to wait after the previous action (or the trigger, if this is the first) before running this one. 0 runs immediately, in the same dispatch as everything before it."/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_CAMPAIGN_ACTION_CAMPAIGN_ID_CAMPAIGN_ENTITY_ID"
                    table="ordo_campaign_action" column="campaign_id"
                    referenceTable="ordo_campaign" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ORDO_CAMPAIGN_ACTION_CAMPAIGN_ID" indexType="btree">
            <column name="campaign_id"/>
        </index>
    </table>

    <table name="ordo_campaign_scheduled_action" resource="default" engine="innodb" comment="A paused campaign action chain waiting on a delay_minutes step — CampaignDispatcher stops running its actions synchronously the moment it reaches one with a delay and writes one of these instead of blocking. Cron\RunScheduledCampaignActions resumes the chain (starting at, and including, resume_action_id) once run_at has passed.">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="campaign_id" padding="10" unsigned="true" nullable="false" comment="ordo_campaign.entity_id"/>
        <column xsi:type="int" name="resume_action_id" padding="10" unsigned="true" nullable="false" comment="ordo_campaign_action.entity_id — the delayed action to run when this row is resumed, then continue on to the rest of the chain"/>
        <column xsi:type="text" name="context" nullable="false" comment="JSON-encoded dispatch context (customer_id, order_id, etc. — whatever the trigger observer originally passed in, including any mutations earlier, non-delayed actions in the same chain made before the delay was hit)"/>
        <column xsi:type="datetime" name="run_at" nullable="false" comment="Earliest time this row is eligible to resume"/>
        <column xsi:type="datetime" name="executed_at" nullable="true" comment="Set the moment the cron claims this row, before running it — not just on success — so a row can never be picked up twice even if execution itself throws"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_CAMPAIGN_SCHEDULED_ACTION_CAMPAIGN_ID_CAMPAIGN_ENTITY_ID"
                    table="ordo_campaign_scheduled_action" column="campaign_id"
                    referenceTable="ordo_campaign" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="ORDO_CAMPAIGN_SCHEDULED_ACTION_RESUME_ACTION_ID_CAMPAIGN_ACTION_ENTITY_ID"
                    table="ordo_campaign_scheduled_action" column="resume_action_id"
                    referenceTable="ordo_campaign_action" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ORDO_CAMPAIGN_SCHEDULED_ACTION_RUN_AT_EXECUTED_AT" indexType="btree">
            <column name="run_at"/>
            <column name="executed_at"/>
        </index>
    </table>

    <table name="ordo_visitor_event" resource="default" engine="innodb" comment="Raw on-site behavior events — short-lived by design, see PruneVisitorEvents. Deliberately kept separate from ordo_campaign/ordo_customer_tag, which are low-frequency and long-lived.">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="visitor_id" nullable="false" length="64" comment="Anonymous first-party cookie value"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="true" comment="Set once identity stitching links this visitor to a logged-in customer"/>
        <column xsi:type="varchar" name="event_type" nullable="false" length="32" comment="e.g. page_view, product_view, category_view"/>
        <column xsi:type="varchar" name="event_key" nullable="true" length="255" comment="e.g. the SKU or category id the event was about, for grouping"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_VISITOR_EVENT_VISITOR_ID" indexType="btree">
            <column name="visitor_id"/>
        </index>
        <index referenceId="ORDO_VISITOR_EVENT_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="ORDO_VISITOR_EVENT_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>

    <table name="ordo_visitor_tag" resource="default" engine="innodb" comment="Behavioral tags for anonymous, never-logged-in visitors — the same segmentation primitive as ordo_customer_tag, keyed by visitor_id instead of customer_id since an anonymous visitor has no customer row to attach to yet">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="visitor_id" nullable="false" length="64" comment="Anonymous first-party cookie value, matches ordo_visitor_event.visitor_id"/>
        <column xsi:type="varchar" name="tag" nullable="false" length="64" comment="Tag, e.g. viewed_category_view_15"/>
        <column xsi:type="timestamp" name="added_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Added At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ORDO_VISITOR_TAG_VISITOR_ID_TAG">
            <column name="visitor_id"/>
            <column name="tag"/>
        </constraint>
        <index referenceId="ORDO_VISITOR_TAG_TAG" indexType="btree">
            <column name="tag"/>
        </index>
    </table>

    <table name="ordo_pending_popup" resource="default" engine="innodb" comment="A popup/banner a campaign popup action queued for a visitor or customer to see on their next poll — claimed (delivered_at set) the moment Controller\Track\Popup hands it out, the same claim-before-use pattern as ordo_campaign_scheduled_action, so a slow/duplicate poll can never deliver the same popup twice.">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="true" comment="Set when the campaign context that produced this popup had a logged-in customer"/>
        <column xsi:type="varchar" name="visitor_id" nullable="true" length="64" comment="Set when the campaign context that produced this popup had an anonymous visitor_id — at least one of customer_id/visitor_id is always set"/>
        <column xsi:type="varchar" name="headline" nullable="false" length="255" comment="Popup headline"/>
        <column xsi:type="text" name="body" nullable="true" comment="Popup body text"/>
        <column xsi:type="varchar" name="cta_label" nullable="true" length="128" comment="Call-to-action button label"/>
        <column xsi:type="varchar" name="cta_url" nullable="true" length="255" comment="Call-to-action button target URL"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="datetime" name="delivered_at" nullable="true" comment="Set the moment Controller\Track\Popup claims and hands this row out — not before, or a slow concurrent poll could double-deliver"/>
        <column xsi:type="datetime" name="expires_at" nullable="true" comment="If never polled by this time, PrunePendingPopups deletes it as stale rather than delivering something no longer relevant"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_PENDING_POPUP_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="ORDO_PENDING_POPUP_VISITOR_ID" indexType="btree">
            <column name="visitor_id"/>
        </index>
    </table>

    <table name="ordo_free_gift_offer" resource="default" engine="innodb" comment="Free-gift-above-threshold offer header">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Admin-facing name"/>
        <column xsi:type="boolean" name="enabled" nullable="false" default="1" comment="Enabled"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>

    <table name="ordo_free_gift_offer_tier" resource="default" engine="innodb" comment="Cascading cart-subtotal thresholds for a free-gift offer — every tier the cart subtotal has reached ADDS gift_slots, cumulative, not highest-tier-wins">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="offer_id" padding="10" unsigned="true" nullable="false" comment="ordo_free_gift_offer.entity_id"/>
        <column xsi:type="decimal" name="min_subtotal" scale="4" precision="20" unsigned="true" nullable="false" comment="Cart subtotal this tier requires to unlock its gift_slots"/>
        <column xsi:type="smallint" name="gift_slots" unsigned="true" nullable="false" default="1" comment="Gift slots this tier adds once its min_subtotal is met"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_FREE_GIFT_OFFER_TIER_OFFER_ID_FREE_GIFT_OFFER_ENTITY_ID"
                    table="ordo_free_gift_offer_tier" column="offer_id"
                    referenceTable="ordo_free_gift_offer" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ORDO_FREE_GIFT_OFFER_TIER_OFFER_ID" indexType="btree">
            <column name="offer_id"/>
        </index>
    </table>

    <table name="ordo_free_gift_offer_product" resource="default" engine="innodb" comment="Pool of SKUs a customer may pick a free gift from, for a given offer">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="offer_id" padding="10" unsigned="true" nullable="false" comment="ordo_free_gift_offer.entity_id"/>
        <column xsi:type="varchar" name="sku" nullable="false" length="64" comment="Product SKU"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_FREE_GIFT_OFFER_PRODUCT_OFFER_ID_FREE_GIFT_OFFER_ENTITY_ID"
                    table="ordo_free_gift_offer_product" column="offer_id"
                    referenceTable="ordo_free_gift_offer" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="ORDO_FREE_GIFT_OFFER_PRODUCT_OFFER_ID_SKU">
            <column name="offer_id"/>
            <column name="sku"/>
        </constraint>
    </table>

    <table name="ordo_trigger_outcome_log" resource="default" engine="innodb" comment="Sent/response stats for the 5 cron-driven triggers (reorder reminder, offer expiry, credit limit alert, order approval, win-back) — additive to each trigger's own narrow dedup log table, purely for dashboard observability">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="trigger_type" nullable="false" length="32" comment="reorder_reminder|offer_expiry|credit_limit_alert|order_approval|win_back"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="datetime" name="sent_at" nullable="false" comment="When the trigger email was sent"/>
        <column xsi:type="datetime" name="acted_at" nullable="true" comment="Set once the customer places an order after being sent this trigger — null until/unless they respond"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="true" comment="sales_order.entity_id — the order that constitutes the response, set together with acted_at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_TRIGGER_OUTCOME_LOG_TRIGGER_TYPE_CUSTOMER_ID" indexType="btree">
            <column name="trigger_type"/>
            <column name="customer_id"/>
        </index>
        <index referenceId="ORDO_TRIGGER_OUTCOME_LOG_CUSTOMER_ID_ACTED_AT" indexType="btree">
            <column name="customer_id"/>
            <column name="acted_at"/>
        </index>
    </table>

    <table name="ordo_quote_gift_item" resource="default" engine="innodb" comment="Marks a quote_item as a customer-selected free gift, so it can be identified/removed without guessing from price alone">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="quote_id" padding="10" unsigned="true" nullable="false" comment="quote.entity_id"/>
        <column xsi:type="int" name="quote_item_id" padding="10" unsigned="true" nullable="false" comment="quote_item.item_id"/>
        <column xsi:type="int" name="offer_id" padding="10" unsigned="true" nullable="false" comment="ordo_free_gift_offer.entity_id this gift was earned from"/>
        <column xsi:type="varchar" name="sku" nullable="false" length="64" comment="Product SKU"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_QUOTE_GIFT_ITEM_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
        <index referenceId="ORDO_QUOTE_GIFT_ITEM_QUOTE_ITEM_ID" indexType="btree">
            <column name="quote_item_id"/>
        </index>
    </table>

    <table name="ordo_score_rule" resource="default" engine="innodb" comment="Declarative demographic-attribute lead scoring rule — if a customer's attribute value matches, points are awarded (or subtracted) toward their lead score">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="attribute_code" nullable="false" length="64" comment="Customer attribute code, e.g. group_id, website_id, email, store_id, or any EAV custom attribute code"/>
        <column xsi:type="varchar" name="operator" nullable="false" length="32" comment="Comparison operator: equals, not_equals, contains"/>
        <column xsi:type="varchar" name="value" nullable="false" length="255" comment="Value to compare the attribute against"/>
        <column xsi:type="int" name="points" unsigned="false" nullable="false" default="0" comment="Points awarded when this rule matches — can be negative"/>
        <column xsi:type="boolean" name="enabled" nullable="false" default="1" comment="Whether this rule is evaluated"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Display/evaluation order"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>

    <table name="ordo_customer_demographic_score" resource="default" engine="innodb" comment="Current sum of matching ordo_score_rule points per customer, tracked separately from ordo_customer_score so a rule change's delta can be computed and applied additively instead of re-summing every rule on every save">
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="int" name="score" unsigned="false" nullable="false" default="0" comment="Current sum of matching demographic scoring rule points"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="customer_id"/>
        </constraint>
    </table>

    <table name="ordo_customer_rfm_score" resource="default" engine="innodb" comment="Precomputed RFM percentile ranks and 1-5 quintile buckets per customer, refreshed by Cron\RecomputeRfmScores instead of RfmCalculator::getPercentileRanks() scanning/sorting the whole customer base on every campaign dispatch or segment resolve">
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="decimal" name="recency_percentile" scale="2" precision="5" unsigned="false" nullable="false" comment="0-100, 100 = most recent"/>
        <column xsi:type="decimal" name="frequency_percentile" scale="2" precision="5" unsigned="false" nullable="false" comment="0-100, 100 = most orders"/>
        <column xsi:type="decimal" name="monetary_percentile" scale="2" precision="5" unsigned="false" nullable="false" comment="0-100, 100 = highest spend"/>
        <column xsi:type="smallint" name="recency_quintile" unsigned="true" nullable="false" comment="1 (worst/stalest) - 5 (best/most recent)"/>
        <column xsi:type="smallint" name="frequency_quintile" unsigned="true" nullable="false" comment="1 (fewest orders) - 5 (most orders)"/>
        <column xsi:type="smallint" name="monetary_quintile" unsigned="true" nullable="false" comment="1 (lowest spend) - 5 (highest spend)"/>
        <column xsi:type="timestamp" name="computed_at" nullable="false" default="CURRENT_TIMESTAMP" comment="When Cron\RecomputeRfmScores last wrote this row"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="customer_id"/>
        </constraint>
    </table>

</schema>
