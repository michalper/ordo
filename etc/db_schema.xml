<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="ordo_reorder_cycle" resource="default" engine="innodb" comment="Detected reorder cycle per customer and SKU">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="sku" nullable="false" length="64" comment="Product SKU"/>
        <column xsi:type="smallint" name="avg_interval_days" unsigned="true" nullable="false" comment="Average interval between orders, in days"/>
        <column xsi:type="date" name="last_order_date" nullable="false" comment="Date of the most recent order containing this SKU"/>
        <column xsi:type="date" name="next_expected_date" nullable="false" comment="Predicted date of the next order"/>
        <column xsi:type="smallint" name="orders_considered" unsigned="true" nullable="false" comment="Number of past orders used to compute the cycle"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ORDO_REORDER_CYCLE_CUSTOMER_ID_SKU">
            <column name="customer_id"/>
            <column name="sku"/>
        </constraint>
        <index referenceId="ORDO_REORDER_CYCLE_NEXT_EXPECTED_DATE" indexType="btree">
            <column name="next_expected_date"/>
        </index>
    </table>

    <table name="ordo_reorder_reminder_log" resource="default" engine="innodb" comment="Log of sent reorder reminders, to avoid duplicate sends">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="reorder_cycle_id" padding="10" unsigned="true" nullable="false" comment="ordo_reorder_cycle.entity_id"/>
        <column xsi:type="timestamp" name="sent_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Sent At"/>
        <column xsi:type="boolean" name="reacted" nullable="false" default="false" comment="Whether the customer placed a matching order after the reminder"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_REMINDER_LOG_CYCLE_ID_REORDER_CYCLE_ENTITY_ID"
                    table="ordo_reorder_reminder_log" column="reorder_cycle_id"
                    referenceTable="ordo_reorder_cycle" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="ordo_abandoned_cart_reminder_log" resource="default" engine="innodb" comment="Log of sent abandoned cart reminders, to cap reminders per cart">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="quote_id" padding="10" unsigned="true" nullable="false" comment="quote.entity_id"/>
        <column xsi:type="timestamp" name="sent_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Sent At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_ABANDONED_CART_LOG_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
    </table>

    <table name="ordo_offer" resource="default" engine="innodb" comment="B2B offer/quote with an expiration date — the entity Magento Open Source doesn't have natively">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="reference" nullable="false" length="32" comment="Human-readable offer reference, e.g. OFR-000123"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" default="draft" comment="draft|sent|accepted|rejected|expired"/>
        <column xsi:type="decimal" name="total" scale="4" precision="20" unsigned="false" nullable="false" default="0" comment="Offer total"/>
        <column xsi:type="varchar" name="currency_code" nullable="false" length="3" default="USD" comment="Currency code"/>
        <column xsi:type="date" name="expires_at" nullable="false" comment="Expiration date"/>
        <column xsi:type="int" name="extension_count" unsigned="true" nullable="false" default="0" comment="Number of times the customer self-extended the expiry"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ORDO_OFFER_REFERENCE">
            <column name="reference"/>
        </constraint>
        <index referenceId="ORDO_OFFER_STATUS_EXPIRES_AT" indexType="btree">
            <column name="status"/>
            <column name="expires_at"/>
        </index>
        <index referenceId="ORDO_OFFER_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>

    <table name="ordo_offer_reminder_log" resource="default" engine="innodb" comment="Log of sent offer expiry reminders, to avoid duplicate sends">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="offer_id" padding="10" unsigned="true" nullable="false" comment="ordo_offer.entity_id"/>
        <column xsi:type="varchar" name="reminder_type" nullable="false" length="20" comment="expiring_soon|expired"/>
        <column xsi:type="timestamp" name="sent_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Sent At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_OFFER_REMINDER_LOG_OFFER_ID_OFFER_ENTITY_ID"
                    table="ordo_offer_reminder_log" column="offer_id"
                    referenceTable="ordo_offer" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="ordo_credit_limit_alert_log" resource="default" engine="innodb" comment="Log of sent credit limit alerts, one row per threshold band crossed, to control alert frequency">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="smallint" name="threshold_percent" unsigned="true" nullable="false" comment="Threshold band crossed, e.g. 80 or 100"/>
        <column xsi:type="decimal" name="utilization_percent" scale="2" precision="7" unsigned="true" nullable="false" comment="Actual utilization at send time"/>
        <column xsi:type="timestamp" name="sent_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Sent At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_CREDIT_LIMIT_ALERT_LOG_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>

    <table name="ordo_customer_tag" resource="default" engine="innodb" comment="Behavioral tags — the segmentation primitive every B2C trigger and future campaign targeting reads from">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="varchar" name="tag" nullable="false" length="64" comment="Tag, e.g. new_customer, vip, inactive, win_back_sent"/>
        <column xsi:type="timestamp" name="added_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Added At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ORDO_CUSTOMER_TAG_CUSTOMER_ID_TAG">
            <column name="customer_id"/>
            <column name="tag"/>
        </constraint>
        <index referenceId="ORDO_CUSTOMER_TAG_TAG" indexType="btree">
            <column name="tag"/>
        </index>
    </table>

    <table name="ordo_order_approval" resource="default" engine="innodb" comment="Approval hold for orders placed above a customer's spend limit — the minimal stand-in for a B2B approval workflow">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="sales_order.entity_id"/>
        <column xsi:type="varchar" name="admin_email" nullable="false" length="255" comment="Email of the person who must approve"/>
        <column xsi:type="varchar" name="token" nullable="false" length="64" comment="Opaque token used in the approve/reject links, no login required"/>
        <column xsi:type="varchar" name="status" nullable="false" length="20" default="pending" comment="pending|approved|rejected"/>
        <column xsi:type="smallint" name="reminders_sent" unsigned="true" nullable="false" default="0" comment="Number of escalation reminders sent"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="decided_at" nullable="true" comment="Decided At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ORDO_ORDER_APPROVAL_ORDER_ID">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ORDO_ORDER_APPROVAL_TOKEN">
            <column name="token"/>
        </constraint>
        <index referenceId="ORDO_ORDER_APPROVAL_STATUS" indexType="btree">
            <column name="status"/>
        </index>
    </table>

    <table name="ordo_campaign" resource="default" engine="innodb" comment="A configurable 'when X happens and Y is true, do Z' marketing rule">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Admin-facing name"/>
        <column xsi:type="varchar" name="trigger_event" nullable="false" length="64" comment="e.g. order_placed, customer_registered, tag_added"/>
        <column xsi:type="boolean" name="enabled" nullable="false" default="0" comment="Enabled"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_CAMPAIGN_TRIGGER_EVENT_ENABLED" indexType="btree">
            <column name="trigger_event"/>
            <column name="enabled"/>
        </index>
    </table>

    <table name="ordo_campaign_condition" resource="default" engine="innodb" comment="One AND-ed condition on a campaign">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="campaign_id" padding="10" unsigned="true" nullable="false" comment="ordo_campaign.entity_id"/>
        <column xsi:type="varchar" name="type" nullable="false" length="64" comment="Condition type key, matches Model\Campaign\ConditionPool registration"/>
        <column xsi:type="text" name="params" nullable="true" comment="JSON-encoded condition configuration"/>
        <column xsi:type="smallint" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_CAMPAIGN_CONDITION_CAMPAIGN_ID_CAMPAIGN_ENTITY_ID"
                    table="ordo_campaign_condition" column="campaign_id"
                    referenceTable="ordo_campaign" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ORDO_CAMPAIGN_CONDITION_CAMPAIGN_ID" indexType="btree">
            <column name="campaign_id"/>
        </index>
    </table>

    <table name="ordo_campaign_action" resource="default" engine="innodb" comment="One action a campaign runs, in sort_order, once all its conditions pass">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="campaign_id" padding="10" unsigned="true" nullable="false" comment="ordo_campaign.entity_id"/>
        <column xsi:type="varchar" name="type" nullable="false" length="64" comment="Action type key, matches Model\Campaign\ActionPool registration"/>
        <column xsi:type="text" name="params" nullable="true" comment="JSON-encoded action configuration"/>
        <column xsi:type="smallint" name="sort_order" unsigned="true" nullable="false" default="0" comment="Sort Order"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_CAMPAIGN_ACTION_CAMPAIGN_ID_CAMPAIGN_ENTITY_ID"
                    table="ordo_campaign_action" column="campaign_id"
                    referenceTable="ordo_campaign" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ORDO_CAMPAIGN_ACTION_CAMPAIGN_ID" indexType="btree">
            <column name="campaign_id"/>
        </index>
    </table>

    <table name="ordo_visitor_event" resource="default" engine="innodb" comment="Raw on-site behavior events — short-lived by design, see PruneVisitorEvents. Deliberately kept separate from ordo_campaign/ordo_customer_tag, which are low-frequency and long-lived.">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="visitor_id" nullable="false" length="64" comment="Anonymous first-party cookie value"/>
        <column xsi:type="int" name="customer_id" padding="10" unsigned="true" nullable="true" comment="Set once identity stitching links this visitor to a logged-in customer"/>
        <column xsi:type="varchar" name="event_type" nullable="false" length="32" comment="e.g. page_view, product_view, category_view"/>
        <column xsi:type="varchar" name="event_key" nullable="true" length="255" comment="e.g. the SKU or category id the event was about, for grouping"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_VISITOR_EVENT_VISITOR_ID" indexType="btree">
            <column name="visitor_id"/>
        </index>
        <index referenceId="ORDO_VISITOR_EVENT_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="ORDO_VISITOR_EVENT_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>

    <table name="ordo_free_gift_offer" resource="default" engine="innodb" comment="Free-gift-above-threshold offer header">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Admin-facing name"/>
        <column xsi:type="boolean" name="enabled" nullable="false" default="1" comment="Enabled"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>

    <table name="ordo_free_gift_offer_tier" resource="default" engine="innodb" comment="Cascading cart-subtotal thresholds for a free-gift offer — every tier the cart subtotal has reached ADDS gift_slots, cumulative, not highest-tier-wins">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="offer_id" padding="10" unsigned="true" nullable="false" comment="ordo_free_gift_offer.entity_id"/>
        <column xsi:type="decimal" name="min_subtotal" scale="4" precision="20" unsigned="true" nullable="false" comment="Cart subtotal this tier requires to unlock its gift_slots"/>
        <column xsi:type="smallint" name="gift_slots" unsigned="true" nullable="false" default="1" comment="Gift slots this tier adds once its min_subtotal is met"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_FREE_GIFT_OFFER_TIER_OFFER_ID_FREE_GIFT_OFFER_ENTITY_ID"
                    table="ordo_free_gift_offer_tier" column="offer_id"
                    referenceTable="ordo_free_gift_offer" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ORDO_FREE_GIFT_OFFER_TIER_OFFER_ID" indexType="btree">
            <column name="offer_id"/>
        </index>
    </table>

    <table name="ordo_free_gift_offer_product" resource="default" engine="innodb" comment="Pool of SKUs a customer may pick a free gift from, for a given offer">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="offer_id" padding="10" unsigned="true" nullable="false" comment="ordo_free_gift_offer.entity_id"/>
        <column xsi:type="varchar" name="sku" nullable="false" length="64" comment="Product SKU"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ORDO_FREE_GIFT_OFFER_PRODUCT_OFFER_ID_FREE_GIFT_OFFER_ENTITY_ID"
                    table="ordo_free_gift_offer_product" column="offer_id"
                    referenceTable="ordo_free_gift_offer" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="ORDO_FREE_GIFT_OFFER_PRODUCT_OFFER_ID_SKU">
            <column name="offer_id"/>
            <column name="sku"/>
        </constraint>
    </table>

    <table name="ordo_quote_gift_item" resource="default" engine="innodb" comment="Marks a quote_item as a customer-selected free gift, so it can be identified/removed without guessing from price alone">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="quote_id" padding="10" unsigned="true" nullable="false" comment="quote.entity_id"/>
        <column xsi:type="int" name="quote_item_id" padding="10" unsigned="true" nullable="false" comment="quote_item.item_id"/>
        <column xsi:type="int" name="offer_id" padding="10" unsigned="true" nullable="false" comment="ordo_free_gift_offer.entity_id this gift was earned from"/>
        <column xsi:type="varchar" name="sku" nullable="false" length="64" comment="Product SKU"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <index referenceId="ORDO_QUOTE_GIFT_ITEM_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
        <index referenceId="ORDO_QUOTE_GIFT_ITEM_QUOTE_ITEM_ID" indexType="btree">
            <column name="quote_item_id"/>
        </index>
    </table>

</schema>
