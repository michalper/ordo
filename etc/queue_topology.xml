<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/topology.xsd">
    <exchange name="magento">
        <binding id="OrdoAutomationCampaignDispatch" topic="ordo.automation.campaign.dispatch"
                 destination="ordo.automation.campaign.dispatch"/>
        <binding id="OrdoAutomationVisitorAggregate" topic="ordo.automation.visitor.aggregate"
                 destination="ordo.automation.visitor.aggregate"/>
        <binding id="OrdoAutomationSegmentBulkAction" topic="ordo.automation.segment.bulk_action"
                 destination="ordo.automation.segment.bulk_action"/>
    </exchange>
</config>
