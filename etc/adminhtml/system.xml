<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="ordo" translate="label" sortOrder="200">
            <label>Ordo Automation</label>
        </tab>
        <section id="ordo_automation" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>General</label>
            <tab>ordo</tab>
            <resource>Ordo_Automation::config</resource>

            <group id="reorder" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Reorder Reminder</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="min_orders" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum orders to detect a pattern</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="lead_days" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send reminder N days before the expected date</label>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <group id="abandoned_cart" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Abandoned Cart Recovery</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="delay_minutes" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send reminder N minutes after last cart activity</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="min_subtotal" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum cart subtotal to trigger a reminder</label>
                    <validate>validate-number</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="max_reminders" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum reminders per cart</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <group id="offer" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Offer Expiry Reminder</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="lead_days" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send reminder N days before the offer expires</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="max_self_extensions" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum times a customer can self-extend an offer</label>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="self_extension_days" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Days added per self-extension</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <group id="credit_limit" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Credit Limit Alert</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Requires setting a "Credit Limit" on customers you want to monitor (Customers grid → Edit Customer).</comment>
                </field>
                <field id="warning_threshold_percent" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Warn at this % of credit limit used</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="cooldown_days" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum days between repeated alerts for the same threshold</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="block_checkout_enabled" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Block Checkout When Over Credit Limit</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Hard-blocks order placement for a logged-in customer whose credit limit utilization has reached 100%. Disabled by default — separate opt-in from the warning email above.</comment>
                </field>
            </group>

            <group id="lifecycle" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>B2C Lifecycle Emails (Welcome / Win-back)</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="win_back_inactive_days" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tag a customer "inactive" after this many days without an order</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <group id="order_approval" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Order Approval Workflow</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Requires setting "Order Spend Limit" and "Order Approval Admin Email" on customers you want held for approval (Customers grid → Edit Customer).</comment>
                </field>
                <field id="escalation_days" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Escalate (resend) if not decided within this many days</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <group id="sales_rep" translate="label" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Sales Rep Signature &amp; Digest</label>
                <field id="digest_enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send weekly digest to reps</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>The rep signature on reorder/offer/credit emails is always active once a customer has "Assigned Sales Rep" fields set — this only controls the separate weekly summary email.</comment>
                </field>
            </group>

            <group id="tracking" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>On-Site Behavior Tracking</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Controls whether the tracker.js snippet renders at all (view/frontend/layout/default.xml only adds the block when this is enabled) and whether the /ordo/track/event endpoint stores anything it receives.</comment>
                </field>
                <field id="view_threshold" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tag a customer after this many views of the same item</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="click_threshold" translate="label" type="text" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Tag a customer after this many clicks on the same tracked element</label>
                    <comment>A click is higher-intent than a view — 1 is usually enough, unlike the view threshold above.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="retention_days" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Delete raw events older than this many days</label>
                    <comment>Only raw events are pruned — tags already derived from them are unaffected and stay permanently.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="popup_enabled" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable on-site popups</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Lets a campaign's "Show Popup" action queue a banner for the visitor/customer's browser to pick up on its next poll (see tracker.js). Requires tracking to be enabled above.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="popup_poll_interval_seconds" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Popup poll interval (seconds)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="popup_enabled">1</field>
                    </depends>
                </field>
                <field id="popup_frequency_cap_hours" translate="label comment" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Popup frequency cap (hours)</label>
                    <comment>Minimum time between two popups shown to the same visitor/customer. 0 disables the cap.</comment>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="popup_enabled">1</field>
                    </depends>
                </field>
                <field id="notification_enabled" translate="label comment" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable persistent in-site notifications</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Lets a campaign's "Notify" action queue a non-modal banner that stays visible across page loads until the visitor/customer dismisses it or it expires - unlike "Show Popup" above, which is one-shot. Requires tracking to be enabled above.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="notification_poll_interval_seconds" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Notification poll interval (seconds)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="notification_enabled">1</field>
                    </depends>
                </field>
                <field id="nps_survey_enabled" translate="label comment" type="select" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable single-question NPS/satisfaction survey</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Lets a campaign's "NPS Survey" action queue a single 0-10 question, delivered and answered the same poll-and-claim way as "Show Popup"/"Persistent Notification" above. Requires tracking to be enabled above.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="nps_survey_poll_interval_seconds" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>NPS survey poll interval (seconds)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends>
                        <field id="enabled">1</field>
                        <field id="nps_survey_enabled">1</field>
                    </depends>
                </field>
            </group>

            <group id="free_gift" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Free Gift Above Threshold</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Master switch — offers, tiers, and gift pools are managed via the REST API (Ordo_Automation::free_gifts), not this section.</comment>
                </field>
            </group>
            <group id="lead_scoring" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Lead Scoring</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Master switch — demographic-attribute scoring rules are managed under Ordo Automation &gt; Score Rules (Ordo_Automation::score_rules), not this section.</comment>
                </field>
                <field id="score_threshold" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Score Threshold</label>
                    <validate>validate-number</validate>
                    <comment>Total lead score (behavioral + demographic) at which the "score_threshold_crossed" campaign trigger fires.</comment>
                </field>
                <field id="loyalty_silver_threshold" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Loyalty Tier: Silver Threshold</label>
                    <validate>validate-number</validate>
                    <comment>Total lead score at which a customer's loyalty tier becomes Silver (below this, Bronze).</comment>
                </field>
                <field id="loyalty_gold_threshold" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Loyalty Tier: Gold Threshold</label>
                    <validate>validate-number</validate>
                    <comment>Total lead score at which a customer's loyalty tier becomes Gold.</comment>
                </field>
            </group>


            <group id="sms" translate="label" type="text" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>SMS (Twilio)</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Master switch for the "Send SMS" campaign action. Requires setting "SMS Phone" on customers you want to reach (Customers grid → Edit Customer).</comment>
                </field>
                <field id="twilio_account_sid" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Twilio Account SID</label>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="twilio_auth_token" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Twilio Auth Token</label>
                    <comment>Used only to verify the X-Twilio-Signature on the inbound status-callback webhook — Twilio always signs webhooks with the Auth Token, never with an API Key secret. Not used to authenticate outbound API calls; see "Twilio API Key SID/Secret" below for that.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="twilio_api_key_sid" translate="label comment" type="text" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Twilio API Key SID</label>
                    <comment>A Restricted API Key scoped to Programmable Messaging (Console → Account → API keys &amp; tokens), not the Account SID. Used to authenticate outbound SMS sends, per Twilio's recommendation to avoid granting full-account access for routine API calls.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="twilio_api_key_secret" translate="label" type="obscure" sortOrder="36" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Twilio API Key Secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="twilio_from_number" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Twilio "From" Number</label>
                    <comment>E.164 format, e.g. "+15551234567".</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="ad_audience_sync" translate="label" type="text" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Ad Audience Sync (Google Ads / Meta)</label>
                <field id="google_ads_client_id" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Google Ads OAuth Client ID</label>
                </field>
                <field id="google_ads_client_secret" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Google Ads OAuth Client Secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="google_ads_refresh_token" translate="label" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Google Ads OAuth Refresh Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="google_ads_developer_token" translate="label" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Google Ads Developer Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="google_ads_login_customer_id" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Google Ads Login Customer ID</label>
                    <comment>The manager (MCC) account id, digits only, no dashes.</comment>
                </field>
                <field id="meta_access_token" translate="label comment" type="obscure" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Meta Access Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>A long-lived system-user token with ads_management permission.</comment>
                </field>
                <field id="meta_ad_account_id" translate="label comment" type="text" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Meta Ad Account ID</label>
                    <comment>Digits only, without the "act_" prefix.</comment>
                </field>
            </group>
            <group id="shopping_feed" translate="label" type="text" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Shopping Feed</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Google Merchant Center feed</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Publishes a public, unauthenticated Google Merchant Center-compatible XML feed at "/ordo/productfeed/index", refreshed every 6 hours by Cron\RefreshProductFeed. Distinct from a campaign's "product_feed" content block, which renders a small curated HTML product grid inside emails/on-site, not an exportable feed file.</comment>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Feed Title</label>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="description" translate="label" type="textarea" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Feed Description</label>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="email" translate="label" type="text" sortOrder="140" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Email Delivery Tracking (SendGrid)</label>
                <field id="sendgrid_webhook_verification_key" translate="label comment" type="obscure" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>SendGrid Event Webhook Verification Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Base64-encoded ECDSA public key from the SendGrid account's Event Webhook settings page (Signed Event Webhook Requests). Register "/ordo/email/statuscallback" as that account's Event Webhook URL to receive delivered/bounce/dropped status updates for "send_email" campaign actions into the same message log "Send SMS" already writes to.</comment>
                </field>
            </group>
            <group id="whatsapp" translate="label" type="text" sortOrder="150" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>WhatsApp (Meta Cloud API)</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Master switch for the "Send WhatsApp" campaign action. Requires setting "SMS Phone" on customers you want to reach (the same attribute send_sms uses) and at least one APPROVED template under Ordo Automation &gt; WhatsApp Templates.</comment>
                </field>
                <field id="access_token" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Access Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="phone_number_id" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Phone Number ID</label>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="business_account_id" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>WhatsApp Business Account (WABA) ID</label>
                    <comment>Where new templates are registered (Model\WhatsApp\WhatsAppTemplateClient::submitTemplate()).</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="app_secret" translate="label comment" type="obscure" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>App Secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>From the Meta App Dashboard - verifies the "X-Hub-Signature-256" header on every incoming webhook call.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="webhook_verify_token" translate="label comment" type="obscure" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Webhook Verify Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>An arbitrary string you choose here and enter again when registering "/ordo/whatsapp/webhook" as the Callback URL in the Meta App Dashboard's Webhooks settings - proves the one-time subscription handshake is really Meta.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="push" translate="label" type="text" sortOrder="160" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Push Notifications (Web Push)</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Master switch for the "Send Push" campaign action and for tracker.js offering the browser notification-permission prompt at all. Requires a VAPID key pair below - generate one with `bin/magento ordo:push:vapid:generate`.</comment>
                </field>
                <field id="vapid_public_key" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>VAPID Public Key</label>
                    <comment>Not a secret - sent to every visitor's browser as-is. Generate a matching pair with `bin/magento ordo:push:vapid:generate`.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="vapid_private_key" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>VAPID Private Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Signs every outbound push request's VAPID authentication token (Model\Push\VapidTokenBuilder) - never sent to the browser.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="vapid_subject" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>VAPID Contact (mailto: or https:// URL)</label>
                    <comment>Required by the Web Push standard (RFC 8292) so a push service (Chrome/Firefox/etc.) can reach this site's operator if its traffic needs attention, e.g. "mailto:ops@example.com".</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <group id="frequency_cap" translate="label" type="text" sortOrder="170" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Frequency Cap (cross-channel)</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Off by default. When on, every send_email/send_sms/send_whatsapp/send_push campaign action counts toward one shared cap per customer, across all channels combined, before sending - not a per-channel limit.</comment>
                </field>
                <field id="max_messages" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Max messages per customer, per window</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="window_hours" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Rolling window (hours)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
