<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\SalesRule\Model\Rule\Action\SimpleActionOptionsProvider">
        <plugin name="ordo_add_cheapest_item_free_option" type="Ordo\Automation\Plugin\SalesRule\SimpleActionOptionsProviderPlugin"/>
    </type>

    <!-- Admin action audit log - see Model\AdminActionLog\Recorder's own docblock. Admin-scoped
         (not etc/di.xml) since these plugins depend on Magento\Backend\Model\Auth\Session, which
         only exists in the adminhtml area. -->
    <type name="Ordo\Automation\Model\Campaign\CampaignSaveProcessor">
        <plugin name="ordo_admin_action_log_campaign" type="Ordo\Automation\Plugin\Campaign\CampaignSaveProcessorAuditPlugin"/>
    </type>
    <type name="Ordo\Automation\Model\Segment\SegmentSaveProcessor">
        <plugin name="ordo_admin_action_log_segment" type="Ordo\Automation\Plugin\Segment\SegmentSaveProcessorAuditPlugin"/>
    </type>

    <!-- These five entities have no extracted SaveProcessor (unlike Campaign/Segment above), so
         each plugin targets its own ResourceModel::save() instead - see
         Plugin\Shared\AbstractResourceAuditPlugin's own docblock for why each is a real
         subclass (naming only its entity_type label and audited-field list) rather than a
         virtualType - Magento's plugin-list compiler doesn't resolve a virtualType there,
         unlike the Shared\Edit admin buttons' ui_component class attribute. -->
    <type name="Ordo\Automation\Model\ResourceModel\ContentBlock">
        <plugin name="ordo_admin_action_log_content_block" type="Ordo\Automation\Plugin\ContentBlock\ContentBlockResourceAuditPlugin"/>
    </type>
    <type name="Ordo\Automation\Model\ResourceModel\FreeGiftOffer">
        <plugin name="ordo_admin_action_log_free_gift_offer" type="Ordo\Automation\Plugin\FreeGiftOffer\FreeGiftOfferResourceAuditPlugin"/>
    </type>
    <type name="Ordo\Automation\Model\ResourceModel\ScoreRule">
        <plugin name="ordo_admin_action_log_score_rule" type="Ordo\Automation\Plugin\ScoreRule\ScoreRuleResourceAuditPlugin"/>
    </type>
    <type name="Ordo\Automation\Model\ResourceModel\AdAudience">
        <plugin name="ordo_admin_action_log_ad_audience" type="Ordo\Automation\Plugin\AdAudience\AdAudienceResourceAuditPlugin"/>
    </type>
    <type name="Ordo\Automation\Model\ResourceModel\WhatsAppTemplate">
        <plugin name="ordo_admin_action_log_whatsapp_template" type="Ordo\Automation\Plugin\WhatsAppTemplate\WhatsAppTemplateResourceAuditPlugin"/>
    </type>

    <!-- Admin edit-form toolbar buttons. The 32 per-entity button classes collapsed into four
         parametrized classes under Block\Adminhtml\Shared\Edit; each entity's save /
         save-and-continue / delete button is a virtualType of one of them, carrying only the
         strings that actually differed (save label, form target, delete-confirm message).
         These are this module's first virtualTypes: a virtualType is a named DI configuration
         of an existing class, not a PHP class — the name below works in a ui_component form
         XML's <button class="..."> attribute because Magento resolves it through
         ButtonProviderFactory -> ObjectManager::create(), which maps virtualType names to
         their base class. BackButton needs no per-entity strings, so the form XMLs reference
         Ordo\Automation\Block\Adminhtml\Shared\Edit\BackButton directly. -->
    <virtualType name="OrdoAutomationAdAudienceSaveButton" type="Ordo\Automation\Block\Adminhtml\Shared\Edit\SaveButton">
        <arguments>
            <argument name="label" xsi:type="string">Save Ad Audience</argument>
            <argument name="targetName" xsi:type="string">ordo_adaudience_form.ordo_adaudience_form</argument>
        </arguments>
    </virtualType>
    <virtualType name="OrdoAutomationAdAudienceSaveAndContinueButton" type="Ordo\Automation\Block\Adminhtml\Shared\Edit\SaveAndContinueButton">
        <arguments>
            <argument name="targetName" xsi:type="string">ordo_adaudience_form.ordo_adaudience_form</argument>
        </arguments>
    </virtualType>
    <virtualType name="OrdoAutomationAdAudienceDeleteButton" type="Ordo\Automation\Block\Adminhtml\Shared\Edit\DeleteButton">
        <arguments>
            <argument name="confirmMessage" xsi:type="string">Are you sure you want to delete this ad audience?</argument>
        </arguments>
    </virtualType>
    <virtualType name="OrdoAutomationCampaignSaveButton" type="Ordo\Automation\Block\Adminhtml\Shared\Edit\SaveButton">
        <arguments>
            <argument name="label" xsi:type="string">Save Campaign</argument>
            <argument name="targetName" xsi:type="string">ordo_campaign_form.ordo_campaign_form</argument>
        </arguments>
    </virtualType>
    <virtualType name="OrdoAutomationCampaignSaveAndContinueButton" type="Ordo\Automation\Block\Adminhtml\Shared\Edit\SaveAndContinueButton">
        <arguments>
            <argument name="targetName" xsi:type="string">ordo_campaign_form.ordo_campaign_form</argument>
        </arguments>
    </virtualType>
    <virtualType name="OrdoAutomationCampaignDeleteButton" type="Ordo\Automation\Block\Adminhtml\Shared\Edit\DeleteButton">
        <arguments>
            <argument name="confirmMessage" xsi:type="string">Are you sure you want to delete this campaign?</argument>
        </arguments>
    </virtualType>
    <virtualType name="OrdoAutomationContentBlockSaveButton" type="Ordo\Automation\Block\Adminhtml\Shared\Edit\SaveButton">
