    <virtualType name="OrdoAutomationLeadRoutingRuleSaveButton" type="Ordo\Automation\Block\Adminhtml\Shared\Edit\SaveButton">
        <arguments>
            <argument name="label" xsi:type="string">Save Lead Routing Rule</argument>
            <argument name="targetName" xsi:type="string">ordo_leadroutingrule_form.ordo_leadroutingrule_form</argument>
        </arguments>
    </virtualType>
    <virtualType name="OrdoAutomationLeadRoutingRuleSaveAndContinueButton" type="Ordo\Automation\Block\Adminhtml\Shared\Edit\SaveAndContinueButton">
        <arguments>
