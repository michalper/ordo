<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Backend:etc/menu.xsd">
    <menu>
        <!--
            Single flat entry point, no dropdown/submenu — clicking "Ordo Automation"
            goes straight to the dashboard. Campaigns / Reorder Cycles / Configuration
            are still real admin controllers (unchanged), just linked as cards from
            the dashboard itself instead of being separate menu items.
        -->
        <add id="Ordo_Automation::top_level" title="Ordo Automation" module="Ordo_Automation"
             sortOrder="61" resource="Ordo_Automation::campaigns" action="ordo/dashboard/index"/>
    </menu>
</config>
