<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/consumer.xsd">
    <consumer name="ordo.automation.campaign.dispatch" queue="ordo.automation.campaign.dispatch"
              handler="Ordo\Automation\Model\Queue\CampaignDispatchConsumer::execute"/>
    <consumer name="ordo.automation.visitor.aggregate" queue="ordo.automation.visitor.aggregate"
              handler="Ordo\Automation\Model\Queue\VisitorAggregationConsumer::execute"/>
    <consumer name="ordo.automation.segment.bulk_action" queue="ordo.automation.segment.bulk_action"
              handler="Ordo\Automation\Model\Queue\SegmentBulkActionConsumer::execute"/>
</config>
