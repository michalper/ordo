<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Communication/etc/communication.xsd">
    <topic name="ordo.automation.campaign.dispatch" is_synchronous="false" request="string">
        <handler name="ordoAutomationCampaignDispatch"
                 type="Ordo\Automation\Model\Queue\CampaignDispatchConsumer" method="execute"/>
    </topic>
    <topic name="ordo.automation.visitor.aggregate" is_synchronous="false" request="string">
        <handler name="ordoAutomationVisitorAggregate"
                 type="Ordo\Automation\Model\Queue\VisitorAggregationConsumer" method="execute"/>
    </topic>
    <topic name="ordo.automation.segment.bulk_action" is_synchronous="false" request="string">
        <handler name="ordoAutomationSegmentBulkAction"
                 type="Ordo\Automation\Model\Queue\SegmentBulkActionConsumer" method="execute"/>
    </topic>
</config>
