<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="ordo_automation_calculate_reorder_cycle" instance="Ordo\Automation\Cron\CalculateReorderCycle" method="execute">
            <schedule>0 2 * * *</schedule>
        </job>
        <job name="ordo_automation_send_reorder_reminders" instance="Ordo\Automation\Cron\SendReorderReminders" method="execute">
            <schedule>0 7 * * *</schedule>
        </job>
        <job name="ordo_automation_send_abandoned_cart_reminders" instance="Ordo\Automation\Cron\SendAbandonedCartReminders" method="execute">
            <schedule>*/30 * * * *</schedule>
        </job>
        <job name="ordo_automation_send_offer_expiry_reminders" instance="Ordo\Automation\Cron\SendOfferExpiryReminders" method="execute">
            <schedule>0 8 * * *</schedule>
        </job>
        <job name="ordo_automation_expire_overdue_offers" instance="Ordo\Automation\Cron\ExpireOverdueOffers" method="execute">
            <schedule>30 8 * * *</schedule>
        </job>
        <job name="ordo_automation_send_credit_limit_alerts" instance="Ordo\Automation\Cron\SendCreditLimitAlerts" method="execute">
            <schedule>0 6 * * *</schedule>
        </job>
        <job name="ordo_automation_tag_inactive_customers" instance="Ordo\Automation\Cron\TagInactiveCustomers" method="execute">
            <schedule>0 3 * * *</schedule>
        </job>
        <job name="ordo_automation_send_win_back_emails" instance="Ordo\Automation\Cron\SendWinBackEmails" method="execute">
            <schedule>0 9 * * *</schedule>
        </job>
        <job name="ordo_automation_escalate_stale_pending_approvals" instance="Ordo\Automation\Cron\EscalateStalePendingApprovals" method="execute">
            <schedule>0 10 * * *</schedule>
        </job>
        <job name="ordo_automation_send_sales_rep_digest" instance="Ordo\Automation\Cron\SendSalesRepDigest" method="execute">
            <schedule>0 8 * * 1</schedule>
        </job>
        <job name="ordo_automation_prune_visitor_events" instance="Ordo\Automation\Cron\PruneVisitorEvents" method="execute">
            <schedule>0 4 * * *</schedule>
        </job>
    </group>
</config>
