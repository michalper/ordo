<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/ordo/campaigns" method="GET">
        <service class="Ordo\Automation\Api\CampaignRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaigns/:entityId" method="GET">
        <service class="Ordo\Automation\Api\CampaignRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaigns" method="POST">
        <service class="Ordo\Automation\Api\CampaignRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaigns/:entityId" method="PUT">
        <service class="Ordo\Automation\Api\CampaignRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaigns/:entityId" method="DELETE">
        <service class="Ordo\Automation\Api\CampaignRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>

    <!-- Conditions/actions are flat resources filtered by campaign_id via searchCriteria
         (searchCriteria[filterGroups][0][filters][0][field]=campaign_id&...[value]=<id>),
         matching Magento's own SearchCriteria convention rather than a nested URL — the same
         pattern already used by, e.g., order items. -->
    <route url="/V1/ordo/campaign-conditions" method="GET">
        <service class="Ordo\Automation\Api\CampaignConditionRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaign-conditions/:entityId" method="GET">
        <service class="Ordo\Automation\Api\CampaignConditionRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaign-conditions" method="POST">
        <service class="Ordo\Automation\Api\CampaignConditionRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaign-conditions/:entityId" method="PUT">
        <service class="Ordo\Automation\Api\CampaignConditionRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaign-conditions/:entityId" method="DELETE">
        <service class="Ordo\Automation\Api\CampaignConditionRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>

    <route url="/V1/ordo/campaign-actions" method="GET">
        <service class="Ordo\Automation\Api\CampaignActionRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaign-actions/:entityId" method="GET">
        <service class="Ordo\Automation\Api\CampaignActionRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaign-actions" method="POST">
        <service class="Ordo\Automation\Api\CampaignActionRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaign-actions/:entityId" method="PUT">
        <service class="Ordo\Automation\Api\CampaignActionRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/campaign-actions/:entityId" method="DELETE">
        <service class="Ordo\Automation\Api\CampaignActionRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>

    <route url="/V1/ordo/offers" method="GET">
        <service class="Ordo\Automation\Api\OfferRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Ordo_Automation::config"/>
        </resources>
    </route>
    <route url="/V1/ordo/offers/:entityId" method="GET">
        <service class="Ordo\Automation\Api\OfferRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="Ordo_Automation::config"/>
        </resources>
    </route>
    <route url="/V1/ordo/offers" method="POST">
        <service class="Ordo\Automation\Api\OfferRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Ordo_Automation::config"/>
        </resources>
    </route>
    <route url="/V1/ordo/offers/:entityId" method="PUT">
        <service class="Ordo\Automation\Api\OfferRepositoryInterface" method="save"/>
        <resources>
            <resource ref="Ordo_Automation::config"/>
        </resources>
    </route>
    <route url="/V1/ordo/offers/:entityId" method="DELETE">
        <service class="Ordo\Automation\Api\OfferRepositoryInterface" method="deleteById"/>
        <resources>
            <resource ref="Ordo_Automation::config"/>
        </resources>
    </route>

    <!-- Read-only — reorder cycles are computed by Cron\CalculateReorderCycle, not writable via API. -->
    <route url="/V1/ordo/reorder-cycles" method="GET">
        <service class="Ordo\Automation\Api\ReorderCycleRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Ordo_Automation::config"/>
        </resources>
    </route>
    <route url="/V1/ordo/reorder-cycles/:entityId" method="GET">
        <service class="Ordo\Automation\Api\ReorderCycleRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="Ordo_Automation::config"/>
        </resources>
    </route>

    <!-- Customer tags — the segmentation primitive campaigns target ("send to everyone tagged
         'vip'"). Exposed so a headless storefront/CRM can manage tags without an admin session. -->
    <route url="/V1/ordo/customers/:customerId/tags" method="GET">
        <service class="Ordo\Automation\Api\CustomerTagManagementInterface" method="getTags"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/customers/:customerId/tags/:tag" method="PUT">
        <service class="Ordo\Automation\Api\CustomerTagManagementInterface" method="addTag"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/customers/:customerId/tags/:tag" method="DELETE">
        <service class="Ordo\Automation\Api\CustomerTagManagementInterface" method="removeTag"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/customers/:customerId/tags/:tag" method="GET">
        <service class="Ordo\Automation\Api\CustomerTagManagementInterface" method="hasTag"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>
    <route url="/V1/ordo/tags/:tag/customers" method="GET">
        <service class="Ordo\Automation\Api\CustomerTagManagementInterface" method="getCustomerIdsWithTag"/>
        <resources>
            <resource ref="Ordo_Automation::campaigns"/>
        </resources>
    </route>

    <!-- Read-only, admin-scoped — the token itself (used for the two anonymous decision routes
         below) is deliberately excluded from Data\OrderApprovalInterface's getters. -->
    <route url="/V1/ordo/order-approvals" method="GET">
        <service class="Ordo\Automation\Api\OrderApprovalRepositoryInterface" method="getList"/>
        <resources>
            <resource ref="Ordo_Automation::config"/>
        </resources>
    </route>
    <route url="/V1/ordo/order-approvals/:entityId" method="GET">
        <service class="Ordo\Automation\Api\OrderApprovalRepositoryInterface" method="getById"/>
        <resources>
            <resource ref="Ordo_Automation::config"/>
        </resources>
    </route>

    <!-- Anonymous by design, mirroring the email approve/reject links: possession of the
         one-time token is the credential, the same trust model as any "click to approve"
         email link. No admin login required — see OrderApprovalManagementInterface. -->
    <route url="/V1/ordo/order-approvals/:token/approve" method="POST">
        <service class="Ordo\Automation\Api\OrderApprovalManagementInterface" method="approveByToken"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/ordo/order-approvals/:token/reject" method="POST">
        <service class="Ordo\Automation\Api\OrderApprovalManagementInterface" method="rejectByToken"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <!-- Admin-only, unlike the two anonymous routes above — lets an authorized admin (e.g. a
         sales-rep mobile app) retrieve the decision links for a pending approval without
         needing the original email. The token itself is still never returned directly, only
         baked into these two URLs. -->
    <route url="/V1/ordo/order-approvals/:entityId/decision-links" method="GET">
        <service class="Ordo\Automation\Api\OrderApprovalManagementInterface" method="getDecisionLinksById"/>
        <resources>
            <resource ref="Ordo_Automation::config"/>
        </resources>
    </route>

    <!-- Customer self-service — any authenticated customer may call this; ownership of the
         specific offer is enforced inside OfferManagement::selfExtend() itself (a customer
         token only proves who's asking, not which offer is theirs). -->
    <route url="/V1/ordo/offers/:offerId/self-extend" method="POST">
        <service class="Ordo\Automation\Api\OfferManagementInterface" method="selfExtend"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
</routes>
