<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/queue.xsd">
    <broker topic="ordo.automation.campaign.dispatch" exchange="magento">
        <queue name="ordo.automation.campaign.dispatch" consumer="ordo.automation.campaign.dispatch"
               handler="Ordo\Automation\Model\Queue\CampaignDispatchConsumer::execute"/>
    </broker>
    <broker topic="ordo.automation.visitor.aggregate" exchange="magento">
        <queue name="ordo.automation.visitor.aggregate" consumer="ordo.automation.visitor.aggregate"
               handler="Ordo\Automation\Model\Queue\VisitorAggregationConsumer::execute"/>
    </broker>
</config>
