<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="customer_register_success">
        <observer name="ordo_automation_send_welcome_email" instance="Ordo\Automation\Observer\SendWelcomeEmail"/>
        <observer name="ordo_automation_dispatch_customer_registered_campaigns" instance="Ordo\Automation\Observer\DispatchCustomerRegisteredCampaigns"/>
        <observer name="ordo_automation_assign_lead_routing_rule" instance="Ordo\Automation\Observer\AssignLeadRoutingRule"/>
        <observer name="ordo_automation_redeem_referral_code" instance="Ordo\Automation\Observer\RedeemReferralCode"/>
    </event>
    <event name="sales_order_place_after">
        <observer name="ordo_automation_hold_order_for_approval" instance="Ordo\Automation\Observer\HoldOrderForApproval"/>
    </event>
    <!-- order_cancel_after is Magento core's own event (dispatched by
         \Magento\Sales\Model\Order::cancel()), not module-specific like ordo_customer_tag_added
         below - fires for every real cancellation path: the admin "Cancel" button, the REST/SOAP
         cancel API, and this module's own Model\OrderApprovalManagement::rejectByToken(). Unlike
         sales_order_place_after, a canceled order is always already persisted, so there's no
         unpopulated-entity_id trap to avoid here. -->
    <event name="order_cancel_after">
        <observer name="ordo_automation_dispatch_order_canceled_campaigns" instance="Ordo\Automation\Observer\DispatchOrderCanceledCampaigns"/>
    </event>
    <!-- RecordTriggerOutcome/RecordCampaignOutcome/DispatchOrderPlacedCampaigns/
         DispatchReferralConvertedCampaigns are all on sales_order_save_after, NOT
         sales_order_place_after - see each class's own docblock for why:
         \Magento\Sales\Model\Order::place() (which sales_order_place_after fires from) always
         runs BEFORE \Magento\Sales\Model\ResourceModel\Order::save() persists the order, for
         every normal (non-reorder) checkout - a fresh order's own entity_id is genuinely
         unpopulated at sales_order_place_after time, confirmed via
         Magento\Quote\Model\QuoteManagement::submitQuote()'s own real code (entity_id is only
         ever set early for a reorder, from the quote's own origOrderId). RecordTriggerOutcome/
         RecordCampaignOutcome need a real entity_id to record a conversion against, so
         sales_order_place_after silently no-ops them for every real order, every time - a real,
         previously-undiscovered bug this session's own
         AdminCampaignFunnelReflectsRealSendAndConversionTest caught. DispatchOrderPlacedCampaigns/
         DispatchReferralConvertedCampaigns moved here for the SAME reason, discovered later: both
         publish 'order_id' into the dispatch context (CampaignOutcomeLogger::logSent()'s own
         $triggerOrderId, meant to stop a send from crediting itself as its own conversion) by
         reading $order->getEntityId() while it was still null at sales_order_place_after time -
         (int) null silently became 0, a value that's never a real order id, so the self-exclusion
         it was meant to drive never actually matched anything. HoldOrderForApproval alone stays
         on sales_order_place_after - it mutates the order's own status before persistence, which
         is the entire point of that observer running at that exact moment. -->
    <event name="sales_order_save_after">
        <observer name="ordo_automation_record_trigger_outcome" instance="Ordo\Automation\Observer\RecordTriggerOutcome"/>
        <observer name="ordo_automation_record_campaign_outcome" instance="Ordo\Automation\Observer\RecordCampaignOutcome"/>
        <observer name="ordo_automation_dispatch_order_placed_campaigns" instance="Ordo\Automation\Observer\DispatchOrderPlacedCampaigns"/>
        <observer name="ordo_automation_dispatch_referral_converted_campaigns" instance="Ordo\Automation\Observer\DispatchReferralConvertedCampaigns"/>
    </event>
    <event name="ordo_customer_tag_added">
        <observer name="ordo_automation_dispatch_tag_added_campaigns" instance="Ordo\Automation\Observer\DispatchTagAddedCampaigns"/>
    </event>
    <event name="ordo_visitor_tag_added">
        <observer name="ordo_automation_dispatch_visitor_tag_added_campaigns" instance="Ordo\Automation\Observer\DispatchVisitorTagAddedCampaigns"/>
    </event>
    <event name="customer_login">
        <observer name="ordo_automation_stitch_visitor_identity" instance="Ordo\Automation\Observer\StitchVisitorIdentity"/>
    </event>
    <event name="sales_quote_collect_totals_after">
        <observer name="ordo_automation_trim_excess_free_gifts" instance="Ordo\Automation\Observer\TrimExcessFreeGifts"/>
    </event>
    <event name="customer_save_after">
        <observer name="ordo_automation_evaluate_customer_score_rules" instance="Ordo\Automation\Observer\EvaluateCustomerScoreRules"/>
    </event>
    <event name="ordo_customer_score_threshold_crossed">
        <observer name="ordo_automation_dispatch_score_threshold_campaigns" instance="Ordo\Automation\Observer\DispatchScoreThresholdCampaigns"/>
        <observer name="ordo_automation_assign_lead_routing_rule_on_score_threshold" instance="Ordo\Automation\Observer\AssignLeadRoutingRule"/>
    </event>
    <event name="checkout_cart_product_add_after">
        <observer name="ordo_automation_track_cart_add" instance="Ordo\Automation\Observer\TrackCartAdd"/>
    </event>
    <event name="wishlist_product_add_after">
        <observer name="ordo_automation_track_wishlist_add" instance="Ordo\Automation\Observer\TrackWishlistAdd"/>
    </event>
</config>
