<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ordo\Automation\Api\Data\OfferInterface" type="Ordo\Automation\Model\Offer"/>
    <preference for="Ordo\Automation\Api\OfferRepositoryInterface" type="Ordo\Automation\Model\OfferRepository"/>
    <preference for="Ordo\Automation\Api\Data\CampaignInterface" type="Ordo\Automation\Model\Campaign"/>
    <preference for="Ordo\Automation\Api\CampaignRepositoryInterface" type="Ordo\Automation\Model\CampaignRepository"/>
    <preference for="Ordo\Automation\Api\Data\ReorderCycleInterface" type="Ordo\Automation\Model\ReorderCycle"/>
    <preference for="Ordo\Automation\Api\ReorderCycleRepositoryInterface" type="Ordo\Automation\Model\ReorderCycleRepository"/>
    <preference for="Ordo\Automation\Api\CustomerTagManagementInterface" type="Ordo\Automation\Model\CustomerTagManager"/>
    <preference for="Ordo\Automation\Api\Data\OrderApprovalInterface" type="Ordo\Automation\Model\OrderApproval"/>
    <preference for="Ordo\Automation\Api\OrderApprovalRepositoryInterface" type="Ordo\Automation\Model\OrderApprovalRepository"/>
    <preference for="Ordo\Automation\Api\OrderApprovalManagementInterface" type="Ordo\Automation\Model\OrderApprovalManagement"/>
    <preference for="Ordo\Automation\Api\Data\OrderApprovalDecisionLinksInterface" type="Ordo\Automation\Model\OrderApprovalDecisionLinks"/>
    <preference for="Ordo\Automation\Api\OfferManagementInterface" type="Ordo\Automation\Model\OfferManagement"/>
    <preference for="Ordo\Automation\Api\Data\CampaignConditionInterface" type="Ordo\Automation\Model\CampaignCondition"/>
    <preference for="Ordo\Automation\Api\CampaignConditionRepositoryInterface" type="Ordo\Automation\Model\CampaignConditionRepository"/>
    <preference for="Ordo\Automation\Api\Data\CampaignActionInterface" type="Ordo\Automation\Model\CampaignAction"/>
    <preference for="Ordo\Automation\Api\CampaignActionRepositoryInterface" type="Ordo\Automation\Model\CampaignActionRepository"/>
    <preference for="Ordo\Automation\Api\Data\CampaignTriggerInterface" type="Ordo\Automation\Model\CampaignTrigger"/>
    <preference for="Ordo\Automation\Api\CampaignTriggerRepositoryInterface" type="Ordo\Automation\Model\CampaignTriggerRepository"/>
    <preference for="Ordo\Automation\Api\Data\FreeGiftOfferInterface" type="Ordo\Automation\Model\FreeGiftOffer"/>
    <preference for="Ordo\Automation\Api\FreeGiftOfferRepositoryInterface" type="Ordo\Automation\Model\FreeGiftOfferRepository"/>
    <preference for="Ordo\Automation\Api\Data\FreeGiftOfferTierInterface" type="Ordo\Automation\Model\FreeGiftOfferTier"/>
    <preference for="Ordo\Automation\Api\FreeGiftOfferTierRepositoryInterface" type="Ordo\Automation\Model\FreeGiftOfferTierRepository"/>
    <preference for="Ordo\Automation\Api\Data\FreeGiftOfferProductInterface" type="Ordo\Automation\Model\FreeGiftOfferProduct"/>
    <preference for="Ordo\Automation\Api\FreeGiftOfferProductRepositoryInterface" type="Ordo\Automation\Model\FreeGiftOfferProductRepository"/>
    <preference for="Ordo\Automation\Api\Data\FreeGiftEligibilityInterface" type="Ordo\Automation\Model\FreeGiftEligibility"/>
    <preference for="Ordo\Automation\Api\Data\FreeGiftSelectionInterface" type="Ordo\Automation\Model\FreeGiftSelection"/>
    <preference for="Ordo\Automation\Api\FreeGiftManagementInterface" type="Ordo\Automation\Model\FreeGiftManagement"/>
    <preference for="Ordo\Automation\Api\Data\CreditLimitStatusInterface" type="Ordo\Automation\Model\CreditLimitStatus"/>
    <preference for="Ordo\Automation\Api\CreditLimitManagementInterface" type="Ordo\Automation\Model\CreditLimitManagement"/>
    <preference for="Ordo\Automation\Model\Sms\SmsSenderInterface" type="Ordo\Automation\Model\Sms\TwilioSmsSender"/>

    <!-- Dedicated SearchResults types so the WebAPI output processor knows what's inside each
         list endpoint's "items" array (the generic SearchResultsInterface can't express this —
         see Api/Data/CampaignSearchResultsInterface.php for why). Bound to a trivial concrete
         subclass per entity (Model/*/SearchResults.php), not the generic SearchResults class
         directly — PHP's return-type covariance requires the actual object to implement the
         narrower interface, matching Magento core's own pattern
         (Magento\Catalog\Model\ProductSearchResults). -->
    <preference for="Ordo\Automation\Api\Data\CampaignSearchResultsInterface" type="Ordo\Automation\Model\Campaign\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\OfferSearchResultsInterface" type="Ordo\Automation\Model\Offer\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\ReorderCycleSearchResultsInterface" type="Ordo\Automation\Model\ReorderCycle\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\OrderApprovalSearchResultsInterface" type="Ordo\Automation\Model\OrderApproval\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\CampaignConditionSearchResultsInterface" type="Ordo\Automation\Model\Campaign\Condition\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\CampaignActionSearchResultsInterface" type="Ordo\Automation\Model\Campaign\Action\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\CampaignTriggerSearchResultsInterface" type="Ordo\Automation\Model\Campaign\Trigger\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\FreeGiftOfferSearchResultsInterface" type="Ordo\Automation\Model\FreeGiftOffer\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\FreeGiftOfferTierSearchResultsInterface" type="Ordo\Automation\Model\FreeGiftOfferTier\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\FreeGiftOfferProductSearchResultsInterface" type="Ordo\Automation\Model\FreeGiftOfferProduct\SearchResults"/>

    <!-- Admin grid data sources — one entry per listing UI component. -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="ordo_campaign_listing_data_source" xsi:type="string">Ordo\Automation\Model\ResourceModel\Campaign\Grid\Collection</item>
                <item name="ordo_reorder_cycle_listing_data_source" xsi:type="string">Ordo\Automation\Model\ResourceModel\ReorderCycle\Grid\Collection</item>
                <item name="ordo_free_gift_offer_listing_data_source" xsi:type="string">Ordo\Automation\Model\ResourceModel\FreeGiftOffer\Grid\Collection</item>
                <item name="ordo_segment_listing_data_source" xsi:type="string">Ordo\Automation\Model\ResourceModel\Segment\Grid\Collection</item>
                <item name="ordo_rfm_listing_data_source" xsi:type="string">Ordo\Automation\Model\ResourceModel\Rfm\Grid\Collection</item>
                <item name="ordo_scorerule_listing_data_source" xsi:type="string">Ordo\Automation\Model\ResourceModel\ScoreRule\Grid\Collection</item>
                <item name="ordo_contentblock_listing_data_source" xsi:type="string">Ordo\Automation\Model\ResourceModel\ContentBlock\Grid\Collection</item>
                <item name="ordo_messagelog_listing_data_source" xsi:type="string">Ordo\Automation\Model\ResourceModel\MessageLog\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <type name="Ordo\Automation\Model\ResourceModel\MessageLog\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ordo_message_log</argument>
            <argument name="resourceModel" xsi:type="string">Ordo\Automation\Model\ResourceModel\MessageLog</argument>
        </arguments>
    </type>

    <type name="Ordo\Automation\Model\ResourceModel\ScoreRule\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ordo_score_rule</argument>
            <argument name="resourceModel" xsi:type="string">Ordo\Automation\Model\ResourceModel\ScoreRule</argument>
        </arguments>
    </type>

    <type name="Ordo\Automation\Model\ResourceModel\ContentBlock\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ordo_content_block</argument>
            <argument name="resourceModel" xsi:type="string">Ordo\Automation\Model\ResourceModel\ContentBlock</argument>
        </arguments>
    </type>

    <type name="Ordo\Automation\Model\ResourceModel\Segment\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ordo_segment</argument>
            <argument name="resourceModel" xsi:type="string">Ordo\Automation\Model\ResourceModel\Segment</argument>
        </arguments>
    </type>

    <!--
        The RFM report grid has no entity table of its own — it reports over customer_entity,
        with no Ordo resource model, so identifierName is given explicitly rather than being
        derived from a resource model's getIdFieldName().
    -->
    <type name="Ordo\Automation\Model\ResourceModel\Rfm\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">customer_entity</argument>
            <argument name="identifierName" xsi:type="string">entity_id</argument>
        </arguments>
    </type>

    <!--
        SearchResult-based grid collections take their table/resource model via constructor
        arguments, not via _init() — same wiring pattern Magento core uses for e.g. the sales
        order grid collection.
    -->
    <type name="Ordo\Automation\Model\ResourceModel\Campaign\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ordo_campaign</argument>
            <argument name="resourceModel" xsi:type="string">Ordo\Automation\Model\ResourceModel\Campaign</argument>
        </arguments>
    </type>

    <type name="Ordo\Automation\Model\ResourceModel\ReorderCycle\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ordo_reorder_cycle</argument>
            <argument name="resourceModel" xsi:type="string">Ordo\Automation\Model\ResourceModel\ReorderCycle</argument>
        </arguments>
    </type>

    <type name="Ordo\Automation\Model\ResourceModel\FreeGiftOffer\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ordo_free_gift_offer</argument>
            <argument name="resourceModel" xsi:type="string">Ordo\Automation\Model\ResourceModel\FreeGiftOffer</argument>
        </arguments>
    </type>

    <!--
        Campaign engine plug-in registry. Adding a new condition or action type never means
        touching CampaignDispatcher — just a new class implementing ConditionInterface /
        ActionInterface, and one line here.
    -->
    <type name="Ordo\Automation\Model\Campaign\ConditionPool">
        <arguments>
            <argument name="conditions" xsi:type="array">
                <item name="tag" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\HasTag</item>
                <item name="order_total_gte" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\OrderTotalAtLeast</item>
                <item name="visitor_tag" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\VisitorHasTag</item>
                <item name="score_at_least" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\ScoreAtLeast</item>
                <item name="recency_days_at_most" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\RecencyDaysAtMost</item>
                <item name="order_frequency_at_least" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\OrderFrequencyAtLeast</item>
                <item name="monetary_total_at_least" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\MonetaryTotalAtLeast</item>
                <item name="recency_percentile_at_least" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\RecencyPercentileAtLeast</item>
                <item name="order_frequency_percentile_at_least" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\OrderFrequencyPercentileAtLeast</item>
                <item name="monetary_percentile_at_least" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\MonetaryPercentileAtLeast</item>
                <item name="in_segment" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\InSegment</item>
            </argument>
        </arguments>
    </type>

    <!--
        ConditionPool -> InSegment -> SegmentMatcher -> ConditionPool would otherwise be a
        genuine constructor cycle (ConditionPool's array argument instantiates every condition,
        including InSegment, eagerly at construction time). Breaking it with a Proxy here means
        SegmentMatcher gets a lazy stand-in that only actually builds the real ConditionPool the
        first time isCustomerInSegment() calls ->get(), by which point ConditionPool itself has
        already finished constructing.
    -->
    <type name="Ordo\Automation\Model\Segment\SegmentMatcher">
        <arguments>
            <argument name="conditionPool" xsi:type="object">Ordo\Automation\Model\Campaign\ConditionPool\Proxy</argument>
        </arguments>
    </type>

    <type name="Ordo\Automation\Model\Campaign\ActionPool">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="add_tag" xsi:type="object">Ordo\Automation\Model\Campaign\Action\AddTag</item>
                <item name="send_email" xsi:type="object">Ordo\Automation\Model\Campaign\Action\SendEmail</item>
                <item name="generate_coupon" xsi:type="object">Ordo\Automation\Model\Campaign\Action\GenerateCoupon</item>
                <item name="popup" xsi:type="object">Ordo\Automation\Model\Campaign\Action\ShowPopup</item>
                <item name="add_points" xsi:type="object">Ordo\Automation\Model\Campaign\Action\AddPoints</item>
                <item name="add_product_recommendations" xsi:type="object">Ordo\Automation\Model\Campaign\Action\AddProductRecommendations</item>
                <item name="add_dynamic_content" xsi:type="object">Ordo\Automation\Model\Campaign\Action\AddDynamicContent</item>
                <item name="send_sms" xsi:type="object">Ordo\Automation\Model\Campaign\Action\SendSms</item>
            </argument>
        </arguments>
    </type>

    <!--
        Content block producer registry — same shape as ActionPool above. Adding a new content
        block type never means touching AddDynamicContent — just a new class implementing
        Model\ContentBlock\Producer\ProducerInterface, and one line here.
    -->
    <type name="Ordo\Automation\Model\ContentBlock\ProducerPool">
        <arguments>
            <argument name="producers" xsi:type="array">
                <item name="snippet" xsi:type="object">Ordo\Automation\Model\ContentBlock\Producer\SnippetProducer</item>
                <item name="rss" xsi:type="object">Ordo\Automation\Model\ContentBlock\Producer\RssProducer</item>
                <item name="product_feed" xsi:type="object">Ordo\Automation\Model\ContentBlock\Producer\ProductFeedProducer</item>
            </argument>
        </arguments>
    </type>

    <!--
        Registers "ordo_cheapest_item_free" as a possible cart price rule simple_action.
        The real extension point in Magento 2.4.x is CalculatorFactory's "discountRules"
        argument (a flat map of simple_action value => calculator class) — NOT
        Magento\SalesRule\Model\Validator's "calculators" argument, which doesn't exist on
        that class in this version and was silently ignored (no error, the calculator was
        just never registered; found by actually running a rule with this simple_action
        against a real quote — "ordo_cheapest_item_free is unknown type"). Array arguments
        merge across modules' di.xml by item key, so this adds to — never replaces —
        whatever other calculators are already registered.
        See Model\Rule\Action\Discount\CheapestItemFree for the known admin-UI limitation.
    -->
    <!--
        Hard-blocks checkout at the actual submit path (CartManagementInterface::placeOrder,
        the interface QuoteManagement implements) rather than reacting after the order is
        already persisted — see Plugin\Quote\BlockOverLimitCheckout for why this needed to be
        a before-plugin on the interface instead of an observer like HoldOrderForApproval.
    -->
    <type name="Magento\Quote\Api\CartManagementInterface">
        <plugin name="ordo_automation_block_over_limit_checkout" type="Ordo\Automation\Plugin\Quote\BlockOverLimitCheckout" sortOrder="10"/>
    </type>

    <type name="Magento\SalesRule\Model\Rule\Action\Discount\CalculatorFactory">
        <arguments>
            <argument name="discountRules" xsi:type="array">
                <item name="ordo_cheapest_item_free" xsi:type="string">Ordo\Automation\Model\Rule\Action\Discount\CheapestItemFree</item>
            </argument>
        </arguments>
    </type>
</config>
