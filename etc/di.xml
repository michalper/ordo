<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Ordo\Automation\Api\Data\OfferInterface" type="Ordo\Automation\Model\Offer"/>
    <preference for="Ordo\Automation\Api\OfferRepositoryInterface" type="Ordo\Automation\Model\OfferRepository"/>
    <preference for="Ordo\Automation\Api\Data\CampaignInterface" type="Ordo\Automation\Model\Campaign"/>
    <preference for="Ordo\Automation\Api\CampaignRepositoryInterface" type="Ordo\Automation\Model\CampaignRepository"/>
    <preference for="Ordo\Automation\Api\Data\ReorderCycleInterface" type="Ordo\Automation\Model\ReorderCycle"/>
    <preference for="Ordo\Automation\Api\ReorderCycleRepositoryInterface" type="Ordo\Automation\Model\ReorderCycleRepository"/>
    <preference for="Ordo\Automation\Api\CustomerTagManagementInterface" type="Ordo\Automation\Model\CustomerTagManager"/>
    <preference for="Ordo\Automation\Api\Data\OrderApprovalInterface" type="Ordo\Automation\Model\OrderApproval"/>
    <preference for="Ordo\Automation\Api\OrderApprovalRepositoryInterface" type="Ordo\Automation\Model\OrderApprovalRepository"/>
    <preference for="Ordo\Automation\Api\OrderApprovalManagementInterface" type="Ordo\Automation\Model\OrderApprovalManagement"/>
    <preference for="Ordo\Automation\Api\OfferManagementInterface" type="Ordo\Automation\Model\OfferManagement"/>

    <!-- Dedicated SearchResults types so the WebAPI output processor knows what's inside each
         list endpoint's "items" array (the generic SearchResultsInterface can't express this —
         see Api/Data/CampaignSearchResultsInterface.php for why). Bound to a trivial concrete
         subclass per entity (Model/*/SearchResults.php), not the generic SearchResults class
         directly — PHP's return-type covariance requires the actual object to implement the
         narrower interface, matching Magento core's own pattern
         (Magento\Catalog\Model\ProductSearchResults). -->
    <preference for="Ordo\Automation\Api\Data\CampaignSearchResultsInterface" type="Ordo\Automation\Model\Campaign\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\OfferSearchResultsInterface" type="Ordo\Automation\Model\Offer\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\ReorderCycleSearchResultsInterface" type="Ordo\Automation\Model\ReorderCycle\SearchResults"/>
    <preference for="Ordo\Automation\Api\Data\OrderApprovalSearchResultsInterface" type="Ordo\Automation\Model\OrderApproval\SearchResults"/>

    <!-- Admin grid data sources — one entry per listing UI component. -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="ordo_campaign_listing_data_source" xsi:type="string">Ordo\Automation\Model\ResourceModel\Campaign\Grid\Collection</item>
                <item name="ordo_reorder_cycle_listing_data_source" xsi:type="string">Ordo\Automation\Model\ResourceModel\ReorderCycle\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <!--
        SearchResult-based grid collections take their table/resource model via constructor
        arguments, not via _init() — same wiring pattern Magento core uses for e.g. the sales
        order grid collection.
    -->
    <type name="Ordo\Automation\Model\ResourceModel\Campaign\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ordo_campaign</argument>
            <argument name="resourceModel" xsi:type="string">Ordo\Automation\Model\ResourceModel\Campaign</argument>
        </arguments>
    </type>

    <type name="Ordo\Automation\Model\ResourceModel\ReorderCycle\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">ordo_reorder_cycle</argument>
            <argument name="resourceModel" xsi:type="string">Ordo\Automation\Model\ResourceModel\ReorderCycle</argument>
        </arguments>
    </type>

    <!--
        Campaign engine plug-in registry. Adding a new condition or action type never means
        touching CampaignDispatcher — just a new class implementing ConditionInterface /
        ActionInterface, and one line here.
    -->
    <type name="Ordo\Automation\Model\Campaign\ConditionPool">
        <arguments>
            <argument name="conditions" xsi:type="array">
                <item name="tag" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\HasTag</item>
                <item name="order_total_gte" xsi:type="object">Ordo\Automation\Model\Campaign\Condition\OrderTotalAtLeast</item>
            </argument>
        </arguments>
    </type>

    <type name="Ordo\Automation\Model\Campaign\ActionPool">
        <arguments>
            <argument name="actions" xsi:type="array">
                <item name="add_tag" xsi:type="object">Ordo\Automation\Model\Campaign\Action\AddTag</item>
                <item name="send_email" xsi:type="object">Ordo\Automation\Model\Campaign\Action\SendEmail</item>
                <item name="generate_coupon" xsi:type="object">Ordo\Automation\Model\Campaign\Action\GenerateCoupon</item>
            </argument>
        </arguments>
    </type>

    <!--
        Registers "ordo_cheapest_item_free" as a possible cart price rule simple_action.
        The real extension point in Magento 2.4.x is CalculatorFactory's "discountRules"
        argument (a flat map of simple_action value => calculator class) — NOT
        Magento\SalesRule\Model\Validator's "calculators" argument, which doesn't exist on
        that class in this version and was silently ignored (no error, the calculator was
        just never registered; found by actually running a rule with this simple_action
        against a real quote — "ordo_cheapest_item_free is unknown type"). Array arguments
        merge across modules' di.xml by item key, so this adds to — never replaces —
        whatever other calculators are already registered.
        See Model\Rule\Action\Discount\CheapestItemFree for the known admin-UI limitation.
    -->
    <type name="Magento\SalesRule\Model\Rule\Action\Discount\CalculatorFactory">
        <arguments>
            <argument name="discountRules" xsi:type="array">
                <item name="ordo_cheapest_item_free" xsi:type="string">Ordo\Automation\Model\Rule\Action\Discount\CheapestItemFree</item>
            </argument>
        </arguments>
    </type>
</config>
