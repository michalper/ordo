<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminPrunePendingPopupsTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="On-site behavior tracking"/>
            <title value="Cron\PrunePendingPopups deletes a real, already-delivered popup past its grace window"/>
            <description value="Closes the first of §7's two prune-cron gaps in SCENARIOS.md. Same real campaign+order+consumer+poll flow as AdminCampaignPopupActionTest, up through the popup banner actually rendering (delivered_at genuinely set by Controller/Track/Popup's claim-on-poll) - then PendingPopupTestHelper backdates delivered_at past the 24-hour grace window (Cron\PrunePendingPopups::DELIVERED_GRACE_HOURS, no config knob for this one) and CronScheduleHelper forces the cron to run now instead of waiting out its real 04:00 daily schedule. Asserts the row is genuinely gone, not just that the cron didn't throw."/>
            <severity value="MAJOR"/>
            <group value="ordo_automation"/>
            <group value="segment"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the campaign - trigger=order_placed, no condition, action=popup. Same shape
             as AdminCampaignPopupActionTest, minus the CTA fields this test doesn't need to
             assert on. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Prune Pending Popups Campaign" stepKey="fillName"/>

        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'action', type: 'popup', fields: {headline: 'Prune Test Popup Headline', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraph"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>

        <!-- Step 2: a REAL order, through REAL storefront checkout. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\QueueConsumerHelper" method="drainQueueWithRetry" stepKey="runCampaignDispatchConsumer">
            <argument name="topic">ordo.automation.campaign.dispatch</argument>
        </helper>

        <!-- Step 3: stay on the checkout success page - its own tracker.js poll loop claims the
             popup (sets delivered_at) within its first couple of ticks, same reasoning as
             AdminCampaignPopupActionTest's own identical wait. -->
        <waitForElementVisible selector="#ordo-popup-banner" time="90" stepKey="waitForPopupBanner"/>
        <see selector="#ordo-popup-banner" userInput="Prune Test Popup Headline" stepKey="seePopupHeadline"/>

        <!-- Step 4: backdate the now-delivered row past the 24h grace window, then force
             PrunePendingPopups to run now (real schedule 04:00 daily, see etc/crontab.xml). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\PendingPopupTestHelper" method="backdateDeliveredPopupForCustomer" stepKey="backdateDeliveredPopup">
            <argument name="customerId">$createCustomer.id$</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="schedulePrunePendingPopupsJob">
            <argument name="jobCode">ordo_automation_prune_pending_popups</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runPrunePendingPopupsCron"/>

        <!-- Step 5: the real, database-observable negative only a genuine deletion could have
             produced. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\PendingPopupTestHelper" method="assertNoPendingPopupForCustomer" stepKey="assertPopupPrunedAfterCron">
            <argument name="customerId">$createCustomer.id$</argument>
        </helper>
    </test>
</tests>
