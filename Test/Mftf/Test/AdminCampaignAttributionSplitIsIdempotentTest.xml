<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminCampaignAttributionSplitIsIdempotentTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign performance analytics"/>
            <title value="Cron\ComputeCampaignAttribution credits a real campaign click-through with a real order's revenue, and re-running it never doubles the credited amount"/>
            <description value="Closes SCENARIOS.md #29's last open row: Model\Campaign\AttributionCalculator's own docblock claims recomputation is idempotent (existing ordo_campaign_attribution rows for an order are deleted and reinserted every run, never accumulated) - this is the only MFTF proof of that claim. Order #1's own real order_placed dispatch writes a real ordo_message_log row for this campaign (Model\Sms\MessageLogWriter::recordSent()'s free side effect, same as the sibling funnel test) - CampaignClickTestHelper then records a real 'clicked' ordo_message_log_event against that exact row (the only MFTF-reachable path, since real clicks arrive only via Controller\Email\StatusCallback's signed SendGrid webhook, which this environment has no account/key to produce - same reasoning MessageLogTestHelper already documents for ordo_message_log itself). Order #2 is then the order this single campaign touch gets full credit for (touch_count=1, so attributed_revenue = order #2's own grand_total) - the click landed between order #1 and order #2, so it's before order #2's created_at and inside order #2's own attribution window (Helper\Config::getAttributionWindowDays(), default 14) but not before order #1's, matching AttributionCalculator's own real 'clicked before THIS order' per-order query, not a blanket 'customer clicked at some point' check. The Campaign grid's own real 'Attributed revenue' column (Ui\Component\Listing\Column\CampaignAttributedRevenue) is read via AdminDataGridTableSection's rowTemplate - the same 'locate by unique row text, not row 1 or a keyword-search filter' idiom AdminRfmReportGridReflectsRealDataTest already established, since other campaigns can exist in this shared CI job's DB regardless. The cron is then forced to run a SECOND time (CronScheduleHelper::scheduleJobNow(), the same forcing technique the sibling trigger-response test already uses) with no new order/click in between - the grid row's own text is captured both times and asserted equal, proving the second run's delete-then-reinsert left the exact same single row/value behind rather than a doubled one."/>
            <severity value="MAJOR"/>
            <group value="ordo_automation"/>
            <group value="dashboard"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the campaign - trigger=order_placed, action=send_email. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Attribution Test Campaign" stepKey="fillName"/>
        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'action', type: 'send_email', fields: {template: 'ordo_campaign_generic', message: 'Attribution test campaign message.', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraph"/>
        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>
        <grabFromCurrentUrl regex="/entity_id\/(\d+)/" stepKey="grabCampaignId"/>

        <!-- Step 2: order #1 - dispatch runs send_email inline, writing a real ordo_message_log
             row for this campaign+customer (MessageLogWriter::recordSent()'s own free side
             effect, same as the sibling funnel test). -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPageFirstOrder"/>
        <waitForPageLoad stepKey="waitForProductPageFirstOrder"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCartFirstOrder">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCartFirstOrder"/>
        <waitForPageLoad stepKey="waitForCartPageFirstOrder"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeFirstOrder"/>
        <wait time="2" stepKey="waitForFirstDispatchMessageVisible"/>
        <magentoCLI command="queue:consumers:start ordo.automation.campaign.dispatch --max-messages=50" stepKey="runCampaignDispatchConsumer"/>

        <!-- Step 3: the real click - the only MFTF-reachable path to a real
             ordo_message_log_event 'clicked' row (see this test's own description). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CampaignClickTestHelper" method="recordClickForCampaign" stepKey="recordClick">
            <argument name="toAddress">$createCustomer.email$</argument>
            <argument name="campaignId">{$grabCampaignId}</argument>
        </helper>

        <!-- Step 4: order #2 - the real, distinct order this single campaign touch gets full
             attribution credit for (touch_count=1, so attributed_revenue = this order's own
             grand_total). -->
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPageSecondOrder"/>
        <waitForPageLoad stepKey="waitForProductPageSecondOrder"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCartSecondOrder">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCartSecondOrder"/>
        <waitForPageLoad stepKey="waitForCartPageSecondOrder"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeSecondOrder"/>
        <wait time="2" stepKey="waitForSecondDispatchMessageVisible"/>
        <magentoCLI command="queue:consumers:start ordo.automation.campaign.dispatch --max-messages=50" stepKey="runCampaignDispatchConsumerAgain"/>

        <!-- Step 5: force Cron\ComputeCampaignAttribution to run now (real schedule is hourly -
             see etc/crontab.xml), then confirm the Campaign grid's real "Attributed revenue"
             column reflects order #2's real grand_total for this campaign - located by the
             campaign's own unique name, not row 1 or a keyword-search filter, since other
             campaigns can exist in this shared CI job's DB regardless (same idiom
             AdminRfmReportGridReflectsRealDataTest's own dontSeeZeroMonetaryInGrid already
             uses). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleComputeAttributionJobFirstRun">
            <argument name="jobCode">ordo_automation_compute_campaign_attribution</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runComputeAttributionCronFirstRun"/>
        <amOnPage url="admin/ordo/campaign/index" stepKey="goToCampaignGridFirstCheck"/>
        <waitForPageLoad stepKey="waitForGridFirstCheck"/>
        <waitForElementVisible selector="{{AdminDataGridTableSection.rowTemplate('Attribution Test Campaign')}}" stepKey="waitForCampaignRowFirstCheck"/>
        <dontSee selector="{{AdminDataGridTableSection.rowTemplate('Attribution Test Campaign')}}" userInput="0.00" stepKey="dontSeeZeroAttributedRevenue"/>
        <grabTextFrom selector="{{AdminDataGridTableSection.rowTemplate('Attribution Test Campaign')}}" stepKey="grabRowAfterFirstRun"/>

        <!-- Step 6: re-run the SAME cron with no new order/click in between - the row's own text
             (including the attributed-revenue cell) must be byte-identical, proving the second
             run's delete-then-reinsert left the same single row/value behind rather than a
             doubled one. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleComputeAttributionJobSecondRun">
            <argument name="jobCode">ordo_automation_compute_campaign_attribution</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runComputeAttributionCronSecondRun"/>
        <amOnPage url="admin/ordo/campaign/index" stepKey="goToCampaignGridSecondCheck"/>
        <waitForPageLoad stepKey="waitForGridSecondCheck"/>
        <waitForElementVisible selector="{{AdminDataGridTableSection.rowTemplate('Attribution Test Campaign')}}" stepKey="waitForCampaignRowSecondCheck"/>
        <grabTextFrom selector="{{AdminDataGridTableSection.rowTemplate('Attribution Test Campaign')}}" stepKey="grabRowAfterSecondRun"/>
        <assertEquals stepKey="assertRowUnchangedAfterSecondRun">
            <expectedResult type="string">{$grabRowAfterFirstRun}</expectedResult>
            <actualResult type="string">{$grabRowAfterSecondRun}</actualResult>
        </assertEquals>

        <actionGroup ref="AdminDeleteOrdoEntityByFormPostActionGroup" stepKey="deleteCampaign">
            <argument name="url" value="admin/ordo/campaign/delete/entity_id/{$grabCampaignId}"/>
            <argument name="successMessage" value="The campaign has been deleted."/>
        </actionGroup>
    </test>
</tests>
