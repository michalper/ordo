<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminPruneNotificationsTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="On-site behavior tracking"/>
            <title value="Cron\PruneNotifications deletes a real, already-read notification past its grace window"/>
            <description value="Closes SCENARIOS.md's PruneNotifications gap. Same real campaign+order+consumer+poll+dismiss flow as AdminCampaignNotifyActionTest, up through the notification actually being dismissed (read_at genuinely set by Controller/Track/DismissNotification's own logic) - then NotificationTestHelper backdates read_at past the 24-hour grace window (Cron\PruneNotifications::READ_GRACE_HOURS, no config knob for this one) and CronScheduleHelper forces the cron to run now instead of waiting out its real 04:35 daily schedule. Asserts the row is genuinely gone, not just that the cron didn't throw."/>
            <severity value="MAJOR"/>
            <group value="ordo_automation"/>
            <group value="segment"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the campaign - trigger=order_placed, no condition, action=notify. Same
             shape as AdminCampaignNotifyActionTest, minus the CTA fields this test doesn't need
             to assert on. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Prune Notifications Campaign" stepKey="fillName"/>

        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'action', type: 'notify', fields: {params_json: '{&quot;headline&quot;: &quot;Prune Test Notification Headline&quot;}', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraph"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>

        <!-- Step 2: a REAL order, through REAL storefront checkout. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\QueueConsumerHelper" method="drainQueueWithRetry" stepKey="runCampaignDispatchConsumer">
            <argument name="topic">ordo.automation.campaign.dispatch</argument>
        </helper>

        <!-- Step 3: stay on the checkout success page - its own tracker.js poll loop renders the
             notification within its first couple of ticks, then dismiss it for real (the only
             client action that sets read_at). -->
        <waitForElementVisible selector="#ordo-notification-list" time="90" stepKey="waitForNotificationList"/>
        <see selector="#ordo-notification-list" userInput="Prune Test Notification Headline" stepKey="seeNotificationHeadline"/>
        <click selector="#ordo-notification-list button[aria-label='Dismiss']" stepKey="clickDismissButton"/>
        <dontSeeElement selector="#ordo-notification-list div[id^='ordo-notification-']" stepKey="dontSeeNotificationAfterDismiss"/>

        <!-- The dismiss click's own POST is deliberately fire-and-forget (tracker.js removes the
             element from the DOM immediately, keepalive:true, never awaited) - dontSeeElement
             above only proves the CLIENT side, not that the server has actually written read_at
             yet. A short settle wait closes that race before the next step reads the DB directly. -->
        <wait time="2" stepKey="waitForDismissPostToLand"/>

        <!-- Step 4: backdate the now-read row past the 24h grace window, then force
             PruneNotifications to run now (real schedule 04:35 daily, see etc/crontab.xml). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\NotificationTestHelper" method="backdateReadNotificationForCustomer" stepKey="backdateReadNotification">
            <argument name="customerId">$createCustomer.id$</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="schedulePruneNotificationsJob">
            <argument name="jobCode">ordo_automation_prune_notifications</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runPruneNotificationsCron"/>

        <!-- Step 5: the real, database-observable negative only a genuine deletion could have
             produced. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\NotificationTestHelper" method="assertNoNotificationForCustomer" stepKey="assertNotificationPrunedAfterCron">
            <argument name="customerId">$createCustomer.id$</argument>
        </helper>
    </test>
</tests>
