<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminReorderCycleAtRiskTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Reorder cycles"/>
            <title value="The 'reorder_cycle_at_risk' segment condition matches a genuinely-drifting customer, and Cron\TagReorderCycleAtRiskCustomers feeds the sales-rep digest"/>
            <description value="Closes ROADMAP.md's 'reorder cycle at risk' candidate feature's own MFTF gap. Shares the same expensive real three-order/backdate/cron setup AdminReorderCycleManualActionsTest already uses (Cron\CalculateReorderCycle requires &gt;= 3 real orders with a real interval, OrderBackdateHelper produces it via 30/20/10-day spacing) - the resulting real ordo_reorder_cycle row has avg_interval_days=10 and last_order_date=10 days ago, a drift ratio of ~1.0 (Model\ReorderCycle\ReorderCycleDriftCalculator), comfortably above the 0.5 threshold this test configures on both sides (the segment condition's own 'ratio_at_least' param and Cron\TagReorderCycleAtRiskCustomers' config threshold). Two real signals from that one real drift: (1) a segment built with the reorder_cycle_at_risk condition, checked via the same live 'Estimated Audience Size' AJAX preview AdminSegmentAudienceSizeReflectsRealDataTest already established (Model\Segment\SegmentMemberResolver's own set-level resolution, not just SegmentMatcher's per-customer path); (2) the sales-rep digest (Cron\SendSalesRepDigest), which now includes an at-risk section fed by Cron\TagReorderCycleAtRiskCustomers - reusing AdminSendSalesRepDigestTest's own rep-email-assignment technique."/>
            <severity value="MAJOR"/>
            <group value="ordo_automation"/>
            <group value="campaign2"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <magentoCLI command="config:set ordo_automation/reorder/enabled 1" stepKey="enableReorder"/>
            <magentoCLI command="config:set ordo_automation/reorder/at_risk_drift_ratio 0.5" stepKey="lowerAtRiskThreshold"/>
        </before>
        <after>
            <magentoCLI command="config:set ordo_automation/reorder/enabled 0" stepKey="disableReorder"/>
            <magentoCLI command="config:set ordo_automation/reorder/at_risk_drift_ratio 0.75" stepKey="restoreAtRiskThresholdDefault"/>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: three REAL orders of the same SKU, through REAL storefront checkout - same
             MIN_ORDERS_TO_DETECT_PATTERN=3 requirement as the sibling reorder-cycle tests. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>

        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage1"/>
        <waitForPageLoad stepKey="waitForProductPage1"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart1">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart1"/>
        <waitForPageLoad stepKey="waitForCartPage1"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeOrder1"/>

        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage2"/>
        <waitForPageLoad stepKey="waitForProductPage2"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart2">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart2"/>
        <waitForPageLoad stepKey="waitForCartPage2"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeOrder2"/>

        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage3"/>
        <waitForPageLoad stepKey="waitForProductPage3"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart3">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart3"/>
        <waitForPageLoad stepKey="waitForCartPage3"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeOrder3"/>

        <!-- Step 2: a real, even 10-day spacing (30/20/10 days ago), then force
             CalculateReorderCycle to run once via the real cron - a real ordo_reorder_cycle row
             now genuinely exists for this customer/SKU with avg_interval_days=10 and
             last_order_date=10 days ago, a drift ratio of ~1.0. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\OrderBackdateHelper" method="backdateRecentOrders" stepKey="backdateOrders">
            <argument name="daysAgoCsv">30,20,10</argument>
            <argument name="customerId">$createCustomer.id$</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleCalculateReorderCycleJob">
            <argument name="jobCode">ordo_automation_calculate_reorder_cycle</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runCalculateReorderCycleCron"/>

        <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>

        <!-- Step 3: assign a real rep email to the real customer, same technique
             AdminSendSalesRepDigestTest already established - the only thing
             SendSalesRepDigest's own grouping keys on. -->
        <amOnPage url="{{AdminEditCustomerPage.url($$createCustomer.id$$)}}" stepKey="goToCustomerEditPage"/>
        <waitForPageLoad stepKey="waitForCustomerEditPage"/>
        <actionGroup ref="AdminOpenAccountInformationTabFromCustomerEditPageActionGroup" stepKey="openAccountInformationTab"/>
        <waitForElementVisible selector="[name='customer[ordo_sales_rep_email]']" stepKey="waitForRepEmailField"/>
        <fillField selector="[name='customer[ordo_sales_rep_email]']" userInput="reorder-at-risk-rep@example.test" stepKey="fillRepEmail"/>
        <click selector="{{AdminCustomerMainActionsSection.saveButton}}" stepKey="saveCustomer"/>
        <see selector="{{AdminCustomerMessagesSection.successMessage}}" userInput="You saved the customer" stepKey="seeCustomerSavedMessage"/>

        <!-- Step 4: the segment - one condition, type=reorder_cycle_at_risk,
             params={"ratio_at_least": "0.5"} - checked via the real, live "Estimated Audience
             Size" AJAX preview (Model\Segment\SegmentMemberResolver's own set-level query, the
             same real code path a bulk action or campaign in_segment condition would use). -->
        <amOnPage url="admin/ordo/segment/new" stepKey="goToNewSegmentPage"/>
        <waitForPageLoad stepKey="waitForNewSegmentPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForSegmentNameField"/>
        <fillField selector="[name='name']" userInput="Reorder Cycle At Risk Test Segment" stepKey="fillSegmentName"/>
        <click selector="//*[contains(text(), 'Add Condition')]" stepKey="addSegmentConditionRow"/>
        <waitForElementVisible selector="[name='conditions[conditions][0][type]']" stepKey="waitForSegmentConditionRow"/>
        <selectOption selector="[name='conditions[conditions][0][type]']" userInput="reorder_cycle_at_risk" stepKey="selectSegmentConditionType"/>
        <waitForElementVisible selector="[name='conditions[conditions][0][ratio_at_least]']" stepKey="waitForRatioAtLeastField"/>
        <fillField selector="[name='conditions[conditions][0][ratio_at_least]']" userInput="0.5" stepKey="fillSegmentConditionParams"/>

        <click selector="//button[contains(., 'Save &amp; Continue Edit')]" stepKey="clickSaveAndContinueSegment"/>
        <waitForPageLoad stepKey="waitForSegmentSave"/>
        <see selector=".message-success" userInput="The segment has been saved." stepKey="seeSegmentSuccessMessage"/>
        <grabFromCurrentUrl regex="/entity_id\/(\d+)/" stepKey="grabSegmentId"/>

        <waitForElementVisible selector="[data-audience-size-refresh]" stepKey="waitForRefreshButton"/>
        <click selector="[data-audience-size-refresh]" stepKey="clickRefreshAudienceSize"/>
        <waitForText selector="[data-audience-size-value]" userInput="1 customer(s)" stepKey="seeLiveAudienceSizeIsOne"/>

        <!-- Step 5: the sales-rep digest's own at-risk section - Cron\TagReorderCycleAtRiskCustomers
             tags the customer against the real drift ratio, Cron\SendSalesRepDigest reads that
             tag the same way it already reads TagInactiveCustomers' own tag. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleTagAtRiskJob">
            <argument name="jobCode">ordo_automation_tag_reorder_cycle_at_risk_customers</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runTagAtRiskCron"/>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleSendSalesRepDigestJob">
            <argument name="jobCode">ordo_automation_send_sales_rep_digest</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runSendSalesRepDigestCron"/>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeAtRiskCopyInEmail">
            <argument name="expectedText">are at risk of missing their usual reorder</argument>
            <argument name="toAddress">reorder-at-risk-rep@example.test</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeCustomerNameInEmail">
            <argument name="expectedText">$createCustomer.firstname$ $createCustomer.lastname$</argument>
            <argument name="toAddress">reorder-at-risk-rep@example.test</argument>
        </helper>

        <actionGroup ref="AdminDeleteOrdoEntityByFormPostActionGroup" stepKey="deleteSegment">
            <argument name="url" value="admin/ordo/segment/delete/entity_id/{$grabSegmentId}"/>
            <argument name="successMessage" value="The segment has been deleted."/>
        </actionGroup>
    </test>
</tests>
