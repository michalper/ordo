<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminViewDashboardTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="In-admin dashboard"/>
            <title value="Clicking the Ordo Automation menu item opens the dashboard directly"/>
            <description value="Covers the single-flat-menu-item UX decision (etc/adminhtml/menu.xml -> ordo/dashboard/index, no submenu) and DashboardViewModel's server-rendered stats — asserts the campaign/reorder-cycle summary numbers render without going through a separate REST/AJAX call."/>
            <severity value="MAJOR"/>
            <group value="ordo_automation"/>
        </annotations>
        <before>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <amOnPage url="admin/ordo/dashboard/index" stepKey="goToDashboard"/>
        <waitForPageLoad stepKey="waitForDashboard"/>
        <see selector="h1.page-title" userInput="Dashboard" stepKey="seePageTitle"/>
        <seeElement selector="{{OrdoDashboardSection.statCardByLabel('Total campaigns')}}" stepKey="seeTotalCampaignsStat"/>
        <seeElement selector="{{OrdoDashboardSection.statCardByLabel('Tracked reorder cycles')}}" stepKey="seeReorderCycleStat"/>
        <seeElement selector="{{OrdoDashboardSection.navCardByTitle('Reorder Cycles')}}" stepKey="seeReorderCyclesNavCard"/>
    </test>
</tests>
