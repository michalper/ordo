<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminSendTimeOptimizationDefersToBestHourTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="A customer with enough email open history has a send_email action deferred to their own historically-best hour, then genuinely sent once that hour arrives"/>
            <description value="Closes SCENARIOS.md's last remaining gap - the §1d predictive send-time optimization row. Three real ordo_message_log_event 'opened' rows (SendTimeOptimizer::MIN_SAMPLE_SIZE) are seeded all at the exact same UTC hour, twelve hours from whenever this test actually runs (SendTimeOptimizerTestHelper - same 'no live SendGrid account' reasoning as MessageLogTestHelper's own docblock), with the customer's own ordo_timezone attribute pinned to UTC (CustomerAttributeTestHelper) so the histogram's local-hour math is unambiguous regardless of this install's own store-default timezone. Twelve hours away guarantees SendTimeOptimizationGate::MIN_MEANINGFUL_HOUR_DIFFERENCE is cleared on every real clock. A real order_placed dispatch's send_email action, opted in via the Flow canvas's own 'Send at customer's optimal time' field (Block\Adminhtml\Campaign\Edit\Flow.php - this test's own first run found that field genuinely didn't exist yet: the raw params-JSON fallback textarea every OTHER type without dedicated fields gets only renders when a type has NO dedicated fields at all, and send_email already has two (template/message), so 'use_optimal_send_time' - a real, already-implemented gate with real unit/manual-verification coverage - had no admin UI path to ever actually be set; fixed by adding it as its own dedicated field, the same way template/message already work, and adding it to CampaignSaveProcessor's own DEDICATED_PARAM_FIELDS so a filled value is actually persisted), is confirmed deferred, not sent immediately (no matching text in any recent email), with a real ordo_campaign_scheduled_action row landing on exactly the predicted UTC hour. Seeding 4 more real 'opened' events at the current hour (one more than the original 3 at the far-away target hour, so the histogram's mode genuinely shifts) before backdating that row and running Cron\RunScheduledCampaignActions for real resumes the exact same action - SendTimeOptimizationGate recomputes getBestHour() completely fresh on every attempt, so simply forcing run_at into the past doesn't make a resume send early (confirmed the hard way: it just re-deferred a second time, to the next occurrence of the original far-away hour) - only a customer's own history genuinely pointing at 'now' does. The real email finally arriving with the campaign's own message text is what only a genuinely completed defer-then-resume cycle could have produced."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="campaign3"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- generateDate has to run here, not in <before> - see AdminScheduledCampaignCalendarTest's
             own identical comment on this exact pitfall. "+12 hours" is always the maximally
             distant hour from "now" on a 24-hour clock, so it clears
             SendTimeOptimizationGate::MIN_MEANINGFUL_HOUR_DIFFERENCE (1) on every real run,
             whatever real wall-clock time this test happens to execute at. -->
        <generateDate date="+12 hours" format="Y-m-d H:i:s" timezone="UTC" stepKey="generateEventTimestamp"/>
        <generateDate date="+12 hours" format="H" timezone="UTC" stepKey="generateTargetHour"/>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\CustomerAttributeTestHelper" method="setVarcharAttribute" stepKey="pinCustomerTimezoneToUtc">
            <argument name="customerId">$createCustomer.id$</argument>
            <argument name="attributeCode">ordo_timezone</argument>
            <argument name="value">UTC</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\SendTimeOptimizerTestHelper" method="seedEmailOpenHistory" stepKey="seedOpenHistory">
            <argument name="customerId">$createCustomer.id$</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
            <argument name="eventTimestampUtc">{$generateEventTimestamp}</argument>
        </helper>

        <!-- Step 1: the campaign - trigger=order_placed, action=send_email opted into
             use_optimal_send_time via its own dedicated Flow field. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Send Time Optimization Test Campaign" stepKey="fillName"/>
        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'action', type: 'send_email', fields: {delay_minutes: '0', template: 'ordo_campaign_generic', message: 'Optimal send time test message.', use_optimal_send_time: 'true'}}
        ]);" stepKey="buildFlowGraph"/>
        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>
        <grabFromCurrentUrl regex="/entity_id\/(\d+)/" stepKey="grabCampaignId"/>

        <!-- Step 2: a real order - dispatch runs send_email inline (delay_minutes=0), whose own
             SendTimeOptimizationGate check (before QuietHoursGate, per that gate's own docblock)
             finds the seeded history, computes the predicted hour, and defers instead of
             sending. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>
        <wait time="2" stepKey="waitForDispatchMessageVisible"/>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\QueueConsumerHelper" method="drainQueueWithRetry" stepKey="runCampaignDispatchConsumer">
            <argument name="topic">ordo.automation.campaign.dispatch</argument>
        </helper>

        <!-- Step 3: deferred, not sent - and the real scheduled row landed on exactly the
             predicted UTC hour, not just "some future time". -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="assertTextNotInAnyRecentEmail" stepKey="assertNotSentImmediately">
            <argument name="expectedText">Optimal send time test message.</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="getMostRecentScheduledActionRunAtHour" stepKey="grabScheduledRunAtHour">
            <argument name="campaignId">{$grabCampaignId}</argument>
        </helper>
        <assertEquals stepKey="assertScheduledForPredictedHour">
            <expectedResult type="variable">generateTargetHour</expectedResult>
            <actualResult type="variable">grabScheduledRunAtHour</actualResult>
        </assertEquals>

        <!-- Step 4: real wall-clock time can't wait twelve hours for the resume to land on the
             originally-predicted hour, and forcibly backdating run_at alone doesn't help here
             unlike QuietHoursGate's own resume story - SendTimeOptimizationGate recomputes
             getBestHour() completely fresh on every attempt, including a resumed one (confirmed
             by this test's own first run: backdating straight to "now" just made it re-defer a
             SECOND time, to the next occurrence of the same predicted hour, since "now" was
             still far from it). A customer's own open/click history is exactly the kind of thing
             that keeps growing between a deferred send and its resume, so this seeds 4 MORE real
             "opened" events at the CURRENT hour - one more than the original 3 at the far-away
             target hour - so the histogram's mode genuinely shifts to "now" by the time the
             resume runs, the same way a real customer opening a few more emails in the meantime
             would. -->
        <generateDate date="now" format="Y-m-d H:i:s" timezone="UTC" stepKey="generateFreshEventTimestamp"/>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\SendTimeOptimizerTestHelper" method="seedEmailOpenHistory" stepKey="seedFreshOpenHistory">
            <argument name="customerId">$createCustomer.id$</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
            <argument name="eventTimestampUtc">{$generateFreshEventTimestamp}</argument>
            <argument name="eventCount">4</argument>
        </helper>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="backdateMostRecentScheduledAction" stepKey="backdateScheduledAction">
            <argument name="campaignId">{$grabCampaignId}</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleResumeJob">
            <argument name="jobCode">ordo_automation_run_scheduled_campaign_actions</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runResumeCron"/>

        <!-- Step 5: the real, merchant-visible email only a genuinely completed defer-then-resume
             cycle could have produced. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeMessageAfterResume">
            <argument name="expectedText">Optimal send time test message.</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
        </helper>

        <actionGroup ref="AdminDeleteOrdoEntityByFormPostActionGroup" stepKey="deleteCampaign">
            <argument name="url" value="admin/ordo/campaign/delete/entity_id/{$grabCampaignId}"/>
            <argument name="successMessage" value="The campaign has been deleted."/>
        </actionGroup>
    </test>
</tests>
