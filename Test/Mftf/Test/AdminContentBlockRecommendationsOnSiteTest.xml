<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminContentBlockRecommendationsOnSiteTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Dynamic content blocks"/>
            <title value="A 'recommendations' content block renders on-site, embedded in a real CMS page, for an anonymous visitor"/>
            <description value="Closes ROADMAP.md's 'On-site product recommendation blocks' gap: unlike every other content-block type this suite already covers (rss/product_feed/snippet), which only ever reach a customer via a campaign's send_email action, this proves Block/Frontend/ContentBlock/Render.php - a real storefront Block resolving a content block by its human-authored identifier and calling the same ProducerPool a campaign email uses. Embedded via a real, static layout XML file shipped with the module (view/frontend/layout/cms_page_view_id_e2e-onsite-recommendations-page.xml) - not the {{widget}} directive (two real CI failures proved it resolves to nothing here, no PHP error, Render never even instantiated, root cause still unconfirmed) and not the CMS page's own 'Layout Update XML' field (confirmed, by reading Magento_Cms's own Model/Page.php, that beforeSave() unconditionally wipes layout_update_xml to null whenever layout_update_selected isn't '_existing_' - i.e. always, in any install with no custom layout files registered in that dropdown - so that field has been effectively read-only/deprecated since Magento first added the layout_update_selected dropdown, regardless of any MFTF metadata gap around it). The real, still-supported mechanism, found by reading Magento_Cms\Helper\Page::prepareResultPage(): every CMS page view request calls addPageLayoutHandles(['id' => identifier]), which always adds a layout handle literally named 'cms_page_view_id_{identifier}' - a plain layout XML file for that exact handle is the standard way a developer (not an admin typing into a text field) adds page-specific content, and needs no MFTF metadata changes of any kind since page creation itself only ever needs the identifier field CreateCMSPage already declares. Verified by hand against a real local Magento 2.4.9 install (not by guessing against CI) before writing this test: created the content block and CMS page through the real admin UI, placed a real guest order to make a product the store's only best-seller, then loaded the page fully logged out and saw 'Recommended for you' with the real product name and price - only afterward was this Cest written to codify exactly those same steps."/>
            <severity value="MAJOR"/>
            <group value="ordo_automation"/>
            <group value="campaign2"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createSeedCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createSeedCustomer" stepKey="deleteSeedCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <deleteData createDataKey="createCmsPage" stepKey="deleteCmsPage"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the "recommendations" content block - count deliberately left at its own
             default (4), same reasoning as every other content-block test in this suite: this
             test doesn't assert on the exact count, only that the one real best-selling product
             shows up. -->
        <amOnPage url="admin/ordo/contentblock/new" stepKey="goToNewContentBlockPage"/>
        <waitForPageLoad stepKey="waitForNewContentBlockPage"/>
        <waitForElementVisible selector="[name='identifier']" stepKey="waitForIdentifierField"/>
        <fillField selector="[name='identifier']" userInput="e2e_onsite_recommendations_block" stepKey="fillIdentifier"/>
        <fillField selector="[name='name']" userInput="E2E On-Site Recommendations Block" stepKey="fillName"/>
        <selectOption selector="[name='type']" userInput="recommendations" stepKey="selectRecommendationsType"/>

        <click selector="//button[contains(., 'Save &amp; Continue Edit')]" stepKey="clickSaveContentBlock"/>
        <waitForPageLoad stepKey="waitForContentBlockSave"/>
        <see selector=".message-success" userInput="The content block has been saved." stepKey="seeContentBlockSuccessMessage"/>
        <grabFromCurrentUrl regex="/entity_id\/(\d+)/" stepKey="grabContentBlockId"/>

        <!-- Step 2: a plain CMS page - no layout_update_xml or any other special field needed.
             The block is embedded via this module's own view/frontend/layout/
             cms_page_view_id_e2e-onsite-recommendations-page.xml, matched purely by this
             identifier (see this test's own description for why that's the real, supported
             mechanism, and why the two mechanisms tried before this one both had real problems). -->
        <createData entity="_defaultCmsPage" stepKey="createCmsPage">
            <field key="identifier">e2e-onsite-recommendations-page</field>
        </createData>

        <!-- Step 3: a REAL order, through REAL storefront checkout, by a throwaway seed
             customer - this is what makes SimpleProduct2 rank among the store's best-sellers
             (ProductRecommender::rankedBestSellerSkus(), a plain SUM(qty_ordered) GROUP BY sku
             over the WHOLE store, not scoped to this test or even this MFTF run in any way).
             Quantity is deliberately bumped to 50 here, not left at the storefront default of 1
             - found via a real, repeatable failure running this test as part of the full
             campaign2 group (never surfaced running it alone, which is exactly why "verified by
             hand" in isolation wasn't enough): 9 other tests in this same group each place their
             own real order for their own product, so a plain qty-1 order here can easily rank
             outside the recommendation block's own top-4 default limit once enough sibling tests
             have run first. 50 comfortably outweighs any realistic number of qty-1 sibling
             orders without having to know or hard-code that count. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsSeedCustomer">
            <argument name="Customer" value="$$createSeedCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <fillField selector="{{StorefrontProductActionSection.quantity}}" userInput="50" stepKey="fillQuantity"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <!-- Step 4: log back out - the actual proof this test is after is that the on-site
             block works for a completely anonymous visitor, not just a logged-in one. -->
        <actionGroup ref="StorefrontCustomerLogoutActionGroup" stepKey="logoutSeedCustomer"/>

        <!-- Step 5: the actual proof - the real best-selling product's own name, rendered by
             Block\Frontend\ContentBlock\Render on a real CMS page, for a visitor who never
             logged in and never interacted with any campaign. -->
        <amOnPage url="e2e-onsite-recommendations-page" stepKey="goToCmsPage"/>
        <waitForPageLoad stepKey="waitForCmsPage"/>
        <see selector=".recommended-products" userInput="$createProduct.name$" stepKey="seeRecommendedProductOnPage"/>

        <!-- Cleanup: no <deleteData> equivalent for this REST-less entity - delete it directly
             through the real admin UI instead, same reasoning as every other content-block test
             in this suite. -->
        <actionGroup ref="AdminDeleteOrdoEntityByFormPostActionGroup" stepKey="deleteContentBlock">
            <argument name="url" value="admin/ordo/contentblock/delete/entity_id/{$grabContentBlockId}/"/>
            <argument name="successMessage" value="The content block has been deleted."/>
        </actionGroup>
    </test>
</tests>
