<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminCampaignDelayedActionTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="A campaign action with delay_minutes doesn't fire immediately, only once Cron\RunScheduledCampaignActions resumes it"/>
            <description value="CampaignDispatcher::runActionsFrom() stops the action chain at the first action with delay_minutes greater than 0 and writes one ordo_campaign_scheduled_action row (run_at = now + delay_minutes, executed_at NULL) instead of running that action inline — see the class doc comment on CampaignDispatcher. Cron\RunScheduledCampaignActions (etc/crontab.xml job ordo_automation_run_scheduled_campaign_actions, group default) only resumes rows whose run_at has actually passed (Collection::addDueFilter compares run_at to date('Y-m-d H:i:s') at cron-tick time, a real wall-clock check, not a fake/advanceable one) - so this test places a real order with a real generate_coupon action delayed by 1 minute, confirms the coupon grid stays empty right after the dispatch consumer runs (proving the action chain genuinely paused instead of running the delayed action inline), really waits past the 1-minute delay, then runs the cron job for real and confirms the coupon now exists."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="campaign"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <createData entity="ApiSalesRule" stepKey="createRule"/>
            <!-- Same indexer-mode requirement as AdminCampaignScenarioEndToEndTest.xml: this
                 environment must have cataloginventory_stock/catalog_product_price/
                 catalog_product_attribute/catalog_category_product/catalog_product_category set
                 to "Update on Save" (bin/magento indexer:set-mode realtime ...), otherwise a
                 product created via the API isn't salable on the storefront yet. -->
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <deleteData createDataKey="createRule" stepKey="deleteRule"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: build the scenario exactly like AdminCampaignScenarioEndToEndTest.xml
             (trigger=order_placed, no condition, action=generate_coupon) but with
             delay_minutes=1 on the action instead of 0 - the only thing this test is actually
             about. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="E2E Delayed Coupon Campaign" stepKey="fillName"/>

        <!-- The triggers/conditions/actions dynamicRows fieldsets are permanently hidden now
             that the Drawflow "Flow" canvas is the only editor a merchant actually sees (see
             ordo_campaign_form.xml). window.ordoFlowTestHook.buildChain() (campaign-flow-
             editor.js, TEST-SUPPORT ONLY) builds the same trigger -> action node chain. The one
             field this whole test exists to exercise: CampaignDispatcher::runActionsFrom() treats
             any delay_minutes > 0 as "pause the chain here, write a scheduled-action row, let
             Cron\RunScheduledCampaignActions resume it later" instead of running the action
             inline - see the <wait> further below. -->
        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'action', type: 'generate_coupon', fields: {rule_id: '$createRule.rule_id$', prefix: 'DELAYTEST', delay_minutes: '1'}}
        ]);" stepKey="buildFlowGraph"/>

        <!-- Same sticky-toolbar overlap workaround as AdminCreateCampaignWithConditionsAndActionsTest. -->
        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>

        <!-- Step 2: a REAL order, through REAL storefront checkout, as the REAL customer created
             above - same pattern as AdminCampaignScenarioEndToEndTest.xml. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>

        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <!-- Step 3: run the campaign-dispatch queue consumer for real (no RabbitMQ in this
             environment - DB queue driver only, see AGENTS.md). This is the step that runs
             CampaignDispatcher::dispatch(), which - because delay_minutes=1 on the only action -
             stops immediately and writes the ordo_campaign_scheduled_action row instead of
             generating the coupon. The max-messages flag below is intentionally over-asked
             (50, not 1) per AGENTS.md's "MFTF w prawdziwym CI" note #4: mftf.yml sets
             consumers-wait-for-messages=0, so the consumer returns as soon as the queue is
             drained instead of blocking for more messages that will never arrive. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\QueueConsumerHelper" method="drainQueueWithRetry" stepKey="runCampaignDispatchConsumer">
            <argument name="topic">ordo.automation.campaign.dispatch</argument>
        </helper>

        <!-- Step 4: prove the chain genuinely paused - the coupon must NOT exist yet, right
             after dispatch, before any delay has elapsed. If this assertion is wrong (i.e. the
             coupon already exists here) then delay_minutes isn't actually delaying anything. -->
        <amOnPage url="admin/sales_rule/promo_quote/edit/id/$createRule.rule_id$/" stepKey="goToRuleEditPageBeforeDelay"/>
        <waitForPageLoad stepKey="waitForRuleEditPageBeforeDelay"/>
        <conditionalClick selector="{{AdminCartPriceRulesFormSection.manageCouponCodesHeader}}"
                           dependentSelector="#couponCodesGrid_table" visible="false" stepKey="openCouponCodesTabBeforeDelay"/>
        <waitForElementVisible selector="#couponCodesGrid_table" stepKey="waitForCouponCodesGridBeforeDelay"/>
        <dontSee selector="#couponCodesGrid_table" userInput="DELAYTEST-" stepKey="dontSeeCouponBeforeDelay"/>

        <!-- Step 5: really wait past the 1-minute delay. Cron\RunScheduledCampaignActions'
             Collection::addDueFilter() compares the scheduled row's run_at against
             date('Y-m-d H:i:s') at the moment the cron tick runs - genuine wall-clock time, not
             something a test can fast-forward - so this has to be a real <wait>, not a shortcut.
             65 real seconds for a 1-minute delay leaves a small margin over the minute boundary. -->
        <wait time="65" stepKey="waitForDelayToElapse"/>

        <!-- Step 6: run the actual cron job, not the queue consumer - resuming a delayed action
             is Cron\RunScheduledCampaignActions' job (etc/crontab.xml: job
             ordo_automation_run_scheduled_campaign_actions in the "default" group), which finds
             the now-due scheduled row and calls CampaignDispatcher::resumeScheduledAction(),
             which runs the delayed generate_coupon action unconditionally and continues the
             chain from there.

             This job's own <schedule> is "*/5 * * * *" (etc/crontab.xml) - every 5 real minutes,
             not every minute. Confirmed via a real CI run: a single cron:run right after the
             65s wait above found nothing to do, because Magento's cron dispatcher only executes
             a job during the specific wall-clock window its own cron_expr actually matches -
             calling cron:run doesn't force a job to run "now" regardless of its schedule, it
             only runs whatever is actually due at that instant. delay_minutes=1 guarantees the
             scheduled ROW is due well before that; it says nothing about when the CRON JOB that
             resumes it next gets to run. Repeating cron:run every 30s below (11 times, 330s
             total - just past a full 5-minute cycle) guarantees this test's own invocation spans
             at least one due window for the job, regardless of what wall-clock minute the test
             happened to start in - there's no way to compute or shorten that wait without either
             faking elapsed time (ruled out above) or changing this job's real production
             schedule just to suit a test, which would test something other than what actually
             ships. Each cron:run is a no-op once the job has already resumed the action, so
             the extra calls are harmless, not just tolerated. -->
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron1"/>
        <wait time="30" stepKey="waitBetweenCronRuns1"/>
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron2"/>
        <wait time="30" stepKey="waitBetweenCronRuns2"/>
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron3"/>
        <wait time="30" stepKey="waitBetweenCronRuns3"/>
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron4"/>
        <wait time="30" stepKey="waitBetweenCronRuns4"/>
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron5"/>
        <wait time="30" stepKey="waitBetweenCronRuns5"/>
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron6"/>
        <wait time="30" stepKey="waitBetweenCronRuns6"/>
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron7"/>
        <wait time="30" stepKey="waitBetweenCronRuns7"/>
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron8"/>
        <wait time="30" stepKey="waitBetweenCronRuns8"/>
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron9"/>
        <wait time="30" stepKey="waitBetweenCronRuns9"/>
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron10"/>
        <wait time="30" stepKey="waitBetweenCronRuns10"/>
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron11"/>

        <!-- Step 7: the coupon that only the resumed action chain could have produced now
             exists. waitForText, not <see>, for the same reason as
             AdminCampaignScenarioEndToEndTest.xml: this grid's rows load via a separate AJAX
             call after the table element is already in the DOM. -->
        <amOnPage url="admin/sales_rule/promo_quote/edit/id/$createRule.rule_id$/" stepKey="goToRuleEditPageAfterDelay"/>
        <waitForPageLoad stepKey="waitForRuleEditPageAfterDelay"/>
        <conditionalClick selector="{{AdminCartPriceRulesFormSection.manageCouponCodesHeader}}"
                           dependentSelector="#couponCodesGrid_table" visible="false" stepKey="openCouponCodesTabAfterDelay"/>
        <waitForElementVisible selector="#couponCodesGrid_table" stepKey="waitForCouponCodesGridAfterDelay"/>
        <waitForText selector="#couponCodesGrid_table" userInput="DELAYTEST-" stepKey="seeGeneratedCouponInGridAfterDelay"/>
    </test>
</tests>
