<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminBrowseAbandonmentReminderAndTriggerTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="Cron\SendBrowseAbandonmentReminders dispatches the browse_abandoned campaign trigger for a real, unpurchased product view"/>
            <description value="Closes SCENARIOS.md §1a/§11's last uncovered trigger pair: browse_abandoned is fired from Cron/SendBrowseAbandonmentReminders.php's own dispatch() call, not a live observer, one step earlier in the funnel than cart_abandoned (see AdminSendAbandonedCartReminderAndTriggerTest, the sibling this mirrors) - a registered customer viewed a product and never ordered it since, no cart entity involved at all. Unlike cart_abandoned, this cron has no fixed reminder email of its own (see its own class docblock) - it only dispatches the trigger, so the sole observable effect is the campaign's own action. The customer logs in BEFORE viewing the product (Controller/Track/Event.php resolves customer_id straight from CustomerSession when logged in) so the ordo_visitor_event row already carries customer_id, without needing StitchVisitorIdentity's post-login attribution at all. ordo_automation/browse_abandonment/delay_minutes is cut from the real default (60 minutes) to 0, so a view moments ago already qualifies instead of needing to genuinely wait an hour."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="lifecycle"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <!-- ADR 0027: send_email's default topic (Promotional) now requires an explicit
                 opt-in - no row means NOT consented, so this scenario's campaign send would
                 otherwise be silently skipped. -->
            <helper class="\Ordo\Automation\Test\Mftf\Helper\GdprTestHelper" method="grantPromotionalConsent" stepKey="grantPromotionalConsent">
                <argument name="customerId">$createCustomer.id$</argument>
            </helper>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
            <!-- Off by default (see Helper/Config.php's isBrowseAbandonmentEnabled) - the delay is
                 also cut from the real default (60 minutes) to 0. Both restored in <after> so they
                 don't linger for whatever other lifecycle-group test runs next in this same
                 install. -->
            <magentoCLI command="config:set ordo_automation/browse_abandonment/enabled 1" stepKey="enableBrowseAbandonment"/>
            <magentoCLI command="config:set ordo_automation/browse_abandonment/delay_minutes 0" stepKey="setDelayToZero"/>
        </before>
        <after>
            <magentoCLI command="config:set ordo_automation/browse_abandonment/enabled 0" stepKey="disableBrowseAbandonment"/>
            <magentoCLI command="config:set ordo_automation/browse_abandonment/delay_minutes 60" stepKey="restoreDelayDefault"/>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the campaign - trigger=browse_abandoned, no condition (vacuously satisfied,
             same reasoning as AdminCampaignSendEmailActionTest/AdminSendAbandonedCartReminderAndTriggerTest),
             action=send_email so the trigger's own dispatch is the only thing that can produce
             this email - there is no fixed reminder copy from the cron itself to confuse it with. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Browse Abandoned Send Email Campaign" stepKey="fillName"/>

        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'browse_abandoned'},
            {kind: 'action', type: 'send_email', fields: {template: 'ordo_campaign_generic', message: 'Still eyeing that product?', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraph"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>

        <!-- Step 2: a real, logged-in product view and nothing else - no add-to-cart, no order,
             so SendBrowseAbandonmentReminders' own NOT EXISTS-order-since filter and cart_abandoned's
             separate cron both stay irrelevant to this scenario. Logging in first (rather than
             viewing anonymously and relying on StitchVisitorIdentity, see
             StorefrontVisitorIdentityStitchedOnLoginTest for that separate path) means
             Controller/Track/Event.php resolves customer_id straight from CustomerSession, so the
             logged ordo_visitor_event row already has it. product_view has no automatic page-type
             detection of its own (see StorefrontTrackerPostsEventsTest), so it's called directly
             here exactly as a real theme integration would on a PDP. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <executeJS function="window.ordoTrack('product_view', '$createProduct.sku$')" stepKey="callOrdoTrackForProductView"/>
        <wait time="2" stepKey="waitForProductViewEventToLand"/>

        <!-- Step 3: force SendBrowseAbandonmentReminders to run now - its real schedule is every
             30 minutes (etc/crontab.xml), which a CI run can't wait out. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleSendBrowseAbandonmentRemindersJob">
            <argument name="jobCode">ordo_automation_send_browse_abandonment_reminders</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runSendBrowseAbandonmentRemindersCron"/>

        <!-- Step 4: the real, merchant-visible output only a genuinely-found, unpurchased product
             view could have produced - there is no fixed cron email to confuse this with, unlike
             cart_abandoned's own reminder. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeCampaignMessageInEmail">
            <argument name="expectedText">Still eyeing that product?</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
        </helper>
    </test>
</tests>
