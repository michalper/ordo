<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminScoreThresholdCampaignTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Lead scoring"/>
            <title value="A real customer crossing the lead-scoring threshold fires a real campaign"/>
            <description value="Test/Mftf/SCENARIOS.md #4 + #1a's score_threshold_crossed row — zero MFTF coverage until now, the newest trigger type, same end-to-end shape as AdminCampaignScenarioEndToEndTest. Builds a demographic score rule (customer group General/group_id=1, worth 150 points — comfortably over the default 100-point threshold) and a campaign gated on score_threshold_crossed with no condition (an empty conditions list is vacuously satisfied — see CampaignDispatcher::allConditionsSatisfied()), so the only thing that could make the coupon NOT appear is the trigger chain itself not firing. Creating the customer (Observer/EvaluateCustomerScoreRules.php on customer_save_after) is what actually crosses the threshold in one step: scoreBefore=0 &lt; 100, scoreAfter=150 &gt;= 100."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="campaign"/>
        </annotations>
        <before>
            <createData entity="ApiSalesRule" stepKey="createRule"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createRule" stepKey="deleteRule"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the demographic scoring rule. "enabled" needs no click — unlike the campaign
             form's "enabled" field, ordo_scorerule_form.xml declares <default>1</default> on it,
             so it renders pre-checked. -->
        <amOnPage url="admin/ordo/scorerule/new" stepKey="goToNewScoreRulePage"/>
        <waitForPageLoad stepKey="waitForNewScoreRulePage"/>
        <waitForElementVisible selector="[name='attribute_code']" stepKey="waitForAttributeCodeField"/>
        <fillField selector="[name='attribute_code']" userInput="group_id" stepKey="fillAttributeCode"/>
        <selectOption selector="[name='operator']" userInput="equals" stepKey="selectOperator"/>
        <fillField selector="[name='value']" userInput="1" stepKey="fillValue"/>
        <fillField selector="[name='points']" userInput="150" stepKey="fillPoints"/>
        <click selector="#save" stepKey="clickSaveScoreRule"/>
        <waitForPageLoad stepKey="waitForScoreRuleSave"/>
        <see selector=".message-success" userInput="The score rule has been saved." stepKey="seeScoreRuleSuccessMessage"/>

        <!-- Step 2: the campaign — trigger only, deliberately no condition (see the test's own
             description above for why that's still a real assertion of the trigger chain). -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <!-- See AdminCreateCampaignTest.xml's comment on this same wait — a cold, freshly
             deployed developer-mode instance's first admin page load can lag behind
             waitForPageLoad's document.readyState check. -->
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Score Threshold Coupon Campaign" stepKey="fillName"/>

        <waitForElementVisible selector="//*[contains(text(), 'Add Trigger')]" stepKey="waitForAddTriggerButton"/>
        <click selector="//*[contains(text(), 'Add Trigger')]" stepKey="addTriggerRow"/>
        <waitForElementVisible selector="[name='triggers[triggers][0][trigger_event]']" stepKey="waitForTriggerRow"/>
        <selectOption selector="[name='triggers[triggers][0][trigger_event]']" userInput="score_threshold_crossed" stepKey="selectTriggerEvent"/>

        <click selector="//*[contains(text(), 'Add Action')]" stepKey="addActionRow"/>
        <waitForElementVisible selector="[name='actions[actions][0][type]']" stepKey="waitForActionRow"/>
        <selectOption selector="[name='actions[actions][0][type]']" userInput="generate_coupon" stepKey="selectActionType"/>
        <waitForElementVisible selector="[name='actions[actions][0][rule_id]']" stepKey="waitForRuleIdField"/>
        <fillField selector="[name='actions[actions][0][rule_id]']" userInput="$createRule.rule_id$" stepKey="fillRuleId"/>
        <fillField selector="[name='actions[actions][0][prefix]']" userInput="SCORETEST" stepKey="fillPrefix"/>
        <fillField selector="[name='actions[actions][0][delay_minutes]']" userInput="0" stepKey="fillDelayMinutes"/>

        <!-- Same sticky-toolbar overlap workaround as AdminCreateCampaignWithConditionsAndActionsTest. -->
        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <click selector="//button[contains(., 'Save &amp; Continue Edit')]" stepKey="clickSaveAndContinue"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>

        <!-- Step 3: the real customer. group_id=1 (General) matches the score rule above; this
             single customer_save_after is what actually crosses the threshold (0 -> 150). -->
        <createData entity="Simple_US_Customer" stepKey="createCustomer"/>

        <!-- Step 4: this install has no RabbitMQ (DB queue driver only — see AGENTS.md), so
             nothing consumes the message DispatchScoreThresholdCampaigns just published until a
             consumer actually runs. max-messages is 5, not 1: other tests in this same CI job
             (same DB, no background consumer running between them) can leave their own already
             order-placed/registered dispatch message sitting unconsumed in the queue ahead of
             ours; draining a few keeps this test from picking up a stale message referencing a
             rule another test's own after-hook already deleted, and leaving ours unprocessed.
             Safe to ask for more than are actually queued: the workflow sets
             consumers-wait-for-messages=0, so the consumer returns as soon as the queue is empty
             instead of blocking — see mftf.yml's install step for why that's needed here. -->
        <magentoCLI command="queue:consumers:start ordo.automation.campaign.dispatch --max-messages=5" stepKey="runCampaignDispatchConsumer"/>

        <!-- Step 5: the only assertion that checks a real, merchant-visible side effect — a
             coupon code that only CampaignDispatcher's generate_coupon action, run via the full
             score_threshold_crossed -> generate_coupon chain, could have produced. -->
        <amOnPage url="admin/sales_rule/promo_quote/edit/id/$createRule.rule_id$/" stepKey="goToRuleEditPage"/>
        <waitForPageLoad stepKey="waitForRuleEditPage"/>
        <conditionalClick selector="{{AdminCartPriceRulesFormSection.manageCouponCodesHeader}}"
                           dependentSelector="#couponCodesGrid_table" visible="false" stepKey="openCouponCodesTab"/>
        <waitForElementVisible selector="#couponCodesGrid_table" stepKey="waitForCouponCodesGrid"/>
        <waitForText selector="#couponCodesGrid_table" userInput="SCORETEST-" stepKey="seeGeneratedCouponInGrid"/>
    </test>
</tests>
