<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminEventOccurredConditionTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="A campaign's event_occurred condition matches a real cart_add event from Observer\TrackCartAdd, within its own dedicated Flow fields"/>
            <description value="Closes SCENARIOS.md §1b's event_occurred gap, and along with it Observer\TrackCartAdd's own real storefront add-to-cart coverage (it fires on checkout_cart_product_add_after, the same real event AddToCartFromStorefrontProductPageActionGroup already drives for every other checkout-flow test in this suite - no dedicated Observer\TrackWishlistAdd test is added separately, since it logs the same shape of ordo_visitor_event row through the identical EventOccurredResolver path, just from a different producer). Unlike clv_at_least/purchased_sku/purchased_category, event_occurred DOES have a dedicated Flow-editor field set (Block/Adminhtml/Campaign/Edit/Flow.php's getFieldsConfig(): event_type, event_key, within_days), so all three are set directly via fields rather than the params_json fallback. The real storefront add-to-cart logs a customer-attributed cart_add row (TrackCartAdd, logged-in customers only) BEFORE the order that goes on to trigger order_placed's dispatch, so hasEventOccurred()'s within_days window (7, comfortably covering the seconds between add-to-cart and checkout) finds it."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="segment"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the campaign - trigger=order_placed, condition=event_occurred using its own
             dedicated event_type/event_key/within_days fields. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Event Occurred Send Email Campaign" stepKey="fillName"/>

        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'condition', type: 'event_occurred', fields: {event_type: 'cart_add', event_key: '$createProduct.sku$', within_days: '7'}},
            {kind: 'action', type: 'send_email', fields: {template: 'ordo_campaign_generic', message: 'Event occurred condition fired.', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraph"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>
        <grabFromCurrentUrl regex="/entity_id\/(\d+)/" stepKey="grabCampaignId"/>

        <!-- Step 2: a REAL, logged-in add-to-cart (TrackCartAdd's own real trigger event), then a
             real checkout - order_placed dispatches with the cart_add row already on the books. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <!-- A brief settle wait before draining — defensive against a message-visibility race
             under CI load, same reasoning/fix as AdminCampaignMultipleConditionsAndTest.xml's
             identical step. -->
        <wait time="2" stepKey="waitForDispatchMessageVisible"/>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\QueueConsumerHelper" method="drainQueueWithRetry" stepKey="runCampaignDispatchConsumer">
            <argument name="topic">ordo.automation.campaign.dispatch</argument>
        </helper>

        <!-- Step 3: the real, merchant-visible output only a genuine cart_add event read could
             have produced. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeEventOccurredConditionCopyInEmail">
            <argument name="expectedText">Event occurred condition fired.</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
        </helper>

        <!-- Cleanup: this campaign's order_placed + event_occurred(cart_add, this fixture's own
             unique SKU) condition can only ever match this exact product's own cart-add event,
             which no other test in this suite uses - a stray leftover campaign here is harmless.
             Still deleted for grid hygiene, consistent with this suite's own convention. -->
        <actionGroup ref="AdminDeleteOrdoEntityByFormPostActionGroup" stepKey="deleteCampaign">
            <argument name="url" value="admin/ordo/campaign/delete/entity_id/{$grabCampaignId}"/>
            <argument name="successMessage" value="The campaign has been deleted."/>
        </actionGroup>
    </test>
</tests>
