<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminCampaignAddTagActionTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="A real order triggers a campaign's add_tag action, and the customer really gets tagged"/>
            <description value="Closes the last uncovered action type (see SCENARIOS.md §1c): add_tag has only ever been a side effect inside other tests' fixture setup (e.g. AdminCampaignScenarioEndToEndTest), never the thing directly asserted on. Same order_placed -> queue consumer chain as AdminCampaignSendEmailActionTest, but asserts via VisitorEventHelper::assertCustomerTagAddedByEmail() (real ordo_customer_tag row, real PDO query) that Model/Campaign/Action/AddTag.php actually ran, not just that no exception was thrown."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="dashboard"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the campaign - trigger only, deliberately no condition (vacuously satisfied,
             same reasoning as AdminCampaignSendEmailActionTest), action=add_tag with a tag
             literal enough that a stray row from another test could never coincide. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Order Placed Add Tag Campaign" stepKey="fillName"/>

        <!-- The triggers/conditions/actions dynamicRows fieldsets are permanently hidden now
             that the Drawflow "Flow" canvas is the only editor a merchant actually sees (see
             ordo_campaign_form.xml's triggers_fieldset/conditions_fieldset/actions_fieldset,
             all <visible>false</visible>) — "Add Trigger"/"Add Condition"/"Add Action" no longer
             exist on the page. window.ordoFlowTestHook.buildChain() (campaign-flow-editor.js,
             TEST-SUPPORT ONLY) builds the same trigger -> action node chain a merchant would by
             dragging palette chips onto the canvas, without simulating real HTML5
             drag-and-drop; the real, unmodified "Apply flow to form & Save" button then reads
             those nodes and saves through the exact same provider.save() the native Save button
             uses. -->
        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'action', type: 'add_tag', fields: {tag: 'add-tag-action-test-tag', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraph"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <!-- A plain <click> on the Apply button is intercepted by the page's fixed
             page-actions toolbar overlapping it at this scroll position (element-click-
             intercepted) - dispatching the click via JS hits the exact same button/handler
             without depending on scroll position/viewport geometry. -->
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>

        <!-- Step 2: a REAL order, through REAL storefront checkout, as the REAL customer created
             above. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\QueueConsumerHelper" method="drainQueueWithRetry" stepKey="runCampaignDispatchConsumer">
            <argument name="topic">ordo.automation.campaign.dispatch</argument>
        </helper>

        <!-- Step 3: the real, database-observable output only a real add_tag run could have
             produced - a genuine ordo_customer_tag row, not an assumption from "no exception". -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\VisitorEventHelper" method="assertCustomerTagAddedByEmail" stepKey="assertTagWasApplied">
            <argument name="email">$createCustomer.email$</argument>
            <argument name="tag">add-tag-action-test-tag</argument>
        </helper>
    </test>
</tests>
