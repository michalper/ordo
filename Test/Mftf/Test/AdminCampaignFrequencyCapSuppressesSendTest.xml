<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminCampaignFrequencyCapSuppressesSendTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="A customer already over the cross-channel frequency cap has a real send_email action suppressed instead of sent"/>
            <description value="Closes SCENARIOS.md §1d's frequency-cap structural case. Model/Campaign/FrequencyCapGate.php (used by SendEmail/SendSms/SendWhatsApp/SendPush alike) counts ordo_message_log rows across every channel together within the configured window, opt-in and off by default (Config::isFrequencyCapEnabled()). Since send_sms/send_whatsapp/send_push each need a real provider account this environment doesn't have (see ROADMAP.md, same reasoning as their own unit-only rows in SCENARIOS.md §1c), the 'other channel' contact volume is seeded directly via MessageLogTestHelper::insertMessageLog() - the same real ordo_message_log table a genuine SMS/WhatsApp send would have written to, just without needing a live Twilio/Meta account to produce it. Five 'sms' rows (the default max_messages) already on the books before a real order_placed dispatch means send_email's own FrequencyCapGate::allows() call finds the customer already at capacity and suppresses it - proven by the campaign's own distinctive message text never appearing in any of the customer's real received email (the storefront's own order-confirmation email still arrives regardless, so a bare 'no email at all' check would be wrong - see AdminGdprConsentAndErasureTest's identical reasoning for its own assertTextNotInAnyRecentEmail use)."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="campaign"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
            <!-- Off by default (see Helper/Config.php's isFrequencyCapEnabled) - restored in
                 <after> so it doesn't linger for whatever other campaign-group test runs next in
                 this same install. max_messages/window_hours left at their real defaults (5,
                 24h). -->
            <magentoCLI command="config:set ordo_channels/frequency_cap/enabled 1" stepKey="enableFrequencyCap"/>
            <!-- Five prior "sends" (the default cap) across a different channel, already on the
                 books before this test's own real order - see this test's own description for
                 why a real Twilio account isn't needed to produce them. -->
            <helper class="\Ordo\Automation\Test\Mftf\Helper\MessageLogTestHelper" method="insertMessageLog" stepKey="insertPriorSend1">
                <argument name="channel">sms</argument>
                <argument name="toAddress">+15551234567</argument>
                <argument name="status">sent</argument>
                <argument name="customerId">$createCustomer.id$</argument>
            </helper>
            <helper class="\Ordo\Automation\Test\Mftf\Helper\MessageLogTestHelper" method="insertMessageLog" stepKey="insertPriorSend2">
                <argument name="channel">sms</argument>
                <argument name="toAddress">+15551234567</argument>
                <argument name="status">sent</argument>
                <argument name="customerId">$createCustomer.id$</argument>
            </helper>
            <helper class="\Ordo\Automation\Test\Mftf\Helper\MessageLogTestHelper" method="insertMessageLog" stepKey="insertPriorSend3">
                <argument name="channel">sms</argument>
                <argument name="toAddress">+15551234567</argument>
                <argument name="status">sent</argument>
                <argument name="customerId">$createCustomer.id$</argument>
            </helper>
            <helper class="\Ordo\Automation\Test\Mftf\Helper\MessageLogTestHelper" method="insertMessageLog" stepKey="insertPriorSend4">
                <argument name="channel">sms</argument>
                <argument name="toAddress">+15551234567</argument>
                <argument name="status">sent</argument>
                <argument name="customerId">$createCustomer.id$</argument>
            </helper>
            <helper class="\Ordo\Automation\Test\Mftf\Helper\MessageLogTestHelper" method="insertMessageLog" stepKey="insertPriorSend5">
                <argument name="channel">sms</argument>
                <argument name="toAddress">+15551234567</argument>
                <argument name="status">sent</argument>
                <argument name="customerId">$createCustomer.id$</argument>
            </helper>
        </before>
        <after>
            <magentoCLI command="config:set ordo_channels/frequency_cap/enabled 0" stepKey="disableFrequencyCap"/>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the campaign - trigger=order_placed, no condition, action=send_email with a
             distinctive message. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Frequency Cap Send Email Campaign" stepKey="fillName"/>

        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'action', type: 'send_email', fields: {template: 'ordo_campaign_generic', message: 'Frequency cap test campaign message.', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraph"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>
        <grabFromCurrentUrl regex="/entity_id\/(\d+)/" stepKey="grabCampaignId"/>

        <!-- Step 2: a REAL order - order_placed dispatches, send_email's own FrequencyCapGate
             check finds the customer already at the 5-message cap and suppresses it instead of
             rendering/sending. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <!-- A brief settle wait before draining — defensive against a message-visibility race
             under CI load, same reasoning/fix as AdminCampaignMultipleConditionsAndTest.xml's
             identical step. -->
        <wait time="2" stepKey="waitForDispatchMessageVisible"/>
        <magentoCLI command="queue:consumers:start ordo.automation.campaign.dispatch --max-messages=50" stepKey="runCampaignDispatchConsumer"/>

        <!-- Step 3: the real, negative proof only a genuine suppression could have produced - the
             storefront's own order-confirmation email still arrives regardless (frequency
             capping is this module's own concern, not core Magento's), only this campaign's own
             distinctive message must be absent. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="assertTextNotInAnyRecentEmail" stepKey="assertCampaignEmailSuppressed">
            <argument name="expectedText">Frequency cap test campaign message.</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
        </helper>

        <actionGroup ref="AdminDeleteOrdoEntityByFormPostActionGroup" stepKey="deleteCampaign">
            <argument name="url" value="admin/ordo/campaign/delete/entity_id/{$grabCampaignId}"/>
            <argument name="successMessage" value="The campaign has been deleted."/>
        </actionGroup>
    </test>
</tests>
