<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminMultipleCampaignsOnSameTriggerOnlySomeSatisfyTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="Two campaigns on the same trigger, only one's condition is satisfied - each fires (or not) independently"/>
            <description value="Multiple campaigns matching the same trigger event where only some satisfy their conditions was previously only an incidental side effect of AdminCampaignScenarioEndToEndTest's own fixture data, never directly asserted (see SCENARIOS.md §1d). Two real campaigns share the order_placed trigger: Campaign A's condition (order_total_gte a huge amount) can never be satisfied by a real order, Campaign B has no condition at all (vacuously satisfied). One real order must tag the customer for B but never for A - both a positive and a negative real-database assertion in the same dispatch pass, proving CampaignDispatcher::dispatch() evaluates each matched campaign independently rather than one bad condition anywhere breaking (or vacuously passing) the whole batch."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="segment"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Campaign A: trigger=order_placed, condition=order_total_gte (a huge amount no real
             order can clear), action=add_tag - must never fire. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPageA"/>
        <waitForPageLoad stepKey="waitForNewCampaignPageA"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameFieldA"/>
        <fillField selector="[name='name']" userInput="Multi Campaign Never Satisfied A" stepKey="fillNameA"/>

        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvasA"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'condition', type: 'order_total_gte', fields: {amount: '999999'}},
            {kind: 'action', type: 'add_tag', fields: {tag: 'multi-campaign-a-never-fires', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraphA"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaignA"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSaveA"/>
        <waitForPageLoad stepKey="waitForSaveA"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessageA"/>

        <!-- Campaign B: same trigger, no condition (vacuously satisfied), action=add_tag - must
             fire. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPageB"/>
        <waitForPageLoad stepKey="waitForNewCampaignPageB"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameFieldB"/>
        <fillField selector="[name='name']" userInput="Multi Campaign Always Satisfied B" stepKey="fillNameB"/>

        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvasB"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'action', type: 'add_tag', fields: {tag: 'multi-campaign-b-always-fires', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraphB"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaignB"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSaveB"/>
        <waitForPageLoad stepKey="waitForSaveB"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessageB"/>

        <!-- One real order, one dispatch pass - both campaigns evaluated. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\QueueConsumerHelper" method="drainQueueWithRetry" stepKey="runCampaignDispatchConsumer">
            <argument name="topic">ordo.automation.campaign.dispatch</argument>
        </helper>

        <!-- Both assertions in the same dispatch pass: B's tag exists, A's never does. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\VisitorEventHelper" method="assertCustomerTagAddedByEmail" stepKey="assertCampaignBTagApplied">
            <argument name="email">$createCustomer.email$</argument>
            <argument name="tag">multi-campaign-b-always-fires</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\VisitorEventHelper" method="assertCustomerTagNotAddedByEmail" stepKey="assertCampaignATagNeverApplied">
            <argument name="email">$createCustomer.email$</argument>
            <argument name="tag">multi-campaign-a-never-fires</argument>
        </helper>
    </test>
</tests>
