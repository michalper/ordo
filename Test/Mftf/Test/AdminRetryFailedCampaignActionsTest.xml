<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminRetryFailedCampaignActionsTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="Cron\RetryFailedCampaignActions re-attempts a genuinely failed scheduled-action resume and succeeds once the underlying problem is fixed"/>
            <description value="Closes SCENARIOS.md §11's RetryFailedCampaignActions gap. A delayed add_tag action's own params are rewritten (CampaignActionCorruptorHelper::setFirstActionParams()) to an oversized tag value (65 chars against ordo_customer_tag.tag's real 64-char column) right before Cron\RunScheduledCampaignActions resumes it - CustomerTagManager::addTag()'s own INSERT then throws a real, uncaught DB error (AddTag/CampaignDispatcher's runOneAction() have no try/catch of their own, unlike send_email/generate_coupon, which swallow their own failures into a DIFFERENT retry mechanism - see this test's own choice of add_tag specifically), which RunScheduledCampaignActions' try/catch turns into a real ordo_campaign_action_retry row (ActionRetryQueue::enqueue(), attempts=1) instead of the failure being silently dropped. The params are then restored to a normal-length tag and CronScheduleHelper::backdateMostRecentActionRetry() backdates next_retry_at (ActionRetryQueue's own 5-minute backoff, which a CI run can't wait out) so Cron\RetryFailedCampaignActions finds it due immediately - this second attempt now succeeds, deletes the retry row, and continues the same resumed chain into its own second action (a delay_minutes=0 send_email) for real. The real, merchant-visible email arriving is what only a genuinely successful retry - one that actually re-ran add_tag and continued the chain - could have produced."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="campaign3"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <!-- ADR 0027: send_email's default topic (Promotional) now requires an explicit
                 opt-in - no row means NOT consented, so this scenario's campaign send would
                 otherwise be silently skipped. -->
            <helper class="\Ordo\Automation\Test\Mftf\Helper\GdprTestHelper" method="grantPromotionalConsent" stepKey="grantPromotionalConsent">
                <argument name="customerId">$createCustomer.id$</argument>
            </helper>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the campaign - trigger=order_placed, action 1=add_tag with delay_minutes>0
             (so CampaignDispatcher pauses the chain into a real ordo_campaign_scheduled_action
             row instead of running inline, same mechanism as AdminCampaignDelayedActionTest),
             action 2=send_email (delay_minutes=0) so a successful resume continues the chain
             into a real, MailHog-observable effect. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Retry Failed Action Campaign" stepKey="fillName"/>

        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'action', type: 'add_tag', fields: {tags: '[&quot;retry_test_ok&quot;]', delay_minutes: '10'}},
            {kind: 'action', type: 'send_email', fields: {template: 'ordo_campaign_generic', message: 'Retried delayed action fired.', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraph"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>
        <grabFromCurrentUrl regex="/entity_id\/(\d+)/" stepKey="grabCampaignId"/>

        <!-- Step 2: a REAL order - dispatch pauses on the delayed add_tag action, writing the
             scheduled row instead of running anything yet. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>
        <wait time="2" stepKey="waitForDispatchMessageVisible"/>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\QueueConsumerHelper" method="drainQueueWithRetry" stepKey="runCampaignDispatchConsumer">
            <argument name="topic">ordo.automation.campaign.dispatch</argument>
        </helper>

        <!-- Step 3: force the scheduled action due now (real schedule = now + 10 minutes, which
             a CI run can't wait out), then deliberately break its resume - the tag value is
             rewritten to 65 characters, one past ordo_customer_tag.tag's real 64-char column. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="backdateMostRecentScheduledAction" stepKey="backdateScheduledAction">
            <argument name="campaignId">{$grabCampaignId}</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CampaignActionCorruptorHelper" method="setFirstActionParams" stepKey="corruptActionParams">
            <argument name="campaignId">{$grabCampaignId}</argument>
            <argument name="paramsJson">{"tag":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}</argument>
        </helper>

        <!-- Step 4: run RunScheduledCampaignActions for real - resumeScheduledAction() hits
             AddTag's own, uncaught "Data too long for column" DB error, so
             ActionRetryQueue::enqueue() writes a real ordo_campaign_action_retry row
             (attempts=1) instead of the failure being dropped. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleRunScheduledCampaignActionsJob">
            <argument name="jobCode">ordo_automation_run_scheduled_campaign_actions</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runScheduledCampaignActionsCron"/>

        <!-- Step 5: fix the underlying problem (restore a normal-length tag) and force the
             retry due now (real backoff = now + 5 minutes, ActionRetryQueue::BASE_DELAY_MINUTES,
             which a CI run can't wait out either). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CampaignActionCorruptorHelper" method="setFirstActionParams" stepKey="restoreActionParams">
            <argument name="campaignId">{$grabCampaignId}</argument>
            <argument name="paramsJson">{"tag":"retry_test_ok"}</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="backdateMostRecentActionRetry" stepKey="backdateActionRetry">
            <argument name="campaignId">{$grabCampaignId}</argument>
        </helper>

        <!-- Step 6: run RetryFailedCampaignActions for real - this second resume attempt
             succeeds against the now-valid tag, deletes the retry row, and continues the same
             resumed chain into its own second action (send_email, delay_minutes=0) for real. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleRetryFailedCampaignActionsJob">
            <argument name="jobCode">ordo_automation_retry_failed_campaign_actions</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runRetryFailedCampaignActionsCron"/>

        <!-- Step 7: the real, merchant-visible email only a genuinely successful retry - one
             that actually re-ran add_tag and continued the chain - could have produced.
             timeoutSeconds widened past MailHogHelper's own 20s default - a real CI run
             (35524359186) caught this exact assertion timing out under CI's own slower/shared
             mail-relay latency, same "message-visibility race under CI load" class of flake
             AdminCampaignMultipleConditionsAndTest's own settle-wait comment already documents,
             just needing a longer poll window here instead of an extra wait before it (this
             step's own real work - two full cron runs plus a real chained send - has already
             happened by the time this assertion starts polling). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeRetriedActionCopyInEmail">
            <argument name="expectedText">Retried delayed action fired.</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
            <argument name="timeoutSeconds">45</argument>
        </helper>

        <actionGroup ref="AdminDeleteOrdoEntityByFormPostActionGroup" stepKey="deleteCampaign">
            <argument name="url" value="admin/ordo/campaign/delete/entity_id/{$grabCampaignId}"/>
            <argument name="successMessage" value="The campaign has been deleted."/>
        </actionGroup>
    </test>
</tests>
