<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminEscalateStalePendingApprovalTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Order approval"/>
            <title value="Cron\EscalateStalePendingApprovals reminds the admin again when a real held order is never acted on"/>
            <description value="Same fixture as AdminApproveOrderViaEmailTest (OrdoApprovalCustomer, spend limit 10.00) but this time nobody acts on the initial hold email - ordo_b2b/order_approval/escalation_days is set to 0 so the pending approval already counts as stale the instant the cron runs (real default is 2 days), and CronScheduleHelper forces the cron to run now instead of waiting out its real nightly schedule. Asserts the escalation email's distinct copy ('still waiting for your decision', not the initial hold email's own text) actually reaches the admin - seeTextInLatestEmail is safe here because the escalation necessarily lands after the initial hold email in real time."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="segment"/>
        </annotations>
        <before>
            <createData entity="OrdoApprovalCustomer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <!-- Cut from the real default (2 days) to 0, so a pending approval created moments
                 ago already counts as stale. Restored in <after> so it doesn't linger for
                 whatever other campaign-group test runs next in this same install. -->
            <magentoCLI command="config:set ordo_b2b/order_approval/escalation_days 0" stepKey="setEscalationDaysToZero"/>
        </before>
        <after>
            <magentoCLI command="config:set ordo_b2b/order_approval/escalation_days 2" stepKey="restoreEscalationDaysDefault"/>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
        </after>

        <!-- Step 1: a real order over the customer's real spend limit, held for approval -
             same setup as AdminApproveOrderViaEmailTest, but this test never follows the
             approve/reject link, leaving the approval genuinely pending. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <!-- Step 2: force EscalateStalePendingApprovals to run now (real schedule 02:00 daily,
             see etc/crontab.xml, which a CI run can't wait out). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleEscalationJob">
            <argument name="jobCode">ordo_automation_escalate_stale_pending_approvals</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runEscalationCron"/>

        <!-- Step 3: the real, merchant-visible output only a genuinely-still-pending approval
             could have produced - the escalation email's own distinct copy, not the initial
             hold email's. approver@example.com is OrdoApprovalCustomerData.xml's fixed
             ordo_approval_admin_email value (see AdminApproveOrderViaEmailTest's own note). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeEscalationCopyInEmail">
            <argument name="expectedText">still waiting for your decision</argument>
            <argument name="toAddress">approver@example.com</argument>
        </helper>
    </test>
</tests>
