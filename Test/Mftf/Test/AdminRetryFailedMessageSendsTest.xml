<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminRetryFailedMessageSendsTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="Cron\RetryFailedMessageSends re-attempts a genuinely exhausted send_email action and succeeds once the underlying problem is fixed"/>
            <description value="Closes SCENARIOS.md §11's RetryFailedMessageSends gap - same shape as RetryFailedCampaignActions (see AdminRetryFailedCampaignActionsTest) but one level down: this retries a single channel SEND, not a whole scheduled-action resume. A real order_placed dispatch's send_email action is given a nonexistent email template identifier, so TransportBuilder::getTransport() fails, SendRetrier exhausts its 3 in-process attempts (~600ms, see that class's own docblock), and SendEmail's own catch calls MessageSendRetryQueue::enqueue() - a real ordo_message_send_retry row (attempts=1), all within the initial dispatch itself (delay_minutes=0, no scheduled-action indirection needed here, unlike the campaign-action-retry test). Unlike ordo_campaign_action_retry, this table has no campaign_id column (a retry row is a self-contained action_type+context+params snapshot re-run standalone, see that table's own db_schema.xml comment) - CampaignActionCorruptorHelper::setMostRecentMessageSendRetryParams() fixes the template identifier directly on the retry row, and CronScheduleHelper::backdateMostRecentMessageSendRetry() backdates next_retry_at (MessageSendRetryQueue's own 5-minute backoff, which a CI run can't wait out) so Cron\RetryFailedMessageSends finds it due immediately. The real, merchant-visible email arriving with the campaign's own message text is what only a genuinely successful retry could have produced."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="campaign3"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <!-- ADR 0027: send_email's default topic (Promotional) now requires an explicit
                 opt-in - no row means NOT consented, so this scenario's campaign send would
                 otherwise be silently skipped. -->
            <helper class="\Ordo\Automation\Test\Mftf\Helper\GdprTestHelper" method="grantPromotionalConsent" stepKey="grantPromotionalConsent">
                <argument name="customerId">$createCustomer.id$</argument>
            </helper>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the campaign - trigger=order_placed, action=send_email. "template" now
             renders as a <select> of real, registered templates (SendEmail::getParamFields()'s
             "options" key, refactor 4bb9136) - a nonexistent identifier has no matching <option>,
             so buildChain can no longer set it directly (the select's value would just stay
             unchanged). Save with a real template through the UI instead, then corrupt it to the
             nonexistent one directly on the saved row right after, same direct-DB-write technique
             (and the same CampaignActionCorruptorHelper) Step 3 below already uses for the retry
             row. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Retry Failed Message Send Campaign" stepKey="fillName"/>

        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'action', type: 'send_email', fields: {template: 'ordo_campaign_generic', message: 'Retried message send fired.', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraph"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>
        <grabFromCurrentUrl regex="/entity_id\/(\d+)/" stepKey="grabCampaignId"/>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\CampaignActionCorruptorHelper" method="setFirstActionParams" stepKey="corruptTemplateToNonexistent">
            <argument name="campaignId">{$grabCampaignId}</argument>
            <argument name="paramsJson">{"template":"ordo_nonexistent_template_xyz","message":"Retried message send fired.","delay_minutes":"0"}</argument>
        </helper>

        <!-- Step 2: a REAL order - dispatch runs send_email inline (delay_minutes=0), which
             genuinely fails against the nonexistent template and, after exhausting SendRetrier,
             enqueues a real ordo_message_send_retry row instead of the failure being dropped. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>
        <wait time="2" stepKey="waitForDispatchMessageVisible"/>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\QueueConsumerHelper" method="drainQueueWithRetry" stepKey="runCampaignDispatchConsumer">
            <argument name="topic">ordo.automation.campaign.dispatch</argument>
        </helper>

        <!-- Step 3: fix the underlying problem directly on the retry row (a real template
             identifier) and force it due now (real backoff = now + 5 minutes,
             MessageSendRetryQueue::BASE_DELAY_MINUTES, which a CI run can't wait out). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CampaignActionCorruptorHelper" method="setMostRecentMessageSendRetryParams" stepKey="fixRetryParams">
            <argument name="actionType">send_email</argument>
            <argument name="paramsJson">{"template":"ordo_campaign_generic","message":"Retried message send fired.","delay_minutes":"0"}</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="backdateMostRecentMessageSendRetry" stepKey="backdateRetry">
            <argument name="actionType">send_email</argument>
        </helper>

        <!-- Step 4: run RetryFailedMessageSends for real - re-runs send_email against the fixed
             params and the original stored context, succeeds, and deletes the retry row. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleRetryFailedMessageSendsJob">
            <argument name="jobCode">ordo_automation_retry_failed_message_sends</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runRetryFailedMessageSendsCron"/>

        <!-- Step 5: the real, merchant-visible email only a genuinely successful retry could
             have produced. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeRetriedMessageCopyInEmail">
            <argument name="expectedText">Retried message send fired.</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
        </helper>

        <actionGroup ref="AdminDeleteOrdoEntityByFormPostActionGroup" stepKey="deleteCampaign">
            <argument name="url" value="admin/ordo/campaign/delete/entity_id/{$grabCampaignId}"/>
            <argument name="successMessage" value="The campaign has been deleted."/>
        </actionGroup>
    </test>
</tests>
