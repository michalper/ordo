<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminRfmMassResetCachedScoreTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="RFM"/>
            <title value="The RFM grid's 'Reset Cached Score' mass action deletes a real customer's precomputed row"/>
            <description value="Closes SCENARIOS.md §3's last RFM gap. Controller\Adminhtml\Rfm\MassDelete has nothing of its own to delete (the grid is a live customer_entity/sales_order join, not a stored entity - see that controller's own docblock) - what it actually clears is the SAME ordo_customer_rfm_score row AdminRecencyPercentileConditionTest's own cron test populates, via RfmCalculator::resetScoresForCustomers(). A real order establishes real order history, Cron\RecomputeRfmScores is forced to run (real schedule 01:00 daily) so the row genuinely exists first, then the grid's own row checkbox (located by this customer's real email) is selected and the 'Reset Cached Score' mass action is applied and confirmed through Magento's real confirm modal - the row being genuinely gone afterward is proof only a real mass-delete against this real row could have produced, not just that the controller didn't throw."/>
            <severity value="MAJOR"/>
            <group value="ordo_automation"/>
            <group value="dashboard"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: a real order establishes real order history for RfmCalculator. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\QueueConsumerHelper" method="drainQueueWithRetry" stepKey="drainDispatchQueue">
            <argument name="topic">ordo.automation.campaign.dispatch</argument>
        </helper>

        <!-- Step 2: force RecomputeRfmScores to run now (real schedule 01:00 daily, see
             etc/crontab.xml, which a CI run can't wait out) - this customer's real row now
             genuinely exists, the thing the mass action is about to clear. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="scheduleRecomputeRfmScoresJob">
            <argument name="jobCode">ordo_automation_recompute_rfm_scores</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runRecomputeRfmScoresCron"/>

        <!-- Step 3: the RFM report grid - select this customer's real row (located by email,
             not row position, since other customers/orders can exist in this same shared CI
             job's DB), open the mass-action "Actions" dropdown, choose "Reset Cached Score",
             and accept Magento's real confirm modal. -->
        <amOnPage url="admin/ordo/rfm/index" stepKey="goToRfmReportGrid"/>
        <waitForPageLoad stepKey="waitForRfmReportGrid"/>
        <waitForElementVisible selector="{{AdminDataGridTableSection.rowTemplate($createCustomer.email$)}}" stepKey="waitForCustomerRow"/>
        <click selector="//tr[td[*[contains(.,normalize-space('$createCustomer.email$'))]]]//input[@type='checkbox']" stepKey="clickCustomerRowCheckbox"/>
        <waitForElementVisible selector="button.action-select" stepKey="waitForActionsButton"/>
        <click selector="button.action-select" stepKey="clickActionsButton"/>
        <waitForElementVisible selector="//li[contains(., 'Reset Cached Score')]" stepKey="waitForResetMenuItem"/>
        <click selector="//li[contains(., 'Reset Cached Score')]" stepKey="clickResetMenuItem"/>
        <waitForElementVisible selector=".modal-popup.confirm .action-primary" stepKey="waitForConfirmModal"/>
        <click selector=".modal-popup.confirm .action-primary" stepKey="clickConfirmReset"/>
        <waitForPageLoad stepKey="waitForMassActionRedirect"/>
        <see selector=".message-success" userInput="Reset the cached RFM score for 1 customer(s)" stepKey="seeMassActionSuccessMessage"/>

        <!-- Step 4: the real, database-observable proof only a genuine mass-delete against this
             exact row could have produced. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\RfmTestHelper" method="assertNoRfmScoreForCustomer" stepKey="assertRfmScoreCleared">
            <argument name="customerId">$createCustomer.id$</argument>
        </helper>
    </test>
</tests>
