<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminMonetaryTotalAtLeastConditionTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="RFM"/>
            <title value="A campaign's monetary_total_at_least condition gates dispatch on a customer's real lifetime spend"/>
            <description value="Like RecencyDaysAtMost/OrderFrequencyAtLeast, MonetaryTotalAtLeast reads RfmCalculator::getMonetaryTotal() live - no cron involved. Reuses the same 'amount' field as order_total_gte (same param key, see ordo_campaign_form.xml's conditions switcherConfig), but the two conditions read a different metric: order_total_gte reads the CURRENT order's total straight from dispatch context, monetary_total_at_least sums the customer's ENTIRE non-canceled order history from the database - so a threshold comfortably below SimpleProduct2's fixture price (123.00) proves the real sum was read, not just the current order echoed back."/>
            <severity value="CRITICAL"/>
            <group value="ordo_automation"/>
            <group value="segment"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the campaign - trigger=order_placed, condition=monetary_total_at_least,
             reusing the "amount" field (same param key/shape as order_total_gte). -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Monetary Total At Least Send Email Campaign" stepKey="fillName"/>

        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'condition', type: 'monetary_total_at_least', fields: {amount: '100'}},
            {kind: 'action', type: 'send_email', fields: {template: 'ordo_campaign_generic', message: 'Monetary total condition fired.', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraph"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>
        <grabFromCurrentUrl regex="/entity_id\/(\d+)/" stepKey="grabCampaignId"/>

        <!-- Step 2: a REAL order (SimpleProduct2, 123.00) - comfortably clears the 100.00
             threshold via a real getMonetaryTotal() sum, not just the order's own total echoed
             back (which order_total_gte, a different condition, would do instead). -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <magentoCLI command="queue:consumers:start ordo.automation.campaign.dispatch --max-messages=50" stepKey="runCampaignDispatchConsumer"/>

        <!-- Step 3: the real, merchant-visible output only a genuine lifetime-spend read could
             have produced. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\MailHogHelper" method="seeTextInLatestEmail" stepKey="seeMonetaryConditionCopyInEmail">
            <argument name="expectedText">Monetary total condition fired.</argument>
            <argument name="toAddress">$createCustomer.email$</argument>
        </helper>

        <!-- Cleanup: this campaign's order_placed trigger + monetary_total_at_least(100) condition
             is unconditionally satisfied by essentially any real order placed later in this same
             "segment" group's CI job (every SimpleProduct2 checkout clears 123.00 >= 100) - same
             root-caused leftover-campaign pollution AdminCampaignInSegmentConditionTest.xml's own
             cleanup comment describes. Left undeleted before, this queued a stray "Monetary total
             condition fired." email for every later test's own customer, which
             MailHogHelper::seeTextInLatestEmail (only ever checking the single latest message)
             could then read back instead of that other test's own expected copy. -->
        <actionGroup ref="AdminDeleteOrdoEntityByFormPostActionGroup" stepKey="deleteCampaign">
            <argument name="url" value="admin/ordo/campaign/delete/entity_id/{$grabCampaignId}"/>
            <argument name="successMessage" value="The campaign has been deleted."/>
        </actionGroup>
    </test>
</tests>
