<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminPruneSurveyPromptsTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="On-site behavior tracking"/>
            <title value="Cron\PruneSurveyPrompts deletes a real, already-responded survey prompt past its grace window"/>
            <description value="Closes SCENARIOS.md's PruneSurveyPrompts gap. Same real campaign+order+consumer+poll+answer flow as AdminCampaignNpsSurveyActionTest, up through the prompt actually being answered (responded_at/score genuinely set by Controller/Track/SubmitSurveyResponse's own logic) - then SurveyPromptTestHelper backdates responded_at past the 24-hour grace window (Cron\PruneSurveyPrompts::RESPONDED_GRACE_HOURS, no config knob for this one) and CronScheduleHelper forces the cron to run now instead of waiting out its real 04:40 daily schedule. Asserts the row is genuinely gone, not just that the cron didn't throw."/>
            <severity value="MAJOR"/>
            <group value="ordo_automation"/>
            <group value="segment"/>
        </annotations>
        <before>
            <createData entity="Simple_US_Customer" stepKey="createCustomer"/>
            <createData entity="SimpleProduct2" stepKey="createProduct"/>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <deleteData createDataKey="createCustomer" stepKey="deleteCustomer"/>
            <deleteData createDataKey="createProduct" stepKey="deleteProduct"/>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <!-- Step 1: the campaign - trigger=order_placed, no condition, action=nps_survey. Same
             shape as AdminCampaignNpsSurveyActionTest, minus the downstream condition-gated
             campaign this test doesn't need. -->
        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Prune Survey Prompts Campaign" stepKey="fillName"/>

        <!-- NpsSurvey now declares getParamFields() => [question] (refactor 4bb9136), so the Flow
             canvas renders a dedicated "question" input instead of the params_json fallback
             textarea - see AdminCampaignNpsSurveyActionTest.xml's own comment on this. -->
        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'action', type: 'nps_survey', fields: {question: 'Prune Test Survey Question', delay_minutes: '0'}}
        ]);" stepKey="buildFlowGraph"/>

        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>

        <!-- Step 2: a REAL order, through REAL storefront checkout. -->
        <actionGroup ref="LoginToStorefrontActionGroup" stepKey="loginAsCustomer">
            <argument name="Customer" value="$$createCustomer$$"/>
        </actionGroup>
        <amOnPage url="$createProduct.custom_attributes[url_key]$.html" stepKey="goToProductPage"/>
        <waitForPageLoad stepKey="waitForProductPage"/>
        <actionGroup ref="AddToCartFromStorefrontProductPageActionGroup" stepKey="addProductToCart">
            <argument name="productName" value="$createProduct.name$"/>
        </actionGroup>
        <amOnPage url="checkout/cart" stepKey="goToCart"/>
        <waitForPageLoad stepKey="waitForCartPage"/>
        <actionGroup ref="PlaceOrderWithLoggedUserActionGroup" stepKey="placeRealOrder"/>

        <helper class="\Ordo\Automation\Test\Mftf\Helper\QueueConsumerHelper" method="drainQueueWithRetry" stepKey="runCampaignDispatchConsumer">
            <argument name="topic">ordo.automation.campaign.dispatch</argument>
        </helper>

        <!-- Step 3: stay on the checkout success page - its own tracker.js poll loop renders the
             survey within its first couple of ticks, then answer it for real (the only client
             action that sets score/responded_at). -->
        <waitForElementVisible selector="#ordo-survey-prompt" time="90" stepKey="waitForSurveyPrompt"/>
        <see selector="#ordo-survey-prompt" userInput="Prune Test Survey Question" stepKey="seeSurveyQuestion"/>
        <!-- executeJS, not a native click - a real CI run caught WebDriver's coordinate-based
             click landing on the question div instead of the button (ElementClickIntercepted),
             same class of overlap issue this suite's own sticky-toolbar workaround elsewhere
             already documents; a direct JS click is immune to it. -->
        <executeJS function="document.querySelector('#ordo-survey-prompt button:nth-of-type(10)').click();" stepKey="clickScoreNine"/>
        <dontSeeElement selector="#ordo-survey-prompt" stepKey="dontSeeSurveyPromptAfterAnswering"/>

        <!-- The answer click's own POST is deliberately fire-and-forget (tracker.js removes the
             widget from the DOM immediately, keepalive:true, never awaited) - dontSeeElement
             above only proves the CLIENT side, not that the server has actually written
             score/responded_at yet. A short settle wait closes that race before the next step
             reads the DB directly. -->
        <wait time="2" stepKey="waitForResponsePostToLand"/>

        <!-- Step 4: backdate the now-responded row past the 24h grace window, then force
             PruneSurveyPrompts to run now (real schedule 04:40 daily, see etc/crontab.xml). -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\SurveyPromptTestHelper" method="backdateRespondedSurveyPromptForCustomer" stepKey="backdateRespondedSurveyPrompt">
            <argument name="customerId">$createCustomer.id$</argument>
        </helper>
        <helper class="\Ordo\Automation\Test\Mftf\Helper\CronScheduleHelper" method="scheduleJobNow" stepKey="schedulePruneSurveyPromptsJob">
            <argument name="jobCode">ordo_automation_prune_survey_prompts</argument>
        </helper>
        <magentoCLI command="cron:run --group=default" stepKey="runPruneSurveyPromptsCron"/>

        <!-- Step 5: the real, database-observable negative only a genuine deletion could have
             produced. -->
        <helper class="\Ordo\Automation\Test\Mftf\Helper\SurveyPromptTestHelper" method="assertNoSurveyPromptForCustomer" stepKey="assertSurveyPromptPrunedAfterCron">
            <argument name="customerId">$createCustomer.id$</argument>
        </helper>
    </test>
</tests>
