<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminCreateCampaignTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="Admin can create a campaign with one condition and one action"/>
            <description value="Covers the admin UI shipped in Phase 4: create a campaign via the form's dynamicRows sections, save it, and confirm it appears correctly in the grid. Does not yet exercise the dispatcher actually firing the campaign on a real trigger event — that's checkout-flow-level coverage, tracked as a separate, not-yet-written scenario (see README Phase 6)."/>
            <severity value="MAJOR"/>
            <group value="ordo_automation"/>
        </annotations>
        <before>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>

        <fillField selector="[name='name']" userInput="Test Win-Back Coupon" stepKey="fillName"/>
        <!-- Trigger moved from a single select to its own dynamicRows section
             (CampaignTriggerInterface — a campaign can fire on more than one trigger event
             now), same double-nested posting shape as conditions/actions below. -->
        <click selector="//*[contains(text(), 'Add Trigger')]" stepKey="addTriggerRow"/>
        <waitForElementVisible selector="[name='triggers[triggers][0][trigger_event]']" stepKey="waitForTriggerRow"/>
        <selectOption selector="[name='triggers[triggers][0][trigger_event]']" userInput="order_placed" stepKey="selectTriggerEvent"/>
        <!-- "enabled" renders as a Magento_Ui single-checkbox styled as a toggle switch
             (prefer: "toggle") — the real <input> is visually covered by its own field
             wrapper, so a direct click/checkOption on the input gets intercepted by that
             wrapper. Click the label that sits next to it instead, matching how a real
             user would interact with the toggle. It also sits high enough on the page to end
             up under the sticky page-actions toolbar at the very top of the viewport — scroll
             it into view first with room above for that toolbar. -->
        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>

        <!-- dynamicRows posts fields double-nested under the section's own name
             (conditions[conditions][0][...], actions[actions][0][...]) — see
             Controller/Adminhtml/Campaign/Save.php's DEDICATED_PARAM_FIELDS handling and
             VERIFICATION.md #14, where this exact double-nesting was the real bug found by
             running a real save. A flat conditions[0][...] selector (what an earlier,
             never-executed version of this test assumed) silently matches nothing. -->
        <click selector="//*[contains(text(), 'Add Condition')]" stepKey="addConditionRow"/>
        <waitForElementVisible selector="[name='conditions[conditions][0][type]']" stepKey="waitForConditionRow"/>
        <selectOption selector="[name='conditions[conditions][0][type]']" userInput="order_total_gte" stepKey="selectConditionType"/>
        <fillField selector="[name='conditions[conditions][0][params_json]']" userInput="{&quot;amount&quot;: &quot;500&quot;}" stepKey="fillConditionParams"/>

        <waitForElementVisible selector="//*[contains(text(), 'Add Action')]" stepKey="waitForAddActionButton"/>
        <click selector="//*[contains(text(), 'Add Action')]" stepKey="addActionRow"/>
        <waitForElementVisible selector="[name='actions[actions][0][type]']" stepKey="waitForActionRow"/>
        <selectOption selector="[name='actions[actions][0][type]']" userInput="add_tag" stepKey="selectActionType"/>
        <fillField selector="[name='actions[actions][0][params_json]']" userInput="{&quot;tag&quot;: &quot;big_spender&quot;}" stepKey="fillActionParams"/>

        <click selector="#save" stepKey="clickSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>

        <amOnPage url="admin/ordo/campaign/index" stepKey="goToCampaignGrid"/>
        <waitForPageLoad stepKey="waitForGrid"/>
        <see selector="table.data-grid" userInput="Test Win-Back Coupon" stepKey="seeCampaignInGrid"/>
    </test>
</tests>
