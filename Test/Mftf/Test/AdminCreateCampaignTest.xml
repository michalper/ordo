<?xml version="1.0" encoding="UTF-8"?>
<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="AdminCreateCampaignTest">
        <annotations>
            <features value="Ordo Automation"/>
            <stories value="Campaign engine"/>
            <title value="Admin can create a campaign with one condition and one action"/>
            <description value="Covers the admin UI shipped in Phase 4: create a campaign via the form's dynamicRows sections, save it, and confirm it appears correctly in the grid. Does not yet exercise the dispatcher actually firing the campaign on a real trigger event — that's checkout-flow-level coverage, tracked as a separate, not-yet-written scenario (see README Phase 6)."/>
            <severity value="MAJOR"/>
            <group value="ordo_automation"/>
            <group value="campaign2"/>
        </annotations>
        <before>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
        </before>
        <after>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logoutAsAdmin"/>
        </after>

        <amOnPage url="admin/ordo/campaign/new" stepKey="goToNewCampaignPage"/>
        <waitForPageLoad stepKey="waitForNewCampaignPage"/>

        <!-- waitForPageLoad above only waits for document.readyState/jQuery.active — this
             Magento_Ui form field renders after RequireJS/knockout finish applying bindings,
             which a cold, freshly-deployed developer-mode instance's first admin page load can
             lag noticeably behind that (see AGENTS.md's on-the-fly LESS/JS compilation note).
             Found via a real CI run: "Field by name...[name='name'] was not found" on a fresh
             instance where this had never been an issue in the already-warmed-up local sandbox. -->
        <waitForElementVisible selector="[name='name']" stepKey="waitForNameField"/>
        <fillField selector="[name='name']" userInput="Test Win-Back Coupon" stepKey="fillName"/>
        <!-- The triggers/conditions/actions dynamicRows fieldsets are permanently hidden now
             that the Drawflow "Flow" canvas is the only editor a merchant actually sees (see
             ordo_campaign_form.xml's triggers_fieldset/conditions_fieldset/actions_fieldset,
             all <visible>false</visible>) — "Add Trigger"/"Add Condition"/"Add Action" no longer
             exist on the page. window.ordoFlowTestHook.buildChain() (campaign-flow-editor.js,
             TEST-SUPPORT ONLY) builds the same trigger -> condition -> action node chain a
             merchant would by dragging palette chips onto the canvas; order_total_gte and
             add_tag both have dedicated fields per Flow::getFieldsConfig() (amount, tag), so
             those are used directly instead of the old raw params_json fallback. -->
        <waitForElementVisible selector="#ordo-campaign-flow" stepKey="waitForFlowCanvas"/>
        <executeJS function="window.ordoFlowTestHook.buildChain([
            {kind: 'trigger', type: 'order_placed'},
            {kind: 'condition', type: 'order_total_gte', fields: {amount: '500'}},
            {kind: 'action', type: 'add_tag', fields: {tags: '[&quot;big_spender&quot;]'}}
        ]);" stepKey="buildFlowGraph"/>
        <!-- "enabled" renders as a Magento_Ui single-checkbox styled as a toggle switch
             (prefer: "toggle") — the real <input> is visually covered by its own field
             wrapper, so a direct click/checkOption on the input gets intercepted by that
             wrapper. Click the label that sits next to it instead, matching how a real
             user would interact with the toggle. It also sits high enough on the page to end
             up under the sticky page-actions toolbar at the very top of the viewport — scroll
             it into view first with room above for that toolbar. -->
        <executeJS function="document.evaluate(&quot;//input[@name='enabled']/following-sibling::label&quot;, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue.click();" stepKey="enableCampaign"/>

        <!-- A plain <click> on the Apply button is intercepted by the page's fixed
             page-actions toolbar overlapping it at this scroll position (element-click-
             intercepted) - dispatching the click via JS hits the exact same button/handler
             without depending on scroll position/viewport geometry. -->
        <executeJS function="document.querySelector(&quot;[data-flow-action='apply']&quot;).click();" stepKey="clickApplyFlowAndSave"/>
        <waitForPageLoad stepKey="waitForSave"/>
        <see selector=".message-success" userInput="The campaign has been saved." stepKey="seeSuccessMessage"/>

        <amOnPage url="admin/ordo/campaign/index" stepKey="goToCampaignGrid"/>
        <waitForPageLoad stepKey="waitForGrid"/>
        <see selector="table.data-grid" userInput="Test Win-Back Coupon" stepKey="seeCampaignInGrid"/>
    </test>
</tests>
