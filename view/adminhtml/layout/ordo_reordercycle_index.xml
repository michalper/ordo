<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Ordo_Automation::css/dashboard.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="ordo_reorder_cycle_listing_intro"
                   template="Ordo_Automation::listing_intro.phtml" before="ordo_reorder_cycle_listing">
                <arguments>
                    <argument name="intro_text" xsi:type="string">Read-only view of what the reorder-detection engine has calculated for each customer/SKU pair, including whether a sent reminder actually led to a reorder. You don't need to check this screen for reminders to keep working — it's here to verify the detection looks right.</argument>
                </arguments>
            </block>
            <block class="Magento\Framework\View\Element\Template" name="ordo_reorder_cycle_recalculate_now_button"
                   template="Ordo_Automation::reordercycle/recalculatenowbutton.phtml"
                   before="ordo_reorder_cycle_listing"/>
            <uiComponent name="ordo_reorder_cycle_listing"/>
        </referenceContainer>
    </body>
</page>
