<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Ordo_Automation::css/_tokens.css"/>
        <css src="Ordo_Automation::css/dashboard.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="ordo_messagelog_listing_intro"
                   template="Ordo_Automation::listing_intro.phtml" before="ordo_messagelog_listing">
                <arguments>
                    <argument name="intro_text" xsi:type="string">Read-only delivery record of every SMS, email, and push notification a campaign action sent — use it to check whether a specific send actually went through, or why it failed.</argument>
                </arguments>
            </block>
            <uiComponent name="ordo_messagelog_listing"/>
        </referenceContainer>
    </body>
</page>
