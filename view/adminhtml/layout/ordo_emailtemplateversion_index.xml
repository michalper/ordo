<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Ordo_Automation::css/_tokens.css"/>
        <css src="Ordo_Automation::css/dashboard.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="ordo_emailtemplateversion_listing_intro"
                   template="Ordo_Automation::listing_intro.phtml" before="ordo_emailtemplateversion_listing">
                <arguments>
                    <argument name="intro_text" xsi:type="string">Read-only: every snapshot taken of a Magento email template's content, across every template, each time it was saved (Marketing &gt; Email Templates). Restore a row to copy that snapshot's subject/content back onto the live template.</argument>
                </arguments>
            </block>
            <uiComponent name="ordo_emailtemplateversion_listing"/>
        </referenceContainer>
    </body>
</page>
