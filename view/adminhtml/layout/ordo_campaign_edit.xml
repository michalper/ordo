<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Ordo_Automation::css/_tokens.css"/>
        <css src="Ordo_Automation::lib/drawflow/drawflow.min.css"/>
        <css src="Ordo_Automation::css/flow.css"/>
        <css src="Ordo_Automation::css/campaign-form.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Ordo\Automation\Block\Adminhtml\Campaign\Edit\Flow"
                   name="ordo_campaign_flow"
                   template="Ordo_Automation::campaign/flow.phtml"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="ordo_campaign_funnel"
                   template="Ordo_Automation::campaign/funnel.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Ordo\Automation\Block\Adminhtml\Campaign\FunnelViewModel</argument>
                </arguments>
            </block>
            <uiComponent name="ordo_campaign_form"/>
        </referenceContainer>
    </body>
</page>
