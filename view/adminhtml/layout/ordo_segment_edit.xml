        <css src="Ordo_Automation::css/_tokens.css"/>
        <css src="Ordo_Automation::css/segment-form.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <uiComponent name="ordo_segment_form"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="ordo_segment_group_modal_js"
                   template="Ordo_Automation::segment/require_group_modal_js.phtml"/>
            <block class="Ordo\Automation\Block\Adminhtml\Segment\AudienceSize" name="ordo_segment_audience_size"
                   template="Ordo_Automation::segment/audiencesize.phtml"/>
            <block class="Ordo\Automation\Block\Adminhtml\Segment\BulkActions" name="ordo_segment_bulk_actions"
                   template="Ordo_Automation::segment/bulkactions.phtml"/>
        </referenceContainer>
    </body>
</page>
