<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Ordo_Automation::css/_tokens.css"/>
        <css src="Ordo_Automation::css/dashboard.css"/>
        <css src="Ordo_Automation::css/campaign_calendar.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="ordo_campaign_calendar"
                   template="Ordo_Automation::campaign/calendar/index.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Ordo\Automation\Block\Adminhtml\Campaign\Calendar\CampaignCalendarViewModel</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
