<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Ordo_Automation::css/_tokens.css"/>
        <css src="Ordo_Automation::css/dashboard.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="ordo_rfm_listing_intro"
                   template="Ordo_Automation::listing_intro.phtml" before="ordo_rfm_listing">
                <arguments>
                    <argument name="intro_text" xsi:type="string">Recency/Frequency/Monetary standing for every customer who has placed at least one order, refreshed live from order history — R/F/M Quintile columns rank customers 1 (lowest) to 5 (highest) against each other. Use the Qualifies For column to see which of your segments a customer's current standing puts them in.</argument>
                </arguments>
            </block>
            <uiComponent name="ordo_rfm_listing"/>
        </referenceContainer>
    </body>
</page>
