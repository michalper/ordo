<?php
/** @var \Ordo\Automation\Block\Adminhtml\Segment\BulkActions $block */
/** @var \Magento\Framework\Escaper $escaper */
if (!$block->isSegmentSaved()) {
    return;
}
?>
<!--
    <details>, collapsed by default (no "open" attribute) - this panel fires a real, immediate,
    asynchronously-applied action against every customer currently matching the segment, so it's
    deliberately NOT rendered open-by-default directly under the conditions fieldset above (an
    admin scrolling through conditions used to land straight on "Run Bulk Action" with nothing
    separating the two). Native <details>/<summary> needs no JS to collapse/expand and is
    keyboard/screen-reader accessible out of the box.
-->
<details class="admin__fieldset-wrapper ordo-bulk-actions-panel">
    <summary class="admin__fieldset-wrapper-title">
        <strong><?= $escaper->escapeHtml(__('Bulk actions on current members')) ?></strong>
    </summary>
    <div class="admin__fieldset-wrapper-content">
        <p><?= $escaper->escapeHtml(
            __(
                'Runs against everyone currently matching this segment\'s conditions. '
                . 'The action is queued and applied asynchronously.'
            )
        ) ?></p>
        <form action="<?= $escaper->escapeUrl($block->getFormAction()) ?>" method="post">
            <?= $block->getBlockHtml('formkey') ?>
            <input type="hidden" name="segment_id" value="<?= (int) $block->getSegmentId() ?>"/>
            <div class="admin__field">
                <label class="admin__field-label" for="ordo-segment-bulk-action-type">
                    <span><?= $escaper->escapeHtml(__('Action')) ?></span>
                </label>
                <div class="admin__field-control">
                    <select id="ordo-segment-bulk-action-type" name="action_type" class="admin__control-select"
                            data-bulk-action-select="1">
                        <option value="add_tag"><?= $escaper->escapeHtml(__('Add Tag')) ?></option>
                        <option value="add_points"><?= $escaper->escapeHtml(__('Add Points')) ?></option>
                    </select>
                </div>
            </div>
            <!--
                Each field below is tagged with data-bulk-action-field="<action key>" - only the
                field(s) matching the currently-selected Action show, toggled by the small inline
                script at the bottom of this template. Reported directly: both Tag and Points sat
                visible at once regardless of which action was selected ("Add Points" chosen, Tag
                field still shown right above it) - confusing on its own, and would only get worse
                field-by-field as more bulk actions are added (this form has no ui_component/
                switcherConfig to lean on - see BulkActions.php's own docblock for why it's plain
                HTML). Adding a future action means adding one more <option> here plus one more
                data-bulk-action-field block with a matching key - the toggle script itself never
                needs to change, it just reads whatever keys are present in the DOM.
            -->
            <div class="admin__field" data-bulk-action-field="add_tag">
                <label class="admin__field-label" for="ordo-segment-bulk-tag">
                    <span><?= $escaper->escapeHtml(__('Tag')) ?></span>
                </label>
                <div class="admin__field-control">
                    <input type="text" id="ordo-segment-bulk-tag" name="tag" class="admin__control-text"/>
                </div>
            </div>
            <div class="admin__field" data-bulk-action-field="add_points">
                <label class="admin__field-label" for="ordo-segment-bulk-points">
                    <span><?= $escaper->escapeHtml(__('Points')) ?></span>
                </label>
                <div class="admin__field-control">
                    <input type="number" id="ordo-segment-bulk-points" name="points" class="admin__control-text"/>
                </div>
            </div>
            <div class="admin__field ordo-bulk-actions-submit">
                <button type="submit" class="action-primary">
                    <span><?= $escaper->escapeHtml(__('Run Bulk Action')) ?></span>
                </button>
            </div>
        </form>
    </div>
</details>
<script>
require(['Ordo_Automation/js/segment-bulk-actions']);
</script>
