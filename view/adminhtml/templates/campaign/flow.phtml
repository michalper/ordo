<?php
/** @var \Ordo\Automation\Block\Adminhtml\Campaign\Edit\Flow $block */
/** @var \Magento\Framework\Escaper $escaper */

$flowIntro = __(
    'Drag a block from the palette onto the canvas, then drag from the small dot on the right edge of one node '
    . 'to the dot on the left edge of the next to connect them. A campaign can start from more than one trigger '
    . '— every one of them must lead all the way through to an Action before you can save. Then "Apply flow to '
    . 'form & Save" writes the graph into the form below and saves through the same action the Save button uses.'
);
$applyFlowButtonLabel = __('Apply flow to form & Save');
?>
<!--
    Unconditional: the Flow canvas used to only render once a campaign already had an entity_id
    (a brand-new campaign fell back to the bare native Triggers/Conditions/Actions dynamicRows
    form below, with a note explaining why) — reported directly as confusing, two different ways
    to build a campaign depending on whether it happened to be new or already saved
    ("ma byc ujednolicone"). Flow::getFlowDataJson() already returns '{}' (an empty canvas) when
    there's no campaign yet, and "Apply flow to form & Save" already calls the exact same form
    provider's save() the native Save button uses (which already knows how to create a brand-new
    entity) - nothing here actually required an existing entity_id, that was only ever a
    self-imposed gate. Removing it makes the canvas the one, single way to build a campaign,
    new or existing alike.
-->
<div class="ordo-flow-wrapper" data-flow-test-send-url="<?=
    $escaper->escapeHtmlAttr($block->getUrl('ordo/templatetestsend/send'))
?>">
    <div class="ordo-flow-head">
        <h2><?= $escaper->escapeHtml(__('Flow')) ?></h2>
        <p><?= $escaper->escapeHtml($flowIntro) ?></p>
        <div class="ordo-flow-toolbar">
            <!--
                Undo/redo a canvas edit (add/remove/duplicate a node, move it, connect/disconnect
                two nodes, or change a field) - closes half of the ROADMAP.md "Flow canvas UX"
                gap (no undo/redo, no node duplication). History lives only in memory for this
                page load, same as any other in-page undo stack - it is not persisted, and is
                unrelated to the campaign's own saved state until "Apply flow to form & Save" is
                clicked.
            -->
            <button type="button" class="ordo-flow-undo" data-flow-action="undo" title="<?=
                $escaper->escapeHtmlAttr(__('Undo'))
            ?>" disabled>↶</button>
            <button type="button" class="ordo-flow-redo" data-flow-action="redo" title="<?=
                $escaper->escapeHtmlAttr(__('Redo'))
            ?>" disabled>↷</button>
            <!--
                Ready-made starting points for common, repeated scenarios (reported directly:
                a merchant shouldn't have to hand-drag/wire the same trigger->action chain every
                time for a scenario this module already knows is popular). The actual node
                graph for each key is defined once in campaign-flow-editor.js's FLOW_TEMPLATES -
                these labels must stay in sync with those keys.
            -->
            <details class="ordo-flow-templates">
                <summary><?= $escaper->escapeHtml(__('Load a Template')) ?></summary>
                <div class="ordo-flow-templates-menu">
                    <button type="button" data-flow-template="abandoned_cart">
                        <?= $escaper->escapeHtml(__('Abandoned Cart Recovery')) ?>
                    </button>
                    <button type="button" data-flow-template="welcome_new_customer">
                        <?= $escaper->escapeHtml(__('Welcome New Customer')) ?>
                    </button>
                    <button type="button" data-flow-template="post_purchase_coupon">
                        <?= $escaper->escapeHtml(__('Post-Purchase Thank You + Coupon')) ?>
                    </button>
                    <button type="button" data-flow-template="tagged_customer_followup">
                        <?= $escaper->escapeHtml(__('Follow Up on Tagged Customers')) ?>
                    </button>
                </div>
            </details>
            <button type="button" class="action-primary" data-flow-action="apply"><?=
                $escaper->escapeHtml($applyFlowButtonLabel)
            ?></button>
        </div>
    </div>
    <div class="ordo-flow-body">
        <div class="ordo-flow-palette">
            <!--
                Plain text input, filtered client-side (campaign-flow-editor.js) - with ~20+
                condition/action types across the three groups (ROADMAP.md "Flow canvas UX"
                gap), scanning past everything that doesn't match what a merchant is looking for
                gets tedious fast. Matching auto-opens a <details> group that has a hit and hides
                one that doesn't, so typing narrows the whole palette down to just what's
                relevant instead of only filtering within an already-open group.
            -->
            <input type="search" class="ordo-flow-palette-search" placeholder="<?=
                $escaper->escapeHtmlAttr(__('Search blocks…'))
            ?>" aria-label="<?= $escaper->escapeHtmlAttr(__('Search palette blocks')) ?>">
            <!--
                <details>/<summary> instead of a plain <div> - a free, JS-free collapsible
                section (native disclosure triangle) so the palette doesn't just grow into an
                ever-longer flat list as this module gains more trigger/condition/action types
                (ROADMAP.md "Admin UX" Phase 4). Closed by default (no "open" attribute) -
                landing on a fresh Flow canvas shows just the three group headers, not every
                item in every group at once; reported directly as the wanted default.
                Each group's own accent color (left border, item dot) matches the Flow canvas
                node color already used for that kind, so a dragged item's color doesn't change
                once it lands on the canvas.
            -->
            <details class="ordo-flow-palette-group ordo-flow-palette-group-trigger">
                <summary><?= $escaper->escapeHtml(__('Triggers')) ?></summary>
                <?php foreach ($block->getTriggerEventLabels() as $type => $label): ?>
                <div class="ordo-flow-palette-item" draggable="true" data-flow-kind="trigger"
                     data-flow-type="<?= $escaper->escapeHtmlAttr($type) ?>"><?= $escaper->escapeHtml($label) ?></div>
                <?php endforeach; ?>
            </details>
            <details class="ordo-flow-palette-group ordo-flow-palette-group-condition">
                <summary><?= $escaper->escapeHtml(__('Conditions')) ?></summary>
                <?php foreach ($block->getConditionTypeLabels() as $type => $label): ?>
                <div class="ordo-flow-palette-item" draggable="true" data-flow-kind="condition"
                     data-flow-type="<?= $escaper->escapeHtmlAttr($type) ?>"><?= $escaper->escapeHtml($label) ?></div>
                <?php endforeach; ?>
            </details>
            <details class="ordo-flow-palette-group ordo-flow-palette-group-action">
                <summary><?= $escaper->escapeHtml(__('Actions')) ?></summary>
                <?php foreach ($block->getActionTypeLabels() as $type => $label): ?>
                <div class="ordo-flow-palette-item" draggable="true" data-flow-kind="action"
                     data-flow-type="<?= $escaper->escapeHtmlAttr($type) ?>"><?= $escaper->escapeHtml($label) ?></div>
                <?php endforeach; ?>
            </details>
        </div>
        <div id="ordo-campaign-flow" class="ordo-flow-canvas"></div>
    </div>
</div>
<script>
require(['Ordo_Automation/js/segment-sku-autocomplete']);
require(['Ordo_Automation/js/campaign-flow-editor'], function (initCampaignFlowEditor) {
    'use strict';

    var container = document.getElementById('ordo-campaign-flow'),
        flowData = <?= /* @noEscape */ $block->getFlowDataJson() ?>,
        typesConfig = {
            triggers: <?= /* @noEscape */ json_encode($block->getTriggerEventTypes()) ?>,
            conditions: <?= /* @noEscape */ json_encode($block->getConditionTypes()) ?>,
            actions: <?= /* @noEscape */ json_encode($block->getActionTypes()) ?>,
            labels: {
                trigger: <?= /* @noEscape */ json_encode($block->getTriggerEventLabels()) ?>,
                condition: <?= /* @noEscape */ json_encode($block->getConditionTypeLabels()) ?>,
                action: <?= /* @noEscape */ json_encode($block->getActionTypeLabels()) ?>
            },
            fields: <?= /* @noEscape */ $block->getFieldsConfigJson() ?>
        };

    initCampaignFlowEditor(container, flowData, 'ordo_campaign_form.ordo_campaign_form_data_source', typesConfig);
});
</script>
