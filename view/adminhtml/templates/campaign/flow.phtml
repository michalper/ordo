<?php
/** @var \Ordo\Automation\Block\Adminhtml\Campaign\Edit\Flow $block */
/** @var \Magento\Framework\Escaper $escaper */

$flowIntro = __(
    'Drag a block from the palette onto the canvas, then drag from the small dot on the right edge of one node '
    . 'to the dot on the left edge of the next to connect them. A campaign can start from more than one trigger '
    . '— every one of them must lead all the way through to an Action before you can save. Then "Apply flow to '
    . 'form & Save" writes the graph into the form below and saves through the same action the Save button uses.'
);
$applyFlowButtonLabel = __('Apply flow to form & Save');
?>
<?php if ($block->hasCampaign()): ?>
<div class="ordo-flow-wrapper">
    <div class="ordo-flow-head">
        <h2><?= $escaper->escapeHtml(__('Flow')) ?></h2>
        <p><?= $escaper->escapeHtml($flowIntro) ?></p>
        <div class="ordo-flow-toolbar">
            <button type="button" class="action-primary" data-flow-action="apply"><?=
                $escaper->escapeHtml($applyFlowButtonLabel)
            ?></button>
        </div>
    </div>
    <div class="ordo-flow-body">
        <div class="ordo-flow-palette">
            <div class="ordo-flow-palette-group">
                <h3><?= $escaper->escapeHtml(__('Triggers')) ?></h3>
                <?php foreach ($block->getTriggerEventLabels() as $type => $label): ?>
                <div class="ordo-flow-palette-item" draggable="true" data-flow-kind="trigger"
                     data-flow-type="<?= $escaper->escapeHtmlAttr($type) ?>"><?= $escaper->escapeHtml($label) ?></div>
                <?php endforeach; ?>
            </div>
            <div class="ordo-flow-palette-group">
                <h3><?= $escaper->escapeHtml(__('Conditions')) ?></h3>
                <?php foreach ($block->getConditionTypeLabels() as $type => $label): ?>
                <div class="ordo-flow-palette-item" draggable="true" data-flow-kind="condition"
                     data-flow-type="<?= $escaper->escapeHtmlAttr($type) ?>"><?= $escaper->escapeHtml($label) ?></div>
                <?php endforeach; ?>
            </div>
            <div class="ordo-flow-palette-group">
                <h3><?= $escaper->escapeHtml(__('Actions')) ?></h3>
                <?php foreach ($block->getActionTypeLabels() as $type => $label): ?>
                <div class="ordo-flow-palette-item" draggable="true" data-flow-kind="action"
                     data-flow-type="<?= $escaper->escapeHtmlAttr($type) ?>"><?= $escaper->escapeHtml($label) ?></div>
                <?php endforeach; ?>
            </div>
        </div>
        <div id="ordo-campaign-flow" class="ordo-flow-canvas"></div>
    </div>
</div>
<script>
require(['Ordo_Automation/js/campaign-flow-editor'], function (initCampaignFlowEditor) {
    'use strict';

    var container = document.getElementById('ordo-campaign-flow'),
        flowData = <?= /* @noEscape */ $block->getFlowDataJson() ?>,
        typesConfig = {
            triggers: <?= /* @noEscape */ json_encode($block->getTriggerEventTypes()) ?>,
            conditions: <?= /* @noEscape */ json_encode($block->getConditionTypes()) ?>,
            actions: <?= /* @noEscape */ json_encode($block->getActionTypes()) ?>,
            labels: {
                trigger: <?= /* @noEscape */ json_encode($block->getTriggerEventLabels()) ?>,
                condition: <?= /* @noEscape */ json_encode($block->getConditionTypeLabels()) ?>,
                action: <?= /* @noEscape */ json_encode($block->getActionTypeLabels()) ?>
            },
            fields: <?= /* @noEscape */ $block->getFieldsConfigJson() ?>
        };

    initCampaignFlowEditor(container, flowData, 'ordo_campaign_form.ordo_campaign_form_data_source', typesConfig);
});
</script>
<?php else: ?>
<script>
require(['uiRegistry'], function (uiRegistry) {
    'use strict';

    // The Flow canvas above (and this whole block) only renders once a campaign has an
    // entity_id — a brand-new campaign has nothing yet to draw. But triggers_fieldset/
    // conditions_fieldset/actions_fieldset in ordo_campaign_form.xml default to
    // <visible>false</visible> now that the canvas is the normal way to add these on an
    // existing campaign — leaving them hidden here too would mean a new campaign could never
    // get its first trigger/condition/action at all. Force them visible for this one case;
    // saving reloads the page with an entity_id, hasCampaign() becomes true, the canvas takes
    // over, and this branch no longer runs.
    ['triggers_fieldset', 'conditions_fieldset', 'actions_fieldset'].forEach(function (fieldsetName) {
        uiRegistry.get('ordo_campaign_form.ordo_campaign_form.' + fieldsetName, function (fieldset) {
            fieldset.visible(true);
        });
    });
});
</script>
<?php endif; ?>
