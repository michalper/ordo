<?php
/** @var \Ordo\Automation\Block\Adminhtml\Gdpr\Index $block */
/** @var \Magento\Framework\Escaper $escaper */
?>
<div class="ordo-dashboard">
    <div class="ordo-page-toolbar">
        <a class="ordo-toolbar-back-link" href="<?= $escaper->escapeUrl($block->getUrl('ordo/dashboard/index')) ?>">
            <?= $escaper->escapeHtml(__('← Back to Dashboard')) ?>
        </a>
    </div>
    <p class="ordo-listing-intro">
        <?= $escaper->escapeHtml(__(
            'Look up one customer by email to view or change their marketing consent, export their'
            . ' data, or permanently erase it — for handling a GDPR/data-protection rights request.'
        )) ?>
    </p>

    <div class="ordo-gdpr-card">
        <div class="ordo-section-head">
            <h2><?= $escaper->escapeHtml(__('Find a customer')) ?></h2>
        </div>
        <form action="<?= $escaper->escapeUrl($block->getSearchFormAction()) ?>" method="get">
            <div class="ordo-gdpr-search-row">
                <div class="admin__field">
                    <label class="admin__field-label" for="ordo-gdpr-email">
                        <span><?= $escaper->escapeHtml(__('Customer email')) ?></span>
                    </label>
                    <div class="admin__field-control">
                        <input type="email" id="ordo-gdpr-email" name="email" class="ordo-input"
                               value="<?= $escaper->escapeHtmlAttr($block->getCustomerEmail()) ?>"/>
                    </div>
                </div>
                <button type="submit" class="ordo-btn ordo-btn-primary">
                    <?= $escaper->escapeHtml(__('Search')) ?>
                </button>
            </div>
        </form>
    </div>

    <?php if ($block->isCustomerResolved()): ?>
        <?php
        $consent = $block->getConsentStates();
        $consentTitle = __('Consent — customer #%1 (%2)', $block->getCustomerId(), $block->getCustomerEmail());
        ?>
        <div class="ordo-gdpr-card">
            <div class="ordo-section-head">
                <h2><?= $escaper->escapeHtml($consentTitle) ?></h2>
            </div>
            <form action="<?= $escaper->escapeUrl($block->getSetConsentFormAction()) ?>" method="post">
                <?= $block->getBlockHtml('formkey') ?>
                <input type="hidden" name="customer_id" value="<?= (int) $block->getCustomerId() ?>"/>
                <input type="hidden" name="email" value="<?= $escaper->escapeHtmlAttr($block->getCustomerEmail()) ?>"/>
                <div class="ordo-trigger-stats">
                    <?php foreach ($consent as $channel => $consented): ?>
                        <div class="ordo-gdpr-consent-row">
                            <span class="ordo-gdpr-consent-label"><?= $escaper->escapeHtml(ucfirst($channel)) ?></span>
                            <div class="ordo-gdpr-consent-controls">
                                <span class="ordo-badge <?= $consented ? 'ordo-badge-on' : 'ordo-badge-off' ?>">
                                    <?=
                                        $consented
                                            ? $escaper->escapeHtml(__('Opted in'))
                                            : $escaper->escapeHtml(__('Opted out'))
                                    ?>
                                </span>
                                <button type="submit" name="channel" value="<?= $escaper->escapeHtmlAttr($channel) ?>"
                                        onclick="this.form.consented.value='<?= $consented ? '0' : '1' ?>'"
                                        class="ordo-btn ordo-btn-secondary">
                                    <?=
                                        $consented
                                            ? $escaper->escapeHtml(__('Opt out'))
                                            : $escaper->escapeHtml(__('Opt in'))
                                    ?>
                                </button>
                            </div>
                        </div>
                    <?php endforeach; ?>
                </div>
                <input type="hidden" name="consented" value=""/>
            </form>
        </div>

        <div class="ordo-gdpr-card">
            <div class="ordo-section-head">
                <h2><?= $escaper->escapeHtml(__('Data subject actions')) ?></h2>
            </div>
            <div class="ordo-gdpr-actions">
                <a class="ordo-btn ordo-btn-secondary" href="<?= $escaper->escapeUrl($block->getExportUrl()) ?>">
                    <?= $escaper->escapeHtml(__('Export all data (JSON)')) ?>
                </a>
                <?php $eraseConfirm = __(
                    'Permanently erase all Ordo Automation data for this customer? This cannot be undone.'
                ); ?>
                <form action="<?= $escaper->escapeUrl($block->getEraseFormAction()) ?>" method="post"
                      id="ordo-gdpr-erase-form">
                    <?= $block->getBlockHtml('formkey') ?>
                    <input type="hidden" name="customer_id" value="<?= (int) $block->getCustomerId() ?>"/>
                    <button type="submit" class="ordo-btn ordo-btn-danger"
                            data-mage-init='<?= /* @noEscape */ json_encode([
                                'confirm' => [
                                    'message' => (string) $eraseConfirm,
                                    'actions' => ['confirm' => ['formId' => 'ordo-gdpr-erase-form']],
                                ],
                            ]) ?>'>
                        <?= $escaper->escapeHtml(__('Erase all data')) ?>
                    </button>
                </form>
            </div>
        </div>
    <?php endif; ?>
</div>
