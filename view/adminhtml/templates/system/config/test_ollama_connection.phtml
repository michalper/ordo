<?php
/** @var \Ordo\Automation\Block\Adminhtml\System\Config\TestOllamaConnection $block */
/** @var \Magento\Framework\Escaper $escaper */
?>
<button type="button" id="ordo-test-ollama-connection" class="action-default">
    <span><?= $escaper->escapeHtml(__('Test Connection')) ?></span>
</button>
<span id="ordo-test-ollama-connection-result" style="margin-left: 1em; display: none;"></span>
<script>
require(['jquery'], function ($) {
    'use strict';

    $('#ordo-test-ollama-connection').on('click', function () {
        var $button = $(this),
            $result = $('#ordo-test-ollama-connection-result');

        $button.prop('disabled', true);
        $result.hide();

        fetch('<?= $escaper->escapeJs($block->getAjaxUrl()) ?>', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            // Magento's own admin CSRF check silently redirects a form_key-less POST back to
            // the Dashboard (no exception, nothing logged) - confirmed via a real click in a
            // real browser: fetch() got a 200 with the Dashboard's own HTML back, which broke
            // response.json() and always landed on the generic catch() "test failed" message
            // regardless of whether Ollama itself was actually reachable. The hidden form_key
            // input Magento_Backend/formkey renders on every admin page is the standard source
            // for this, same as every other admin AJAX call in core.
            body: 'form_key=' + encodeURIComponent($('input[name="form_key"]').val())
        })
            .then(function (response) {
                return response.json();
            })
            .then(function (data) {
                $result.text(data.message)
                    .css('color', data.ok ? 'green' : 'red')
                    .show();
            })
            .catch(function () {
                $result.text('<?= $escaper->escapeJs((string) __('The test failed.')) ?>')
                    .css('color', 'red')
                    .show();
            })
            .finally(function () {
                $button.prop('disabled', false);
            });
    });
});
</script>
