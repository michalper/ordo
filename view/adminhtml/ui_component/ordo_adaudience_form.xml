<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ordo_adaudience_form.ordo_adaudience_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Ad Audience Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Ordo\Automation\Block\Adminhtml\Shared\Edit\BackButton"/>
            <button name="delete" class="OrdoAutomationAdAudienceDeleteButton"/>
            <button name="save" class="OrdoAutomationAdAudienceSaveButton"/>
            <button name="save_and_continue" class="OrdoAutomationAdAudienceSaveAndContinueButton"/>
        </buttons>
        <namespace>ordo_adaudience_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>ordo_adaudience_form.ordo_adaudience_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="ordo_adaudience_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Ordo\Automation\Model\AdAudience\DataProvider</argument>
            <argument name="name" xsi:type="string">ordo_adaudience_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="ordo/adaudience/save"/>
        </settings>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="segment_id" formElement="select" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Segment</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ordo\Automation\Model\Config\Source\SegmentOptions"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="platform" formElement="select" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Platform</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ordo\Automation\Model\Config\Source\AdAudiencePlatform"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="external_audience_id" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">External Audience ID</label>
                <notice translate="true">Google Ads: an existing user list resourceName (customers/{id}/userLists/{id}). Meta: leave blank to have a new Custom Audience created on first sync.</notice>
            </settings>
        </field>
        <field name="enabled" formElement="checkbox" sortOrder="50">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="last_sync_status" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Last Sync Status</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="last_sync_message" formElement="input" sortOrder="70">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Last Sync Message</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="last_synced_at" formElement="input" sortOrder="80">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Last Synced At</label>
                <disabled>true</disabled>
            </settings>
        </field>
    </fieldset>
</form>
