<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ordo_emailtemplatedraft_form.ordo_emailtemplatedraft_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Email Template Draft</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Ordo\Automation\Block\Adminhtml\Shared\Edit\BackButton"/>
            <button name="delete" class="OrdoAutomationEmailTemplateDraftDeleteButton"/>
            <button name="publish" class="Ordo\Automation\Block\Adminhtml\EmailTemplateDraft\Edit\PublishButton"/>
            <button name="save" class="OrdoAutomationEmailTemplateDraftSaveButton"/>
            <button name="save_and_continue" class="OrdoAutomationEmailTemplateDraftSaveAndContinueButton"/>
        </buttons>
        <namespace>ordo_emailtemplatedraft_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>ordo_emailtemplatedraft_form.ordo_emailtemplatedraft_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="ordo_emailtemplatedraft_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Ordo\Automation\Model\EmailTemplateDraft\DataProvider</argument>
            <argument name="name" xsi:type="string">ordo_emailtemplatedraft_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="ordo/emailtemplatedraft/save"/>
        </settings>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="template_id" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Template ID</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="template_code" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Template Name</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="template_subject" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Subject</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="template_text" formElement="textarea" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Template Content</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="template_styles" formElement="textarea" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Template Styles</label>
            </settings>
        </field>
        <field name="updated_at" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Updated At</label>
                <disabled>true</disabled>
            </settings>
        </field>
    </fieldset>
</form>
