<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ordo_leadroutingrule_form.ordo_leadroutingrule_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Lead Routing Rule Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Ordo\Automation\Block\Adminhtml\LeadRoutingRule\Edit\BackButton"/>
            <button name="delete" class="Ordo\Automation\Block\Adminhtml\LeadRoutingRule\Edit\DeleteButton"/>
            <button name="save" class="Ordo\Automation\Block\Adminhtml\LeadRoutingRule\Edit\SaveButton"/>
            <button name="save_and_continue" class="Ordo\Automation\Block\Adminhtml\LeadRoutingRule\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>ordo_leadroutingrule_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>ordo_leadroutingrule_form.ordo_leadroutingrule_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="ordo_leadroutingrule_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Ordo\Automation\Model\LeadRoutingRule\DataProvider</argument>
            <argument name="name" xsi:type="string">ordo_leadroutingrule_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="ordo/leadroutingrule/save"/>
        </settings>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="attribute_code" formElement="select" sortOrder="20" component="Magento_Ui/js/form/element/ui-select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filterOptions" xsi:type="boolean">true</item>
                    <item name="multiple" xsi:type="boolean">false</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Attribute</label>
                <notice translate="true">Leave blank to match every customer (a catch-all/default pool rule)</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ordo\Automation\Model\Config\Source\CustomerAttribute"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="operator" formElement="select" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Operator</label>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Ordo\Automation\Model\Config\Source\ScoreRuleOperator"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="value" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Value</label>
            </settings>
        </field>
        <field name="sort_order" formElement="input" sortOrder="50">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Sort Order</label>
                <notice translate="true">Match order — the first enabled rule that matches a customer wins</notice>
                <validation>
                    <rule name="validate-number" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="enabled" formElement="checkbox" sortOrder="60">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="number">1</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>

    <fieldset name="reps_fieldset" sortOrder="20">
        <settings>
            <label translate="true">Sales Rep Pool</label>
        </settings>
        <dynamicRows name="reps">
            <settings>
                <label translate="true">Sales Reps</label>
                <addButtonLabel translate="true">Add Rep</addButtonLabel>
                <componentType>dynamicRows</componentType>
                <dataScope>reps</dataScope>
                <notice translate="true">Matching customers are assigned round-robin across this pool, in the order listed</notice>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                    </item>
                </argument>
                <field name="email" formElement="input" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Email</label>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                            <rule name="validate-email" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                </field>
                <field name="name" formElement="input" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Name</label>
                    </settings>
                </field>
                <field name="phone" formElement="input" sortOrder="30">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Phone</label>
                    </settings>
                </field>
            </container>
        </dynamicRows>
    </fieldset>
</form>
