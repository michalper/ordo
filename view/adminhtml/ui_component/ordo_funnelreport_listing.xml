<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ordo_funnelreport_listing.ordo_funnelreport_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>ordo_funnelreport_columns</spinner>
        <deps>
            <dep>ordo_funnelreport_listing.ordo_funnelreport_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="back_to_dashboard">
                <url path="ordo/dashboard/index"/>
                <class>back</class>
                <label translate="true">Back to Dashboard</label>
            </button>
        </buttons>
    </settings>

    <dataSource name="ordo_funnelreport_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">ordo_funnelreport_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
            </item>
        </argument>
    </dataSource>

    <!-- Read-only - no mass actions. One row per calendar day; see Model\ResourceModel\
         FunnelReport\Grid\Collection's own docblock. -->
    <columns name="ordo_funnelreport_columns">
        <column name="date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <sorting>desc</sorting>
                <label translate="true">Date</label>
            </settings>
        </column>
        <column name="product_view_visitors">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <sortable>true</sortable>
                <label translate="true">Viewed a Product</label>
            </settings>
        </column>
        <column name="cart_add_visitors">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <sortable>true</sortable>
                <label translate="true">Added to Cart</label>
            </settings>
        </column>
        <column name="cart_add_drop_off_rate">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <sortable>true</sortable>
                <label translate="true">Drop-off Before Cart (%)</label>
            </settings>
        </column>
        <column name="checkout_start_visitors">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <sortable>true</sortable>
                <label translate="true">Started Checkout</label>
            </settings>
        </column>
        <column name="checkout_start_drop_off_rate">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <sortable>true</sortable>
                <label translate="true">Drop-off Before Checkout (%)</label>
            </settings>
        </column>
        <column name="completed_order_visitors">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <sortable>true</sortable>
                <label translate="true">Completed Order</label>
            </settings>
        </column>
        <column name="completed_order_drop_off_rate">
            <settings>
                <filter>textRange</filter>
                <dataType>text</dataType>
                <sortable>true</sortable>
                <label translate="true">Drop-off Before Completing (%)</label>
            </settings>
        </column>
    </columns>
</listing>
