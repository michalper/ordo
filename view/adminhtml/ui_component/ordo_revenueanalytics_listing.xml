<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ordo_revenueanalytics_listing.ordo_revenueanalytics_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>ordo_revenueanalytics_columns</spinner>
        <deps>
            <dep>ordo_revenueanalytics_listing.ordo_revenueanalytics_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="back_to_dashboard">
                <url path="ordo/dashboard/index"/>
                <class>back</class>
                <label translate="true">Back to Dashboard</label>
            </button>
        </buttons>
    </settings>

    <dataSource name="ordo_revenueanalytics_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">ordo_revenueanalytics_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
            </item>
        </argument>
    </dataSource>

    <!-- Read-only - no mass actions. One row per order (canceled orders excluded); see
         Model\ResourceModel\RevenueAnalytics\Grid\Collection's own docblock for the join shape
         and its known limitations (coupon attribution, no device dimension). -->
    <columns name="ordo_revenueanalytics_columns">
        <column name="entity_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Order ID</label>
            </settings>
        </column>
        <column name="increment_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Order #</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <sorting>desc</sorting>
                <label translate="true">Date</label>
            </settings>
        </column>
        <column name="revenue">
            <settings>
                <dataType>text</dataType>
                <sortable>true</sortable>
                <label translate="true">Revenue</label>
            </settings>
        </column>
        <column name="coupon_code">
            <settings>
                <filter>text</filter>
                <label translate="true">Coupon Code</label>
            </settings>
        </column>
        <column name="campaign_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Campaign (if any)</label>
            </settings>
        </column>
        <column name="coupon_campaign_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Coupon generated by (if any)</label>
            </settings>
        </column>
        <column name="country_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Country</label>
            </settings>
        </column>
        <column name="city">
            <settings>
                <filter>text</filter>
                <label translate="true">City</label>
            </settings>
        </column>
        <column name="is_new_customer" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <filter>select</filter>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <dataType>select</dataType>
                <label translate="true">New Customer</label>
            </settings>
        </column>
    </columns>
</listing>
