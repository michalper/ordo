<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ordo_segment_form.ordo_segment_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Segment Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Ordo\Automation\Block\Adminhtml\Segment\Edit\BackButton"/>
            <button name="delete" class="Ordo\Automation\Block\Adminhtml\Segment\Edit\DeleteButton"/>
            <button name="save" class="Ordo\Automation\Block\Adminhtml\Segment\Edit\SaveButton"/>
            <button name="save_and_continue" class="Ordo\Automation\Block\Adminhtml\Segment\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>ordo_segment_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>ordo_segment_form.ordo_segment_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="ordo_segment_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Ordo\Automation\Model\Segment\DataProvider</argument>
            <argument name="name" xsi:type="string">ordo_segment_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="ordo/segment/save"/>
        </settings>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="enabled" formElement="checkbox" sortOrder="20">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>

    <fieldset name="conditions_fieldset">
        <settings>
            <label translate="true">Conditions (all must match — AND)</label>
        </settings>
        <dynamicRows name="conditions">
            <settings>
                <label translate="true">Conditions</label>
                <addButtonLabel translate="true">Add Condition</addButtonLabel>
                <componentType>dynamicRows</componentType>
                <dataScope>conditions</dataScope>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                    </item>
                </argument>
                <field name="type" formElement="select" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Type</label>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="Ordo\Automation\Model\Config\Source\ConditionType"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <field name="params_json" formElement="textarea" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Params (JSON)</label>
                        <notice translate="true">e.g. {"tag":"vip"}, {"amount":"100"}, {"threshold":"50"}, {"days":"30"}, {"count":"3"}, {"segment_id":"2"} — see the condition type's docblock in Model/Campaign/Condition/ for the exact keys it reads.</notice>
                    </settings>
                </field>
            </container>
        </dynamicRows>
    </fieldset>
</form>
