<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ordo_conversationmessage_listing.ordo_conversationmessage_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>ordo_conversationmessage_columns</spinner>
        <deps>
            <dep>ordo_conversationmessage_listing.ordo_conversationmessage_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="back_to_dashboard">
                <url path="ordo/dashboard/index"/>
                <class>back</class>
                <label translate="true">Back to Dashboard</label>
            </button>
        </buttons>
    </settings>

    <dataSource name="ordo_conversationmessage_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider</argument>
            <argument name="name" xsi:type="string">ordo_conversationmessage_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                </item>
            </argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
            </item>
        </argument>
    </dataSource>

    <!-- Every column below already declares its own <filter> type, but a bare <columns> section
         has no toggle to ever open them - see Campaign grid's own listingToolbar comment (the
         ROADMAP.md "No column filtering on any grid" finding): without an explicit
         <listingToolbar>, this module's grids render just the raw table, with no visible
         filter/search/paging panel at all. Unlike the Campaign grid (deliberately scoped to just
         a massaction, to avoid an un-asked-for UI change), this listing's own "Customer" column
         is documented (SCENARIOS.md's own #23 Conversations-grid row) as filterable, so the
         panel that actually makes that true belongs here. -->
    <listingToolbar name="listing_top">
        <filters name="listing_filters"/>
    </listingToolbar>
    <columns name="ordo_conversationmessage_columns">
        <column name="entity_id">
            <settings>
                <filter>text</filter>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="channel">
            <settings>
                <filter>text</filter>
                <label translate="true">Channel</label>
            </settings>
        </column>
        <column name="customer_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer</label>
            </settings>
        </column>
        <column name="customer_email">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer Email</label>
            </settings>
        </column>
        <column name="from_address">
            <settings>
                <filter>text</filter>
                <label translate="true">From</label>
            </settings>
        </column>
        <column name="body">
            <settings>
                <filter>text</filter>
                <label translate="true">Message</label>
            </settings>
        </column>
        <column name="is_stop_keyword" class="Magento\Ui\Component\Listing\Columns\Column">
            <settings>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Stop Keyword</label>
                <options>
                    <option name="yes" xsi:type="array">
                        <item name="value" xsi:type="string">1</item>
                        <item name="label" xsi:type="string" translate="true">Yes</item>
                    </option>
                    <option name="no" xsi:type="array">
                        <item name="value" xsi:type="string">0</item>
                        <item name="label" xsi:type="string" translate="true">No</item>
                    </option>
                </options>
            </settings>
        </column>
        <!-- Plain select+options rendering, same "even a plain text label is fine for v1" shape
             is_stop_keyword above already uses - this is the smallest change that lets the grid
             render a real back-and-forth thread (ROADMAP.md's two-way conversation replies item)
             without building a dedicated per-thread detail page. -->
        <column name="direction" class="Magento\Ui\Component\Listing\Columns\Column">
            <settings>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Direction</label>
                <options>
                    <option name="inbound" xsi:type="array">
                        <item name="value" xsi:type="string">inbound</item>
                        <item name="label" xsi:type="string" translate="true">Inbound</item>
                    </option>
                    <option name="outbound" xsi:type="array">
                        <item name="value" xsi:type="string">outbound</item>
                        <item name="label" xsi:type="string" translate="true">Outbound</item>
                    </option>
                </options>
            </settings>
        </column>
        <column name="provider_message_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Provider Message ID</label>
            </settings>
        </column>
        <column name="received_at" class="Magento\Ui\Component\Listing\Columns\Date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <sorting>desc</sorting>
                <label translate="true">Received At</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Ordo\Automation\Ui\Component\Listing\Column\ConversationMessageActions">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
