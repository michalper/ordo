<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">ordo_campaign_form.ordo_campaign_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Campaign Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Ordo\Automation\Block\Adminhtml\Campaign\Edit\BackButton"/>
            <button name="delete" class="Ordo\Automation\Block\Adminhtml\Campaign\Edit\DeleteButton"/>
            <button name="save" class="Ordo\Automation\Block\Adminhtml\Campaign\Edit\SaveButton"/>
            <button name="save_and_continue" class="Ordo\Automation\Block\Adminhtml\Campaign\Edit\SaveAndContinueButton"/>
        </buttons>
        <namespace>ordo_campaign_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>ordo_campaign_form.ordo_campaign_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="ordo_campaign_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Ordo\Automation\Model\Campaign\DataProvider</argument>
            <argument name="name" xsi:type="string">ordo_campaign_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="ordo/campaign/save"/>
        </settings>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">General</label>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="enabled" formElement="checkbox" sortOrder="30">
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled</label>
                <valueMap>
                    <map name="false" xsi:type="number">0</map>
                    <map name="true" xsi:type="number">1</map>
                </valueMap>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>

    <!-- Hidden, not removed: same reasoning as conditions_fieldset/actions_fieldset below — the
         Flow canvas is the only editor a store owner sees for triggers too now, a campaign can
         fire on more than one (CampaignTriggerInterface is its own child entity, not a single
         column on ordo_campaign anymore), so this is a dynamicRows section rather than the old
         single trigger_event select. -->
    <fieldset name="triggers_fieldset">
        <settings>
            <label translate="true">Triggers</label>
            <visible>false</visible>
        </settings>
        <dynamicRows name="triggers">
            <settings>
                <label translate="true">Triggers</label>
                <addButtonLabel translate="true">Add Trigger</addButtonLabel>
                <componentType>dynamicRows</componentType>
                <dataScope>triggers</dataScope>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                    </item>
                </argument>
                <settings>
                    <componentType>container</componentType>
                </settings>
                <field name="trigger_event" formElement="select" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Trigger Event</label>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="Ordo\Automation\Model\Config\Source\TriggerEvent"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
            </container>
        </dynamicRows>
    </fieldset>

    <!-- Hidden, not removed: the Flow canvas above (Block\Adminhtml\Campaign\Edit\Flow /
         campaign-flow-editor.js) is now the only editor a store owner sees for
         conditions/actions — it writes into this exact same provider.data.conditions/actions
         path via "Apply flow to form & Save", so the underlying dynamicRows component still
         needs to exist and stay wired to the form's data source, it just shouldn't render its
         own raw-JSON grid next to the friendlier canvas above it. -->
    <fieldset name="conditions_fieldset">
        <settings>
            <label translate="true">Conditions (all must pass — AND)</label>
            <visible>false</visible>
        </settings>
        <dynamicRows name="conditions">
            <settings>
                <label translate="true">Conditions</label>
                <addButtonLabel translate="true">Add Condition</addButtonLabel>
                <componentType>dynamicRows</componentType>
                <dataScope>conditions</dataScope>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                    </item>
                </argument>
                <settings>
                    <componentType>container</componentType>
                </settings>
                <field name="type" formElement="select" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Type</label>
                        <switcherConfig>
                            <enabled>true</enabled>
                            <rules>
                                <rule name="0">
                                    <value>tag</value>
                                    <actions>
                                        <action name="0">
                                            <target>${ $.parentName }.tag</target>
                                            <callback>visible</callback>
                                            <params>
                                                <param name="0" xsi:type="boolean">true</param>
                                            </params>
                                        </action>
                                        <action name="1">
                                            <target>${ $.parentName }.amount</target>
                                            <callback>visible</callback>
                                            <params>
                                                <param name="0" xsi:type="boolean">false</param>
                                            </params>
                                        </action>
                                    </actions>
                                </rule>
                                <rule name="1">
                                    <value>order_total_gte</value>
                                    <actions>
                                        <action name="0">
                                            <target>${ $.parentName }.amount</target>
                                            <callback>visible</callback>
                                            <params>
                                                <param name="0" xsi:type="boolean">true</param>
                                            </params>
                                        </action>
                                        <action name="1">
                                            <target>${ $.parentName }.tag</target>
                                            <callback>visible</callback>
                                            <params>
                                                <param name="0" xsi:type="boolean">false</param>
                                            </params>
                                        </action>
                                    </actions>
                                </rule>
                                <!-- Reuses the same "tag" field as the "tag" rule above — the
                                     visitor_tag condition has the exact same single param shape
                                     (just checked against ordo_visitor_tag instead of
                                     ordo_customer_tag at dispatch time), no reason for a second
                                     physical input. -->
                                <rule name="2">
                                    <value>visitor_tag</value>
                                    <actions>
                                        <action name="0">
                                            <target>${ $.parentName }.tag</target>
                                            <callback>visible</callback>
                                            <params>
                                                <param name="0" xsi:type="boolean">true</param>
                                            </params>
                                        </action>
                                        <action name="1">
                                            <target>${ $.parentName }.amount</target>
                                            <callback>visible</callback>
                                            <params>
                                                <param name="0" xsi:type="boolean">false</param>
                                            </params>
                                        </action>
                                    </actions>
                                </rule>
                            </rules>
                        </switcherConfig>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="Ordo\Automation\Model\Config\Source\ConditionType"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <field name="tag" formElement="input" sortOrder="15">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Tag</label>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="amount" formElement="input" sortOrder="16">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Minimum order total</label>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="params_json" formElement="textarea" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Params (JSON) — only needed for a condition type without a dedicated field above</label>
                        <notice translate="true">Leave blank if you filled in Tag / Minimum order total above.</notice>
                    </settings>
                </field>
            </container>
        </dynamicRows>
    </fieldset>

    <!-- Hidden for the same reason as conditions_fieldset above. -->
    <fieldset name="actions_fieldset">
        <settings>
            <label translate="true">Actions (run in order)</label>
            <visible>false</visible>
        </settings>
        <dynamicRows name="actions">
            <settings>
                <label translate="true">Actions</label>
                <addButtonLabel translate="true">Add Action</addButtonLabel>
                <componentType>dynamicRows</componentType>
                <dataScope>actions</dataScope>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                    </item>
                </argument>
                <settings>
                    <componentType>container</componentType>
                </settings>
                <field name="type" formElement="select" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Type</label>
                        <switcherConfig>
                            <enabled>true</enabled>
                            <rules>
                                <rule name="0">
                                    <value>add_tag</value>
                                    <actions>
                                        <action name="0">
                                            <target>${ $.parentName }.tag</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">true</param></params>
                                        </action>
                                        <action name="1">
                                            <target>${ $.parentName }.rule_id</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="2">
                                            <target>${ $.parentName }.prefix</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="3">
                                            <target>${ $.parentName }.template</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="4">
                                            <target>${ $.parentName }.message</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="5">
                                            <target>${ $.parentName }.headline</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="6">
                                            <target>${ $.parentName }.body</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="7">
                                            <target>${ $.parentName }.cta_label</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="8">
                                            <target>${ $.parentName }.cta_url</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                    </actions>
                                </rule>
                                <rule name="1">
                                    <value>generate_coupon</value>
                                    <actions>
                                        <action name="0">
                                            <target>${ $.parentName }.tag</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="1">
                                            <target>${ $.parentName }.rule_id</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">true</param></params>
                                        </action>
                                        <action name="2">
                                            <target>${ $.parentName }.prefix</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">true</param></params>
                                        </action>
                                        <action name="3">
                                            <target>${ $.parentName }.template</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="4">
                                            <target>${ $.parentName }.message</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="5">
                                            <target>${ $.parentName }.headline</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="6">
                                            <target>${ $.parentName }.body</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="7">
                                            <target>${ $.parentName }.cta_label</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="8">
                                            <target>${ $.parentName }.cta_url</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                    </actions>
                                </rule>
                                <rule name="2">
                                    <value>send_email</value>
                                    <actions>
                                        <action name="0">
                                            <target>${ $.parentName }.tag</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="1">
                                            <target>${ $.parentName }.rule_id</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="2">
                                            <target>${ $.parentName }.prefix</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="3">
                                            <target>${ $.parentName }.template</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">true</param></params>
                                        </action>
                                        <action name="4">
                                            <target>${ $.parentName }.message</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">true</param></params>
                                        </action>
                                        <action name="5">
                                            <target>${ $.parentName }.headline</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="6">
                                            <target>${ $.parentName }.body</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="7">
                                            <target>${ $.parentName }.cta_label</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="8">
                                            <target>${ $.parentName }.cta_url</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                    </actions>
                                </rule>
                                <rule name="3">
                                    <value>popup</value>
                                    <actions>
                                        <action name="0">
                                            <target>${ $.parentName }.tag</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="1">
                                            <target>${ $.parentName }.rule_id</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="2">
                                            <target>${ $.parentName }.prefix</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="3">
                                            <target>${ $.parentName }.template</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="4">
                                            <target>${ $.parentName }.message</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">false</param></params>
                                        </action>
                                        <action name="5">
                                            <target>${ $.parentName }.headline</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">true</param></params>
                                        </action>
                                        <action name="6">
                                            <target>${ $.parentName }.body</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">true</param></params>
                                        </action>
                                        <action name="7">
                                            <target>${ $.parentName }.cta_label</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">true</param></params>
                                        </action>
                                        <action name="8">
                                            <target>${ $.parentName }.cta_url</target>
                                            <callback>visible</callback>
                                            <params><param name="0" xsi:type="boolean">true</param></params>
                                        </action>
                                    </actions>
                                </rule>
                            </rules>
                        </switcherConfig>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="Ordo\Automation\Model\Config\Source\ActionType"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <!-- Not part of switcherConfig above — unlike tag/rule_id/prefix/etc., this
                     applies to every action type, not just some. See CampaignActionInterface::
                     DELAY_MINUTES and CampaignDispatcher for what it actually does at
                     dispatch time. -->
                <field name="delay_minutes" formElement="input" sortOrder="12">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Delay (minutes)</label>
                        <notice translate="true">Wait this long after the previous step (or the trigger, for the first action) before running this one. 0 runs immediately.</notice>
                        <validation>
                            <rule name="validate-digits" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                </field>
                <field name="tag" formElement="input" sortOrder="15">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Tag</label>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="rule_id" formElement="input" sortOrder="16">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Cart price rule ID</label>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="prefix" formElement="input" sortOrder="17">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Coupon code prefix</label>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="template" formElement="input" sortOrder="18">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Email template identifier</label>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="message" formElement="textarea" sortOrder="19">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Message</label>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="headline" formElement="input" sortOrder="21">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Popup headline</label>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="body" formElement="textarea" sortOrder="22">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Popup body</label>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="cta_label" formElement="input" sortOrder="23">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Call-to-action button label</label>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="cta_url" formElement="input" sortOrder="24">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Call-to-action button URL</label>
                        <visible>false</visible>
                    </settings>
                </field>
                <field name="params_json" formElement="textarea" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Params (JSON) — only needed for an action type without a dedicated field above</label>
                        <notice translate="true">Leave blank if you filled in one of the dedicated fields above.</notice>
                    </settings>
                </field>
            </container>
        </dynamicRows>
    </fieldset>
</form>
