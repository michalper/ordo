<?php
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Ordo\Automation\Block\Frontend\TrackerViewModel $viewModel */
$viewModel = $block->getData('view_model');
?>
<?php if ($viewModel->isTrackingEnabled()): ?>
<script
    src="<?= $escaper->escapeUrl($block->getViewFileUrl('Ordo_Automation::js/tracker.js')) ?>"
    data-poll-enabled="<?= $viewModel->isPollEnabled() ? '1' : '0' ?>"
    data-poll-interval="<?= (int) $viewModel->getPollIntervalSeconds() ?>"
    data-push-enabled="<?= $viewModel->isPushEnabled() ? '1' : '0' ?>"
    data-push-vapid-public-key="<?= $escaper->escapeHtmlAttr($viewModel->getVapidPublicKey()) ?>"
    data-gtm-bridge-enabled="<?= $viewModel->isGtmBridgeEnabled() ? '1' : '0' ?>"
    data-exit-intent-enabled="<?= $viewModel->isExitIntentEnabled() ? '1' : '0' ?>"
    data-social-proof-enabled="<?= $viewModel->isSocialProofEnabled() ? '1' : '0' ?>"
    data-low-stock-enabled="<?= $viewModel->isLowStockWidgetEnabled() ? '1' : '0' ?>"
    data-email-capture-enabled="<?= $viewModel->isEmailCaptureEnabled() ? '1' : '0' ?>"
    data-email-capture-delay="<?= (int) $viewModel->getEmailCaptureDelaySeconds() ?>"
    data-email-capture-headline="<?= $escaper->escapeHtmlAttr($viewModel->getEmailCaptureHeadline()) ?>"
    data-email-capture-body="<?= $escaper->escapeHtmlAttr($viewModel->getEmailCaptureBody()) ?>"
    data-email-capture-cta-label="<?= $escaper->escapeHtmlAttr($viewModel->getEmailCaptureCtaLabel()) ?>"
></script>
<?php endif; ?>
