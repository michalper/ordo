<?php
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Ordo\Automation\Block\Frontend\TrackerViewModel $viewModel */
$viewModel = $block->getData('view_model');
?>
<?php if ($viewModel->isTrackingEnabled()): ?>
<script
    src="<?= $escaper->escapeUrl($block->getViewFileUrl('Ordo_Automation::js/tracker.js')) ?>"
    data-poll-enabled="<?= $viewModel->isPollEnabled() ? '1' : '0' ?>"
    data-poll-interval="<?= (int) $viewModel->getPollIntervalSeconds() ?>"
    data-push-enabled="<?= $viewModel->isPushEnabled() ? '1' : '0' ?>"
    data-push-vapid-public-key="<?= $escaper->escapeHtmlAttr($viewModel->getVapidPublicKey()) ?>"
></script>
<?php endif; ?>
