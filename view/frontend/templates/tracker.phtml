<?php
/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Ordo\Automation\Block\Frontend\TrackerViewModel $viewModel */
$viewModel = $block->getData('view_model');
?>
<?php if ($viewModel->isTrackingEnabled()): ?>
<script
    src="<?= $escaper->escapeUrl($block->getViewFileUrl('Ordo_Automation::js/tracker.js')) ?>"
    data-popup-enabled="<?= $viewModel->isPopupEnabled() ? '1' : '0' ?>"
    data-popup-poll-interval="<?= (int) $viewModel->getPopupPollIntervalSeconds() ?>"
></script>
<?php endif; ?>
