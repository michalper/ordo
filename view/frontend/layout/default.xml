<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!--
            Config-gated, unlike the previous bare <script> in <head> — that loaded on every
            page regardless of the "tracking > enabled" toggle (the /ordo/track/event endpoint
            no-op'd, but the JS still fired a wasted request every page load). This block only
            renders the <script> tag at all when Helper\Config::isTrackingEnabled() is true.
        -->
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="ordo.tracker" template="Ordo_Automation::tracker.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Ordo\Automation\Block\Frontend\TrackerViewModel</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
