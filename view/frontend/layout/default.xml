<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!--
            Known limitation, documented rather than hidden: this loads sitewide regardless of
            the "tracking > enabled" config toggle. The /ordo/track/event endpoint no-ops (and
            stores nothing) when tracking is disabled, but the JS still fires a page_view
            request on every page load either way — wasted, not harmful. Making this
            conditional on store config needs a small Block checking Config::isTrackingEnabled()
            instead of a bare <script> tag; tracked as a Phase 5 follow-up, not done here.
        -->
        <script src="Ordo_Automation::js/tracker.js"/>
    </head>
</page>
