<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd" layout="2columns-left" cacheable="false">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="ordo.offer.index" template="Ordo_Automation::offer/index.phtml" cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Ordo\Automation\Block\Frontend\OfferViewModel</argument>
                </arguments>
            </block>
            <!-- No dedicated loyalty account page exists yet - "My Offers" is this module's only
                 server-rendered storefront customer-account page, so the wallet pass button lives
                 here too rather than behind a whole new route, same reasoning the Offer entity
                 itself (REST-only, no admin CRUD UI) already established for staying lean. -->
            <block class="Magento\Framework\View\Element\Template" name="ordo.loyalty.wallet_pass" template="Ordo_Automation::walletpass/google_button.phtml" cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Ordo\Automation\Block\Frontend\LoyaltyWalletPassViewModel</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
